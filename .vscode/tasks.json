{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "label": "npm: dev",
      "detail": "webpack serve --env development",
      "isBackground": true,
      "problemMatcher": {
        "owner": "webpack",
        "pattern": {
          "regexp": "^Error:.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^webpack.*compiled successfully",
          "endsPattern": "^webpack.*compiled successfully"
        }
      }
    },
    {
      "label": "build-test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/wasm2/HackerOs/test/test/test.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-ecosystem",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/wasm2/HackerOs/OS/HackerOs.Ecosystem/HackerOs.Ecosystem.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-server",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/wasm2/HackerOs/Server/HackerOs.Server/HackerOs.Server.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
