{
  "$schema": "http://json.schemastore.org/template",
  "author": "HackerOS",
  "classifications": [ "HackerOS", "Console", "App" ],
  "identity": "HackerOs.Templates.Command",
  "groupIdentity": "HackerOs.Templates.Command",
  "name": "HackerOS terminal command",
  "description": "A HackerOS terminal command (TerminalAppBase), built with HackerOs.App.Build.",
  "shortName": "hackeros-command",
  "sourceName": "HackerOs.Template.Command",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "appId": {
      "type": "parameter",
      "datatype": "text",
      "description": "Application id (reverse-DNS, lowercase), unique in the catalog.",
      "defaultValue": "com.example.my-app",
      "replaces": "com.example.template-app"
    },
    "publisherId": {
      "type": "parameter",
      "datatype": "text",
      "description": "Publisher id written in the manifest.",
      "defaultValue": "pub.example",
      "replaces": "pub.template"
    }
  }
}
