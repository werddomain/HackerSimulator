<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- One version for every HackerOS package (ADR 0098 §1). -->
    <HackerOsVersion>0.0.0-dev</HackerOsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HackerOs.AppSdk" Version="$(HackerOsVersion)" />
    <!-- Generates manifest.json after the build and checks the SDK boundary (HOSAPP0030). -->
    <PackageReference Include="HackerOs.App.Build" Version="$(HackerOsVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
