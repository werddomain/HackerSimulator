<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <PublishAot>false</PublishAot>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Suppress IL2111 trimmer analysis warnings -->
    <NoWarn>$(NoWarn);IL2111</NoWarn>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <IsPublishable>True</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OS\HackerOs.Ecosystem\HackerOs.Ecosystem.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Browser\HackerOs.Apps.Browser.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Calculator\HackerOs.Apps.Calculator.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.CodeEditor\HackerOs.Apps.CodeEditor.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.ErrorLogViewer\HackerOs.Apps.ErrorLogViewer.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.FileExplorer\HackerOs.Apps.FileExplorer.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.HackPaint\HackerOs.Apps.HackPaint.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Settings\HackerOs.Apps.Settings.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.SystemMonitor\HackerOs.Apps.SystemMonitor.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Terminal\HackerOs.Apps.Terminal.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.TextEditor\HackerOs.Apps.TextEditor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.Browser.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.Calculator.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.CodeEditor.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.ErrorLogViewer.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.FileExplorer.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.HackPaint.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.Settings.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.SystemMonitor.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.Terminal.dll" />
    <BlazorWebAssemblyLazyLoad Include="HackerOs.Apps.TextEditor.dll" />
  </ItemGroup>

</Project>
