@using HackerOs.Simulation.Abstractions.Settings

@* Shows where a layered setting's effective value comes from (ADR 0044 section 3). *@
<span class="@CssClass" title="@Title">
    @if (IsLocked)
    {
        <span class="origin-lock" aria-hidden="true">&#x1F512;</span>
    }
    @Label
</span>

@code {
    /// <summary>Layer that provides the effective value.</summary>
    [Parameter] public SettingLayer Source { get; set; } = SettingLayer.Default;

    /// <summary>Whether the system layer's <c>[locked]</c> section fixes this key.</summary>
    [Parameter] public bool IsLocked { get; set; }

    private string Label => IsLocked
        ? "locked by admin"
        : Source switch
        {
            SettingLayer.User => "yours",
            SettingLayer.System => "system default",
            _ => "built-in"
        };

    private string Title => IsLocked
        ? "An administrator fixed this value in /etc; it cannot be changed for one user."
        : Source switch
        {
            SettingLayer.User => "Set in your ~/.config file.",
            SettingLayer.System => "Inherited from the machine-wide /etc file.",
            _ => "No file sets this key: the application's built-in default applies."
        };

    private string CssClass => IsLocked
        ? "setting-origin is-locked"
        : $"setting-origin is-{Source.ToString().ToLowerInvariant()}";
}
