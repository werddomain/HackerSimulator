@namespace HackerOs.AppSdk.Terminal
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.IO
@using HackerOs.AppSdk.Shell
@using HackerOs.AppSdk.VirtualKeyboard
@using HackerOs.Simulation.Abstractions.Diagnostics
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JavaScript
@inject IDialogService Dialogs

@*
    Reusable terminal emulator (line editing, display, alternate screen) any WindowAppBase-hosted app
    can embed. It hosts an hsh shell through the public SDK only (HackShell, capability shell.host,
    ADR 0056 section 7): the shell is a child process of the host app (ADR 0050), each panel has its
    own, and every command is a child of that shell. Parsing, expansion, pipes, redirections and
    completion are the shell's; credentials typed here are verified by the OS. See
    Apps/System/HackerOs.Apps.Terminal for the thin standalone host, and HackerOs.Apps.CodeEditor for
    an embedded usage.
*@
<div class="terminal-container" @ref="_terminalContainerRef" @onkeydown="HandleKeyDownAsync">
    @if (_isFullScreen)
    {
        <TerminalScreen @ref="_screenComponent"
                        Frame="_fullScreenFrame"
                        OnKey="HandleFullScreenKeyAsync" />
    }
    else
    {
        <div class="terminal-output" @ref="_outputBufferRef" role="log" aria-live="polite">
        @if (_showBanner)
        {
        <div class="welcome-banner">
            <pre class="ascii-art">
  _  _         _         ___  ___
 | || |__ _ __| |_____ _| _ \/ __|
 | __ / _` / _| / / -_) '_|   /\__ \
 |_||_\__,_\__|__\_\___|_| |_|_|___/
            </pre>
            <p>HackerOS Terminal v1.0.0 — Type 'help' for available commands.</p>
        </div>
        }

        @foreach (TerminalOutputLine line in _lines)
        {
            <div key="@line.Id" class="output-line @line.TypeClass">
                @if (!string.IsNullOrEmpty(line.Prompt))
                {
                    <span class="line-prompt">@line.Prompt </span>
                }
                <span class="line-text">@line.Text</span>
            </div>
        }

        <div class="input-line">
            <span class="input-prompt">@Prompt </span>
            <input @ref="_inputRef"
                   type="text"
                   class="terminal-input"
                   aria-label="Terminal command input"
                   inputmode="@(UseVirtualKeyboard ? "none" : null)"
                   @bind="_inputBuffer"
                   @bind:event="oninput" />
        </div>
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the host app's execution context (filesystem, cancellation, logging).</summary>
    [Parameter, EditorRequired]
    public IAppExecutionContext AppContext { get; set; } = default!;

    /// <summary>
    /// Gets or sets the app id of the hosting app. Kept for compatibility: the shell's parent is
    /// <see cref="AppContext"/>'s own process, which already identifies the host.
    /// </summary>
    [Parameter]
    public string CallerAppId { get; set; } = "org.hackeros.terminal";

    /// <summary>Gets or sets the username shown in the prompt until the shell has started.</summary>
    [Parameter]
    public string InitialUsername { get; set; } = "user";

    /// <summary>
    /// Gets or sets the shell's starting directory. When null (or missing), the shell starts in the
    /// host app's directory (the home directory for an app launched from the desktop). E.g.
    /// CodeEditor opens new terminal tabs in whatever folder it has open. Each panel's shell is its
    /// own process: a <c>cd</c> in one tab never moves another.
    /// </summary>
    [Parameter]
    public string? InitialCwd { get; set; }

    /// <summary>
    /// Gets or sets whether input is driven by a <c>HackerOs.AppSdk.VirtualKeyboard</c> control
    /// instead of the physical keyboard. When true, the line-mode input gets
    /// <c>inputmode="none"</c> so a touch focus does not open the platform's native keyboard —
    /// callers are expected to route key presses through <see cref="PushVirtualKey"/> instead.
    /// </summary>
    [Parameter]
    public bool UseVirtualKeyboard { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked once the panel's shell has exited: the <c>exit</c>
    /// command, or Ctrl+D on an empty line (a real shell's end of input). The host decides what
    /// that means (the console closes the tab, ADR 0058 section 4). Unbound, the panel stays open
    /// and prints the exit status, as a terminal whose child process ended.
    /// </summary>
    [Parameter]
    public EventCallback OnExitRequested { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when <see cref="Title"/> changes: the name of the
    /// running command, otherwise the current directory's name (<c>~</c> for the home directory).
    /// </summary>
    [Parameter]
    public EventCallback<string> OnTitleChanged { get; set; }

    /// <summary>Gets the title a tab shows for this panel (see <see cref="OnTitleChanged"/>).</summary>
    public string Title { get; private set; } = "~";

    /// <summary>Gets the working directory of the panel's shell, or <see langword="null"/> before it started or after it exited.</summary>
    public string? WorkingDirectory => _shell is { HasExited: false } shell ? shell.WorkingDirectory : null;

    private ElementReference _outputBufferRef;
    private ElementReference _inputRef;
    private ElementReference _terminalContainerRef;
    private TerminalScreen? _screenComponent;
    private IHackShell? _shell;
    private TerminalCredentialPrompt? _credentialPrompt;
    private string? _lastCompletionLine;
    private readonly List<TerminalOutputLine> _lines = [];
    private readonly object _linesSync = new();
    private string _inputBuffer = string.Empty;
    private CancellationTokenSource? _activeCts;
    private bool _showBanner = true;
    private TerminalControlSequenceDecoder _stdoutDecoder = new();
    private TerminalControlSequenceDecoder _stderrDecoder = new();
    private TerminalFullScreenSession? _fullScreenSession;
    private TerminalScreenFrame? _fullScreenFrame;
    private bool _isFullScreen;
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizeObserver;
    private IJSObjectReference? _keyTrap;
    private DotNetObjectReference<TerminalPanel>? _dotNetReference;
    private string? _startError;

    protected override async Task OnInitializedAsync()
    {
        // sudo, the one-shot approval (ADR 0042) and a third-party command's dangerous
        // capabilities (ADR 0049 section 5) are asked here, in text mode; the OS verifies.
        _credentialPrompt = new TerminalCredentialPrompt(Dialogs, AppContext, WriteApprovalLineAsync);
        try
        {
            _shell = await HackShell.StartAsync(AppContext, new HackShellOptions
            {
                WorkingDirectory = InitialCwd,
                CredentialPrompt = _credentialPrompt
            }, AppContext.CancellationToken);
        }
        catch (Exception exception) when (exception is HackUnauthorizedAccessException or NotSupportedException or InvalidOperationException)
        {
            // The host lacks shell.host, or runs without a platform: show why, as a terminal whose
            // shell failed to exec prints the error and stays open.
            _startError = $"hsh: cannot start the shell: {exception.Message}";
            AppContext.Logging.Log(DiagnosticSeverity.Error, _startError);
            AddLine(new TerminalOutputLine(string.Empty, _startError, OutputType.Error));
        }

        await UpdateTitleAsync(null);
    }

    /// <summary>Moves the keyboard focus to the panel (its input line, or the alternate screen).</summary>
    public async Task FocusAsync()
    {
        try
        {
            if (_isFullScreen && _screenComponent is not null)
                await _screenComponent.FocusAsync();
            else
                await _inputRef.FocusAsync();
        }
        catch (Exception)
        {
            // Not rendered yet, or a headless test DOM.
        }
    }

    /// <summary>
    /// Recomputes <see cref="Title"/>: the running command's name, otherwise the last segment of
    /// the prompt's directory (<c>~</c>, <c>projets</c>, <c>/</c>), as gnome-terminal titles a tab.
    /// </summary>
    private async Task UpdateTitleAsync(string? runningLine)
    {
        string title = runningLine is { Length: > 0 }
            ? runningLine.Split((char[]?)null, 2, StringSplitOptions.RemoveEmptyEntries)[0]
            : DirectoryTitle(Prompt);
        if (title != Title)
        {
            Title = title;
            await OnTitleChanged.InvokeAsync(title);
        }
    }

    /// <summary>Gets the directory's display name from a <c>user@host:dir$</c> prompt.</summary>
    private static string DirectoryTitle(string prompt)
    {
        int at = prompt.IndexOf('@');
        int colon = prompt.IndexOf(':', at < 0 ? 0 : at);
        string directory = (colon < 0 ? prompt : prompt[(colon + 1)..]).TrimEnd('$', '#', ' ');
        if (directory.Length <= 1)
        {
            return directory.Length == 0 ? "~" : directory;
        }

        string trimmed = directory.TrimEnd('/');
        int slash = trimmed.LastIndexOf('/');
        return slash < 0 ? trimmed : trimmed[(slash + 1)..];
    }

    /// <summary>Gets the prompt, from the shell's process (user, /etc/hostname, directory).</summary>
    private string Prompt => _shell?.Prompt ?? $"{InitialUsername}@{AppContext.Environment.MachineName}:~$";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _inputRef.FocusAsync();
            }
            catch (Exception)
            {
                // Headless test DOM fallback
            }

            try
            {
                _dotNetReference = DotNetObjectReference.Create(this);
                _module = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HackerOs.AppSdk.Terminal/TerminalPanel.razor.js");
                _resizeObserver = await _module.InvokeAsync<IJSObjectReference>(
                    "observeTerminal", _terminalContainerRef, _dotNetReference);
                // Tab completes in the shell instead of moving the browser focus.
                _keyTrap = await _module.InvokeAsync<IJSObjectReference>("trapTerminalKeys", _terminalContainerRef);
            }
            catch (Exception)
            {
                // Headless test DOM and unavailable-JS fallback retain the safe 80x24 viewport.
            }
        }

        if (_isFullScreen)
        {
            try
            {
                if (_screenComponent is not null)
                    await _screenComponent.FocusAsync();
            }
            catch (Exception)
            {
                // Headless test DOM fallback.
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (_isFullScreen)
            return;

        if (args.Key == "Enter")
        {
            await ExecuteInputAsync();
        }
        else if (args.Key == "ArrowUp")
        {
            string? previous = _shell?.NavigateHistory(-1);
            if (previous is not null)
            {
                _inputBuffer = previous;
            }
        }
        else if (args.Key == "ArrowDown")
        {
            string? next = _shell?.NavigateHistory(1);
            if (next is not null)
            {
                _inputBuffer = next;
            }
        }
        else if (args.Key == "c" && args.CtrlKey)
        {
            CancelActiveCommand();
        }
        else if (args.Key == "l" && args.CtrlKey)
        {
            ClearBuffer();
        }
        else if (args.Key == "d" && args.CtrlKey)
        {
            await RequestExitOnEmptyLineAsync();
        }
        else if (args.Key == "Escape")
        {
            _inputBuffer = string.Empty;
        }
        else if (args.Key == "Tab")
        {
            await AutoCompleteInputAsync();
        }
    }

    private Task HandleFullScreenKeyAsync(TerminalKeyEvent keyEvent)
    {
        _fullScreenSession?.TryPostKey(keyEvent);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Routes one key press from a <c>VirtualKeyboard</c> into the same actions the physical
    /// keyboard already triggers. Full-screen apps (e.g. <c>nano</c>) receive it through the exact
    /// dispatch surface <see cref="HandleFullScreenKeyAsync"/> already uses, so they gain
    /// virtual-keyboard support with no changes of their own. Line-mode input is mutated directly
    /// in C# rather than by synthesizing a DOM event: browsers do not apply default text-editing
    /// behavior (character insertion, backspace) to programmatically dispatched key events.
    /// </summary>
    public async Task PushVirtualKey(VirtualKeyPressedEvent evt)
    {
        if (_isFullScreen)
        {
            if (TryMapToTerminalKey(evt, out TerminalKeyEvent terminalKeyEvent))
            {
                _fullScreenSession?.TryPostKey(terminalKeyEvent);
            }

            return;
        }

        switch (evt.Key)
        {
            case VirtualKey.Character when evt.Control && evt.Text == "c":
                CancelActiveCommand();
                break;
            case VirtualKey.Character when evt.Control && evt.Text == "l":
                ClearBuffer();
                break;
            case VirtualKey.Character when evt.Control && evt.Text == "d":
                await RequestExitOnEmptyLineAsync();
                break;
            case VirtualKey.Character when !evt.Control && evt.Text is not null:
                _inputBuffer += evt.Text;
                break;
            case VirtualKey.Backspace when _inputBuffer.Length > 0:
                _inputBuffer = _inputBuffer[..^1];
                break;
            case VirtualKey.Enter:
                await ExecuteInputAsync();
                break;
            case VirtualKey.ArrowUp:
                if (_shell?.NavigateHistory(-1) is { } previous)
                {
                    _inputBuffer = previous;
                }
                break;
            case VirtualKey.ArrowDown:
                if (_shell?.NavigateHistory(1) is { } next)
                {
                    _inputBuffer = next;
                }
                break;
            case VirtualKey.Tab:
                await AutoCompleteInputAsync();
                break;
            case VirtualKey.Escape:
                _inputBuffer = string.Empty;
                break;
        }
    }

    /// <summary>
    /// Ctrl+D matches a real shell's end of input: on an empty line, with no command running, the
    /// shell exits (its process ends with <c>$?</c>); a no-op otherwise. Then
    /// <see cref="OnExitRequested"/> lets the host close the tab or window.
    /// </summary>
    private async Task RequestExitOnEmptyLineAsync()
    {
        if (_inputBuffer.Length > 0 || _activeCts is not null)
        {
            return;
        }

        // bash reads end of input and prints "exit" before leaving.
        AddLine(new TerminalOutputLine(Prompt, "exit", OutputType.Input));
        if (_shell is not null && !_shell.HasExited)
        {
            await _shell.DisposeAsync();
        }

        await OnShellExitedAsync();
    }

    /// <summary>
    /// The shell's process ended (<c>exit</c>, Ctrl+D): hand over to the host, or keep the panel
    /// open with the status, as a terminal emulator shows that its child process exited.
    /// </summary>
    private async Task OnShellExitedAsync()
    {
        if (OnExitRequested.HasDelegate)
        {
            await OnExitRequested.InvokeAsync();
            return;
        }

        AddLine(new TerminalOutputLine(string.Empty, $"[hsh exited with status {_shell?.ExitStatus ?? 0}]", OutputType.System));
    }

    private static bool TryMapToTerminalKey(VirtualKeyPressedEvent evt, out TerminalKeyEvent terminalKeyEvent)
    {
        TerminalKey? key = evt.Key switch
        {
            VirtualKey.Character => TerminalKey.Character,
            VirtualKey.Enter => TerminalKey.Enter,
            VirtualKey.Backspace => TerminalKey.Backspace,
            VirtualKey.Delete => TerminalKey.Delete,
            VirtualKey.Escape => TerminalKey.Escape,
            VirtualKey.ArrowLeft => TerminalKey.ArrowLeft,
            VirtualKey.ArrowRight => TerminalKey.ArrowRight,
            VirtualKey.ArrowUp => TerminalKey.ArrowUp,
            VirtualKey.ArrowDown => TerminalKey.ArrowDown,
            VirtualKey.Home => TerminalKey.Home,
            VirtualKey.End => TerminalKey.End,
            VirtualKey.PageUp => TerminalKey.PageUp,
            VirtualKey.PageDown => TerminalKey.PageDown,
            _ => null,
        };

        if (key is null)
        {
            terminalKeyEvent = default!;
            return false;
        }

        terminalKeyEvent = new TerminalKeyEvent(key.Value, evt.Text, evt.Control, evt.Alt, evt.Shift);
        return true;
    }

    private async Task ExecuteInputAsync()
    {
        string rawLine = _inputBuffer.Trim();
        _inputBuffer = string.Empty;

        if (string.IsNullOrWhiteSpace(rawLine))
        {
            AddLine(new TerminalOutputLine(Prompt, string.Empty, OutputType.PromptOnly));
            return;
        }

        AddLine(new TerminalOutputLine(Prompt, rawLine, OutputType.Input));
        if (_shell is null || _shell.HasExited)
        {
            AddLine(new TerminalOutputLine(string.Empty, _startError ?? "hsh: the shell has exited", OutputType.Error));
            return;
        }

        _shell.AddHistory(rawLine);
        await UpdateTitleAsync(rawLine);
        _activeCts = new CancellationTokenSource();
        _stdoutDecoder = new TerminalControlSequenceDecoder();
        _stderrDecoder = new TerminalControlSequenceDecoder();
        _fullScreenSession = new TerminalFullScreenSession(ApplyFullScreenStateAsync);
        try
        {
            // ADR 0050 section 4: output is shown as commands produce it, not when they exit.
            // sudo and approvals come back through the credential prompt given at start.
            await _shell.ExecuteAsync(
                rawLine,
                new HackShellExecution
                {
                    StandardOutput = new TerminalOutputWriter(text => AppendOutput(text, OutputType.Stdout)),
                    StandardError = new TerminalOutputWriter(text => AppendOutput(text, OutputType.Stderr)),
                    FullScreen = _fullScreenSession
                },
                _activeCts.Token);
        }
        catch (ObjectDisposedException)
        {
            AddLine(new TerminalOutputLine(string.Empty, "hsh: the shell has exited", OutputType.Error));
        }
        catch (Exception ex)
        {
            AppContext.Logging.Log(DiagnosticSeverity.Error, $"Shell fault: {ex.Message}");
            AddLine(new TerminalOutputLine(string.Empty, $"Fault: {ex.Message}", OutputType.Error));
        }
        finally
        {
            CloseOpenLines();
            await _fullScreenSession.DisposeAsync();
            _fullScreenSession = null;
            _activeCts.Dispose();
            _activeCts = null;
        }

        await UpdateTitleAsync(null);
        if (_shell.HasExited)
        {
            // `exit [n]` ended the shell's process: the tab closes.
            await OnShellExitedAsync();
        }
    }

    /// <summary>
    /// Receives a chunk of a command's output, as a terminal emulator does: control sequences are
    /// interpreted (<c>clear</c> writes <c>ESC[2J</c>, ADR 0051 section 4), the rest is printed.
    /// </summary>
    private void AppendOutput(string text, OutputType type)
    {
        TerminalControlSequenceDecoder decoder = type == OutputType.Stderr ? _stderrDecoder : _stdoutDecoder;
        foreach (TerminalOutputAction action in decoder.Decode(text))
        {
            if (action.Kind == TerminalOutputActionKind.EraseScreen)
            {
                ClearBuffer();
            }
            else
            {
                AppendText(action.Text, type);
            }
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Prints text: it continues the current open line of the same stream, and each <c>\n</c>
    /// closes a line, like characters reaching a real terminal.
    /// </summary>
    private void AppendText(string text, OutputType type)
    {
        lock (_linesSync)
        {
            string[] pieces = text.Split('\n');
            for (int index = 0; index < pieces.Length; index++)
            {
                bool closesLine = index < pieces.Length - 1;
                string piece = pieces[index].TrimEnd('\r');
                TerminalOutputLine? open = _lines.Count > 0 && _lines[^1] is { IsOpen: true } last && last.Type == type ? last : null;
                if (open is not null)
                {
                    open.Text += piece;
                    open.IsOpen = !closesLine;
                }
                else if (piece.Length > 0 || closesLine)
                {
                    CloseOpenLinesUnsafe();
                    _lines.Add(new TerminalOutputLine(string.Empty, piece, type) { IsOpen = !closesLine });
                }
            }
        }
    }

    private void AddLine(TerminalOutputLine line)
    {
        lock (_linesSync)
        {
            CloseOpenLinesUnsafe();
            _lines.Add(line);
        }
    }

    private void CloseOpenLines()
    {
        lock (_linesSync)
        {
            CloseOpenLinesUnsafe();
        }
    }

    private void CloseOpenLinesUnsafe()
    {
        if (_lines.Count > 0)
        {
            _lines[^1].IsOpen = false;
        }
    }

    /// <summary>Appends one line the OS writes through the credential prompt (approval banner, "Sorry, try again.") and re-renders.</summary>
    private Task WriteApprovalLineAsync(string text, HackPromptLineKind kind)
    {
        AddLine(new TerminalOutputLine(string.Empty, text, kind switch
        {
            HackPromptLineKind.Warning => OutputType.Stderr,
            HackPromptLineKind.Error => OutputType.Error,
            _ => OutputType.System
        }));
        return InvokeAsync(StateHasChanged);
    }

    private void CancelActiveCommand()
    {
        if (_activeCts is not null && !_activeCts.IsCancellationRequested)
        {
            _activeCts.Cancel();
            AddLine(new TerminalOutputLine(string.Empty, "^C", OutputType.System));
        }
    }

    /// <summary>Erases the screen and its scrollback, banner included (Ctrl+L, or <c>ESC[2J</c> from <c>clear</c>).</summary>
    private void ClearBuffer()
    {
        lock (_linesSync)
        {
            _lines.Clear();
            _showBanner = false;
        }
    }

    /// <summary>
    /// Tab: the shell completes the word before the cursor (ADR 0058, section 4), as <c>bash</c>
    /// does. One candidate is inserted; several insert their common prefix, and a second Tab on the
    /// same line lists them under the prompt.
    /// </summary>
    private async Task AutoCompleteInputAsync()
    {
        if (_shell is null || _shell.HasExited)
        {
            return;
        }

        string line = _inputBuffer;
        HackShellCompletion completion;
        try
        {
            completion = await _shell.CompleteAsync(line, line.Length);
        }
        catch (ObjectDisposedException)
        {
            return;
        }

        _inputBuffer = completion.ApplyTo(line, out _);
        if (completion.Candidates.Count > 1 && _inputBuffer == line)
        {
            if (_lastCompletionLine == line)
            {
                AddLine(new TerminalOutputLine(Prompt, line, OutputType.Input));
                AddLine(new TerminalOutputLine(string.Empty, string.Join("  ", completion.DisplayCandidates), OutputType.System));
                _lastCompletionLine = null;
                return;
            }

            _lastCompletionLine = line;
            return;
        }

        _lastCompletionLine = null;
    }

    /// <summary>Receives character-cell dimensions from the collocated resize observer.</summary>
    [JSInvokable]
    public void UpdateTerminalViewport(int columns, int rows)
    {
        if (columns < 1 || rows < 3)
            return;
        _fullScreenSession?.UpdateViewport(columns, rows);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _activeCts?.Cancel();
        // Closing the panel ends its shell's process and every command still running in it.
        if (_shell is not null)
            await _shell.DisposeAsync();
        if (_fullScreenSession is not null)
            await _fullScreenSession.DisposeAsync();
        if (_resizeObserver is not null)
            await _resizeObserver.DisposeAsync();
        if (_keyTrap is not null)
        {
            try
            {
                await _keyTrap.InvokeVoidAsync("dispose");
            }
            catch (JSException)
            {
                // The element is already gone with its listener.
            }

            await _keyTrap.DisposeAsync();
        }
        if (_module is not null)
            await _module.DisposeAsync();
        _dotNetReference?.Dispose();
        _activeCts?.Dispose();
    }

    private Task ApplyFullScreenStateAsync(TerminalScreenFrame? frame, bool active) =>
        InvokeAsync(() =>
        {
            _fullScreenFrame = frame;
            _isFullScreen = active;
            StateHasChanged();
        });


    private enum OutputType { Input, PromptOnly, Stdout, Stderr, System, Error }

    /// <summary>One displayed line; an output line stays open (mutable) until its <c>\n</c> arrives.</summary>
    private sealed class TerminalOutputLine(string prompt, string text, OutputType type)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Prompt { get; } = prompt;
        public string Text { get; set; } = text;
        public OutputType Type { get; } = type;
        public bool IsOpen { get; set; }
        public string TypeClass => Type switch
        {
            OutputType.Input => "line-input",
            OutputType.Stderr => "line-stderr",
            OutputType.Error => "line-error",
            OutputType.System => "line-system",
            _ => "line-stdout"
        };
    }
}
