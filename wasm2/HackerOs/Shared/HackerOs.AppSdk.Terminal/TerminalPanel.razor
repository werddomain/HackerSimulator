@namespace HackerOs.AppSdk.Terminal
@using HackerOs.App.Abstractions
@using HackerOs.App.Abstractions.Policy
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.VirtualKeyboard
@using HackerOs.Platform.Core
@using HackerOs.Platform.Core.Shell
@using HackerOs.Simulation.Abstractions.Diagnostics
@using HackerOs.Simulation.Abstractions.FileSystem
@using HackerOs.Simulation.Abstractions.Sessions
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject ShellInterpreter Shell
@inject ISessionService SessionService
@inject IJSRuntime JavaScript
@inject IDialogService Dialogs
@inject IElevationService Elevation

@*
    Reusable terminal control (session/shell/rendering) extracted from the standalone Terminal app so
    any WindowAppBase-hosted app can embed a shell. The host supplies its own AppContext (filesystem,
    cancellation, logging scoped to that app instance): its process is the shell's process (ADR 0050),
    parent of every command, and its working directory is the shell's. Line editing and display stay
    here; parsing, expansion, pipes and redirections are the headless ShellInterpreter's. See
    Apps/System/HackerOs.Apps.Terminal for the thin standalone host, and HackerOs.Apps.CodeEditor for
    an embedded usage.
*@
<div class="terminal-container" @ref="_terminalContainerRef" @onkeydown="HandleKeyDownAsync">
    @if (_isFullScreen)
    {
        <TerminalScreen @ref="_screenComponent"
                        Frame="_fullScreenFrame"
                        OnKey="HandleFullScreenKeyAsync" />
    }
    else
    {
        <div class="terminal-output" @ref="_outputBufferRef" role="log" aria-live="polite">
        @if (_showBanner)
        {
        <div class="welcome-banner">
            <pre class="ascii-art">
  _  _         _         ___  ___
 | || |__ _ __| |_____ _| _ \/ __|
 | __ / _` / _| / / -_) '_|   /\__ \
 |_||_\__,_\__|__\_\___|_| |_|_|___/
            </pre>
            <p>HackerOS Terminal v1.0.0 — Type 'help' for available commands.</p>
        </div>
        }

        @foreach (TerminalOutputLine line in _lines)
        {
            <div key="@line.Id" class="output-line @line.TypeClass">
                @if (!string.IsNullOrEmpty(line.Prompt))
                {
                    <span class="line-prompt">@line.Prompt </span>
                }
                <span class="line-text">@line.Text</span>
            </div>
        }

        <div class="input-line">
            <span class="input-prompt">@Prompt </span>
            <input @ref="_inputRef"
                   type="text"
                   class="terminal-input"
                   aria-label="Terminal command input"
                   inputmode="@(UseVirtualKeyboard ? "none" : null)"
                   @bind="_inputBuffer"
                   @bind:event="oninput" />
        </div>
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the host app's execution context (filesystem, cancellation, logging).</summary>
    [Parameter, EditorRequired]
    public IAppExecutionContext AppContext { get; set; } = default!;

    /// <summary>
    /// Gets or sets the app id of the hosting app. Kept for compatibility: the shell now runs in
    /// <see cref="AppContext"/>'s own process, which already identifies the host.
    /// </summary>
    [Parameter]
    public string CallerAppId { get; set; } = "org.hackeros.terminal";

    /// <summary>Gets or sets the username used until the authenticated principal initializes the session.</summary>
    [Parameter]
    public string InitialUsername { get; set; } = "user";

    /// <summary>
    /// Gets or sets the starting working directory. When null, the shell starts in its process's
    /// directory (the home directory for an app launched from the desktop). When set, the shell's
    /// process changes to it at start — e.g. CodeEditor opens new terminal tabs in whatever folder it
    /// has open; tabs of one host share that process's directory, as threads of a process do.
    /// </summary>
    [Parameter]
    public string? InitialCwd { get; set; }

    /// <summary>
    /// Gets or sets whether input is driven by a <c>HackerOs.AppSdk.VirtualKeyboard</c> control
    /// instead of the physical keyboard. When true, the line-mode input gets
    /// <c>inputmode="none"</c> so a touch focus does not open the platform's native keyboard —
    /// callers are expected to route key presses through <see cref="PushVirtualKey"/> instead.
    /// </summary>
    [Parameter]
    public bool UseVirtualKeyboard { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user requests to exit via Ctrl+D on an empty
    /// input line (matching a real shell's EOF convention). Unbound by default: this session does
    /// not decide how "exit" should be handled by itself — it only offers the hook.
    /// </summary>
    [Parameter]
    public EventCallback OnExitRequested { get; set; }

    private ElementReference _outputBufferRef;
    private ElementReference _inputRef;
    private ElementReference _terminalContainerRef;
    private TerminalScreen? _screenComponent;
    private ShellSession? _session;
    private readonly List<TerminalOutputLine> _lines = [];
    private readonly object _linesSync = new();
    private string _inputBuffer = string.Empty;
    private CancellationTokenSource? _activeCts;
    private bool _showBanner = true;
    private TerminalControlSequenceDecoder _stdoutDecoder = new();
    private TerminalControlSequenceDecoder _stderrDecoder = new();
    private TerminalFullScreenSession? _fullScreenSession;
    private TerminalScreenFrame? _fullScreenFrame;
    private bool _isFullScreen;
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizeObserver;
    private DotNetObjectReference<TerminalPanel>? _dotNetReference;
    private TerminalDangerousCapabilityApprovalPrompt? _approvalPrompt;

    protected override void OnInitialized()
    {
        // ADR 0049 section 5: a third-party command's pending dangerous capabilities are asked
        // here, in text mode, rather than with the desktop overlay.
        _approvalPrompt = new TerminalDangerousCapabilityApprovalPrompt(Dialogs, AppContext, WriteApprovalLineAsync);
        if (SessionService.CurrentPrincipal is { } principal)
        {
            // ADR 0050: the shell's process is the hosting app's; its directory is the shell's.
            _session = new ShellSession(AppContext, principal);
            if (InitialCwd is not null)
            {
                try
                {
                    AppContext.Environment.SetCurrentDirectory(VirtualPath.Parse(InitialCwd));
                }
                catch (Exception exception) when (exception is NotSupportedException or FormatException or ArgumentException)
                {
                    // A host with no live process environment keeps its directory.
                }
            }
        }
    }

    /// <summary>Gets the prompt, from the shell's process (user, /etc/hostname, directory).</summary>
    private string Prompt => _session?.GetPrompt() ?? $"{InitialUsername}@{AppContext.Environment.MachineName}:~$";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _inputRef.FocusAsync();
            }
            catch (Exception)
            {
                // Headless test DOM fallback
            }

            try
            {
                _dotNetReference = DotNetObjectReference.Create(this);
                _module = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HackerOs.AppSdk.Terminal/TerminalPanel.razor.js");
                _resizeObserver = await _module.InvokeAsync<IJSObjectReference>(
                    "observeTerminal", _terminalContainerRef, _dotNetReference);
            }
            catch (Exception)
            {
                // Headless test DOM and unavailable-JS fallback retain the safe 80x24 viewport.
            }
        }

        if (_isFullScreen)
        {
            try
            {
                if (_screenComponent is not null)
                    await _screenComponent.FocusAsync();
            }
            catch (Exception)
            {
                // Headless test DOM fallback.
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (_isFullScreen)
            return;

        if (args.Key == "Enter")
        {
            await ExecuteInputAsync();
        }
        else if (args.Key == "ArrowUp")
        {
            string? previous = _session?.NavigateHistory(-1);
            if (previous is not null)
            {
                _inputBuffer = previous;
            }
        }
        else if (args.Key == "ArrowDown")
        {
            string? next = _session?.NavigateHistory(1);
            if (next is not null)
            {
                _inputBuffer = next;
            }
        }
        else if (args.Key == "c" && args.CtrlKey)
        {
            CancelActiveCommand();
        }
        else if (args.Key == "l" && args.CtrlKey)
        {
            ClearBuffer();
        }
        else if (args.Key == "d" && args.CtrlKey)
        {
            await RequestExitOnEmptyLineAsync();
        }
        else if (args.Key == "Escape")
        {
            _inputBuffer = string.Empty;
        }
        else if (args.Key == "Tab")
        {
            AutoCompleteInput();
        }
    }

    private Task HandleFullScreenKeyAsync(TerminalKeyEvent keyEvent)
    {
        _fullScreenSession?.TryPostKey(keyEvent);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Routes one key press from a <c>VirtualKeyboard</c> into the same actions the physical
    /// keyboard already triggers. Full-screen apps (e.g. <c>nano</c>) receive it through the exact
    /// dispatch surface <see cref="HandleFullScreenKeyAsync"/> already uses, so they gain
    /// virtual-keyboard support with no changes of their own. Line-mode input is mutated directly
    /// in C# rather than by synthesizing a DOM event: browsers do not apply default text-editing
    /// behavior (character insertion, backspace) to programmatically dispatched key events.
    /// </summary>
    public async Task PushVirtualKey(VirtualKeyPressedEvent evt)
    {
        if (_isFullScreen)
        {
            if (TryMapToTerminalKey(evt, out TerminalKeyEvent terminalKeyEvent))
            {
                _fullScreenSession?.TryPostKey(terminalKeyEvent);
            }

            return;
        }

        switch (evt.Key)
        {
            case VirtualKey.Character when evt.Control && evt.Text == "c":
                CancelActiveCommand();
                break;
            case VirtualKey.Character when evt.Control && evt.Text == "l":
                ClearBuffer();
                break;
            case VirtualKey.Character when evt.Control && evt.Text == "d":
                await RequestExitOnEmptyLineAsync();
                break;
            case VirtualKey.Character when !evt.Control && evt.Text is not null:
                _inputBuffer += evt.Text;
                break;
            case VirtualKey.Backspace when _inputBuffer.Length > 0:
                _inputBuffer = _inputBuffer[..^1];
                break;
            case VirtualKey.Enter:
                await ExecuteInputAsync();
                break;
            case VirtualKey.ArrowUp:
                if (_session?.NavigateHistory(-1) is { } previous)
                {
                    _inputBuffer = previous;
                }
                break;
            case VirtualKey.ArrowDown:
                if (_session?.NavigateHistory(1) is { } next)
                {
                    _inputBuffer = next;
                }
                break;
            case VirtualKey.Tab:
                AutoCompleteInput();
                break;
            case VirtualKey.Escape:
                _inputBuffer = string.Empty;
                break;
        }
    }

    /// <summary>
    /// Ctrl+D matches a real shell's EOF convention: meaningful only on an empty line, a no-op
    /// otherwise. Invokes <see cref="OnExitRequested"/> if a host bound it; this session does not
    /// decide by itself what "exit" means (e.g. closing a window) — that's a host concern.
    /// </summary>
    private Task RequestExitOnEmptyLineAsync() =>
        _inputBuffer.Length == 0 ? OnExitRequested.InvokeAsync() : Task.CompletedTask;

    private static bool TryMapToTerminalKey(VirtualKeyPressedEvent evt, out TerminalKeyEvent terminalKeyEvent)
    {
        TerminalKey? key = evt.Key switch
        {
            VirtualKey.Character => TerminalKey.Character,
            VirtualKey.Enter => TerminalKey.Enter,
            VirtualKey.Backspace => TerminalKey.Backspace,
            VirtualKey.Delete => TerminalKey.Delete,
            VirtualKey.Escape => TerminalKey.Escape,
            VirtualKey.ArrowLeft => TerminalKey.ArrowLeft,
            VirtualKey.ArrowRight => TerminalKey.ArrowRight,
            VirtualKey.ArrowUp => TerminalKey.ArrowUp,
            VirtualKey.ArrowDown => TerminalKey.ArrowDown,
            VirtualKey.Home => TerminalKey.Home,
            VirtualKey.End => TerminalKey.End,
            VirtualKey.PageUp => TerminalKey.PageUp,
            VirtualKey.PageDown => TerminalKey.PageDown,
            _ => null,
        };

        if (key is null)
        {
            terminalKeyEvent = default!;
            return false;
        }

        terminalKeyEvent = new TerminalKeyEvent(key.Value, evt.Text, evt.Control, evt.Alt, evt.Shift);
        return true;
    }

    private async Task ExecuteInputAsync()
    {
        string rawLine = _inputBuffer.Trim();
        _inputBuffer = string.Empty;

        if (string.IsNullOrWhiteSpace(rawLine))
        {
            AddLine(new TerminalOutputLine(Prompt, string.Empty, OutputType.PromptOnly));
            return;
        }

        AddLine(new TerminalOutputLine(Prompt, rawLine, OutputType.Input));
        if (_session is null)
        {
            AddLine(new TerminalOutputLine(string.Empty, "hsh: no user session", OutputType.Error));
            return;
        }

        _session.AddHistory(rawLine);
        _activeCts = new CancellationTokenSource();
        _stdoutDecoder = new TerminalControlSequenceDecoder();
        _stderrDecoder = new TerminalControlSequenceDecoder();
        _fullScreenSession = new TerminalFullScreenSession(ApplyFullScreenStateAsync);
        try
        {
            // ADR 0050 section 4: output is shown as commands produce it, not when they exit.
            await Shell.ExecuteAsync(
                _session,
                rawLine,
                new ShellExecutionOptions
                {
                    StandardOutput = new TerminalOutputWriter(text => AppendOutput(text, OutputType.Stdout)),
                    StandardError = new TerminalOutputWriter(text => AppendOutput(text, OutputType.Stderr)),
                    FullScreen = _fullScreenSession,
                    ApprovalPrompt = _approvalPrompt,
                    // ADR 0051 section 4: the catalog's sudo asks the shell, which asks here.
                    CredentialPrompt = RequestSudoAsync,
                    PermissionApproval = RequestPermissionApprovalAsync
                },
                _activeCts.Token);
        }
        catch (Exception ex)
        {
            AppContext.Logging.Log(DiagnosticSeverity.Error, $"Shell fault: {ex.Message}");
            AddLine(new TerminalOutputLine(string.Empty, $"Fault: {ex.Message}", OutputType.Error));
            _session.LastExitCode = 1;
        }
        finally
        {
            CloseOpenLines();
            await _fullScreenSession.DisposeAsync();
            _fullScreenSession = null;
            _activeCts.Dispose();
            _activeCts = null;
        }
    }

    /// <summary>
    /// The credential window behind <c>sudo</c> (ADR 0042, ADR 0051 section 4): an administrator's
    /// login and password mint a single-use <c>SudoRoot</c> ticket.
    /// </summary>
    private async Task<ShellElevation?> RequestSudoAsync(string description, CancellationToken cancellationToken)
    {
        ElevationRequestResult? approval = await RequestElevationAsync(
            "Administrator Authorization Required",
            description,
            (loginName, password, ct) => Elevation.RequestSudoAsync(loginName, password, ct));

        return approval is { Success: true, Token: Guid token }
            ? new ShellElevation(token, ElevationScope.SudoRoot)
            : null;
    }

    /// <summary>
    /// ADR 0042: offers an administrator's one-shot approval when a lone command failed on a
    /// permission denial; the shell reruns it with the ticket.
    /// </summary>
    private async Task<ShellElevation?> RequestPermissionApprovalAsync(ShellPermissionDenial denial, CancellationToken cancellationToken)
    {
        FileSystemError denied = denial.Error;
        ElevationRequestResult? approval = await RequestElevationAsync(
            "Permission Denied — Request Approval?",
            $"'{denial.CommandName}' was denied {denied.Code} on '{denied.Path}'. Approve this one operation?",
            (loginName, password, ct) => Elevation.RequestCapabilityApprovalAsync(
                loginName, password, denied.RequiredCapability!, denied.Path, ct));

        return approval is { Success: true, Token: Guid token }
            ? new ShellElevation(token, ElevationScope.CapabilityApproval)
            : null;
    }

    /// <summary>
    /// Receives a chunk of a command's output, as a terminal emulator does: control sequences are
    /// interpreted (<c>clear</c> writes <c>ESC[2J</c>, ADR 0051 section 4), the rest is printed.
    /// </summary>
    private void AppendOutput(string text, OutputType type)
    {
        TerminalControlSequenceDecoder decoder = type == OutputType.Stderr ? _stderrDecoder : _stdoutDecoder;
        foreach (TerminalOutputAction action in decoder.Decode(text))
        {
            if (action.Kind == TerminalOutputActionKind.EraseScreen)
            {
                ClearBuffer();
            }
            else
            {
                AppendText(action.Text, type);
            }
        }

        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Prints text: it continues the current open line of the same stream, and each <c>\n</c>
    /// closes a line, like characters reaching a real terminal.
    /// </summary>
    private void AppendText(string text, OutputType type)
    {
        lock (_linesSync)
        {
            string[] pieces = text.Split('\n');
            for (int index = 0; index < pieces.Length; index++)
            {
                bool closesLine = index < pieces.Length - 1;
                string piece = pieces[index].TrimEnd('\r');
                TerminalOutputLine? open = _lines.Count > 0 && _lines[^1] is { IsOpen: true } last && last.Type == type ? last : null;
                if (open is not null)
                {
                    open.Text += piece;
                    open.IsOpen = !closesLine;
                }
                else if (piece.Length > 0 || closesLine)
                {
                    CloseOpenLinesUnsafe();
                    _lines.Add(new TerminalOutputLine(string.Empty, piece, type) { IsOpen = !closesLine });
                }
            }
        }
    }

    private void AddLine(TerminalOutputLine line)
    {
        lock (_linesSync)
        {
            CloseOpenLinesUnsafe();
            _lines.Add(line);
        }
    }

    private void CloseOpenLines()
    {
        lock (_linesSync)
        {
            CloseOpenLinesUnsafe();
        }
    }

    private void CloseOpenLinesUnsafe()
    {
        if (_lines.Count > 0)
        {
            _lines[^1].IsOpen = false;
        }
    }

    /// <summary>
    /// Prompts for an enabled Administrator's credentials and, if submitted, verifies them and mints
    /// the requested elevation ticket via <paramref name="requestTicket"/> (`ADR 0042`). Returns null
    /// if the prompt was cancelled; otherwise the (possibly unsuccessful) verification result.
    /// </summary>
    private async Task<ElevationRequestResult?> RequestElevationAsync(
        string title,
        string description,
        Func<string, string, CancellationToken, Task<ElevationRequestResult>> requestTicket)
    {
        CredentialPromptDialogResult prompt = await Dialogs.CredentialPromptAsync(AppContext, new CredentialPromptDialogRequest
        {
            Title = title,
            Description = description
        });

        if (prompt.Status != CredentialPromptStatus.Submitted)
        {
            return null;
        }

        return await requestTicket(prompt.LoginName!, prompt.Password!, AppContext.CancellationToken);
    }

    /// <summary>Appends one line of the text-mode dangerous-capability approval (ADR 0049) and re-renders.</summary>
    private Task WriteApprovalLineAsync(string text, TerminalApprovalLineKind kind)
    {
        AddLine(new TerminalOutputLine(string.Empty, text, kind switch
        {
            TerminalApprovalLineKind.Warning => OutputType.Stderr,
            TerminalApprovalLineKind.Error => OutputType.Error,
            _ => OutputType.System
        }));
        return InvokeAsync(StateHasChanged);
    }

    private void CancelActiveCommand()
    {
        if (_activeCts is not null && !_activeCts.IsCancellationRequested)
        {
            _activeCts.Cancel();
            AddLine(new TerminalOutputLine(string.Empty, "^C", OutputType.System));
        }
    }

    /// <summary>Erases the screen and its scrollback, banner included (Ctrl+L, or <c>ESC[2J</c> from <c>clear</c>).</summary>
    private void ClearBuffer()
    {
        lock (_linesSync)
        {
            _lines.Clear();
            _showBanner = false;
        }
    }

    private void AutoCompleteInput()
    {
        if (string.IsNullOrWhiteSpace(_inputBuffer))
        {
            return;
        }

        // ADR 0051 section 2: completion knows no command name of its own; it offers the
        // installed commands and their aliases, exactly what the shell can run.
        IEnumerable<string> candidates = Shell.GetInstalledCommands()
            .SelectMany(command => command.Aliases.Prepend(command.Name));

        string matches = candidates.FirstOrDefault(c => c.StartsWith(_inputBuffer, StringComparison.OrdinalIgnoreCase)) ?? string.Empty;
        if (!string.IsNullOrEmpty(matches))
        {
            _inputBuffer = matches;
        }
    }

    /// <summary>Receives character-cell dimensions from the collocated resize observer.</summary>
    [JSInvokable]
    public void UpdateTerminalViewport(int columns, int rows)
    {
        if (columns < 1 || rows < 3)
            return;
        _fullScreenSession?.UpdateViewport(columns, rows);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _activeCts?.Cancel();
        if (_fullScreenSession is not null)
            await _fullScreenSession.DisposeAsync();
        if (_resizeObserver is not null)
            await _resizeObserver.DisposeAsync();
        if (_module is not null)
            await _module.DisposeAsync();
        _dotNetReference?.Dispose();
        _activeCts?.Dispose();
    }

    private Task ApplyFullScreenStateAsync(TerminalScreenFrame? frame, bool active) =>
        InvokeAsync(() =>
        {
            _fullScreenFrame = frame;
            _isFullScreen = active;
            StateHasChanged();
        });


    private enum OutputType { Input, PromptOnly, Stdout, Stderr, System, Error }

    /// <summary>One displayed line; an output line stays open (mutable) until its <c>\n</c> arrives.</summary>
    private sealed class TerminalOutputLine(string prompt, string text, OutputType type)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string Prompt { get; } = prompt;
        public string Text { get; set; } = text;
        public OutputType Type { get; } = type;
        public bool IsOpen { get; set; }
        public string TypeClass => Type switch
        {
            OutputType.Input => "line-input",
            OutputType.Stderr => "line-stderr",
            OutputType.Error => "line-error",
            OutputType.System => "line-system",
            _ => "line-stdout"
        };
    }
}
