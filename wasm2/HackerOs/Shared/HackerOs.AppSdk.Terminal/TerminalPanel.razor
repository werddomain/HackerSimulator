@namespace HackerOs.AppSdk.Terminal
@using HackerOs.App.Abstractions
@using HackerOs.App.Abstractions.Policy
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.VirtualKeyboard
@using HackerOs.Platform.Core
@using HackerOs.Platform.Core.Intents
@using HackerOs.Simulation.Abstractions.Diagnostics
@using HackerOs.Simulation.Abstractions.FileSystem
@using HackerOs.Simulation.Abstractions.Sessions
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject AppCatalog Catalog
@inject HackerOs.Platform.Core.Lifecycle.IAppEnablementRegistry Enablement
@inject AppIntentDispatcher IntentDispatcher
@inject ISessionService SessionService
@inject IJSRuntime JavaScript
@inject IDialogService Dialogs
@inject IElevationService Elevation

@*
    Reusable terminal control (session/shell/rendering) extracted from the standalone Terminal app so
    any WindowAppBase-hosted app can embed a shell. The host supplies its own AppContext (filesystem,
    cancellation, logging scoped to that app instance) and an optional CallerAppId used when dispatching
    executed commands through the AppIntentDispatcher — see Apps/System/HackerOs.Apps.Terminal for the
    thin standalone host, and HackerOs.Apps.CodeEditor for an embedded usage.
*@
<div class="terminal-container" @ref="_terminalContainerRef" @onkeydown="HandleKeyDownAsync">
    @if (_isFullScreen)
    {
        <TerminalScreen @ref="_screenComponent"
                        Frame="_fullScreenFrame"
                        OnKey="HandleFullScreenKeyAsync" />
    }
    else
    {
        <div class="terminal-output" @ref="_outputBufferRef" role="log" aria-live="polite">
        <div class="welcome-banner">
            <pre class="ascii-art">
  _  _         _         ___  ___
 | || |__ _ __| |_____ _| _ \/ __|
 | __ / _` / _| / / -_) '_|   /\__ \
 |_||_\__,_\__|__\_\___|_| |_|_|___/
            </pre>
            <p>HackerOS Terminal v1.0.0 — Type 'help' for available commands.</p>
        </div>

        @foreach (TerminalOutputLine line in _lines)
        {
            <div key="@line.Id" class="output-line @line.TypeClass">
                @if (!string.IsNullOrEmpty(line.Prompt))
                {
                    <span class="line-prompt">@line.Prompt </span>
                }
                <span class="line-text">@line.Text</span>
            </div>
        }

        <div class="input-line">
            <span class="input-prompt">@_session.GetPrompt() </span>
            <input @ref="_inputRef"
                   type="text"
                   class="terminal-input"
                   aria-label="Terminal command input"
                   inputmode="@(UseVirtualKeyboard ? "none" : null)"
                   @bind="_inputBuffer"
                   @bind:event="oninput" />
        </div>
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the host app's execution context (filesystem, cancellation, logging).</summary>
    [Parameter, EditorRequired]
    public IAppExecutionContext AppContext { get; set; } = default!;

    /// <summary>Gets or sets the app id recorded as the caller when dispatching executed commands.</summary>
    [Parameter]
    public string CallerAppId { get; set; } = "org.hackeros.terminal";

    /// <summary>Gets or sets the username used until the authenticated principal initializes the session.</summary>
    [Parameter]
    public string InitialUsername { get; set; } = "user";

    /// <summary>
    /// Gets or sets the starting working directory. When null, the authenticated principal's home
    /// directory is used once available (the standalone Terminal app's behavior). When set, the
    /// session still adopts the principal's real $HOME for <c>~</c> expansion, but starts <c>cwd</c>
    /// here instead — e.g. CodeEditor opens new terminal tabs in whatever folder it has open.
    /// </summary>
    [Parameter]
    public string? InitialCwd { get; set; }

    /// <summary>
    /// Gets or sets whether input is driven by a <c>HackerOs.AppSdk.VirtualKeyboard</c> control
    /// instead of the physical keyboard. When true, the line-mode input gets
    /// <c>inputmode="none"</c> so a touch focus does not open the platform's native keyboard —
    /// callers are expected to route key presses through <see cref="PushVirtualKey"/> instead.
    /// </summary>
    [Parameter]
    public bool UseVirtualKeyboard { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user requests to exit via Ctrl+D on an empty
    /// input line (matching a real shell's EOF convention). Unbound by default: this session does
    /// not decide how "exit" should be handled by itself — it only offers the hook.
    /// </summary>
    [Parameter]
    public EventCallback OnExitRequested { get; set; }

    private ElementReference _outputBufferRef;
    private ElementReference _inputRef;
    private ElementReference _terminalContainerRef;
    private TerminalScreen? _screenComponent;
    private TerminalSession _session = default!;
    private readonly List<TerminalOutputLine> _lines = [];
    private string _inputBuffer = string.Empty;
    private CancellationTokenSource? _activeCts;
    private TerminalCommandResolver? _resolver;
    private TerminalFullScreenSession? _fullScreenSession;
    private TerminalScreenFrame? _fullScreenFrame;
    private bool _isFullScreen;
    private IJSObjectReference? _module;
    private IJSObjectReference? _resizeObserver;
    private DotNetObjectReference<TerminalPanel>? _dotNetReference;
    private TerminalDangerousCapabilityApprovalPrompt? _approvalPrompt;

    protected override void OnInitialized()
    {
        _session = new TerminalSession(InitialUsername, InitialCwd ?? "/home/user")
        {
            HostName = AppContext.Environment.MachineName
        };
        _resolver = new TerminalCommandResolver(Catalog, Enablement);
        // ADR 0049 section 5: a third-party command's pending dangerous capabilities are asked
        // here, in text mode, rather than with the desktop overlay.
        _approvalPrompt = new TerminalDangerousCapabilityApprovalPrompt(Dialogs, AppContext, WriteApprovalLineAsync);
        if (SessionService.CurrentPrincipal is { } principal)
        {
            _session.InitializeUser(principal.LoginName.Value, principal.HomePath);
            if (InitialCwd is not null)
            {
                _session.SetCwd(InitialCwd);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await _inputRef.FocusAsync();
            }
            catch (Exception)
            {
                // Headless test DOM fallback
            }

            try
            {
                _dotNetReference = DotNetObjectReference.Create(this);
                _module = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HackerOs.AppSdk.Terminal/TerminalPanel.razor.js");
                _resizeObserver = await _module.InvokeAsync<IJSObjectReference>(
                    "observeTerminal", _terminalContainerRef, _dotNetReference);
            }
            catch (Exception)
            {
                // Headless test DOM and unavailable-JS fallback retain the safe 80x24 viewport.
            }
        }

        if (_isFullScreen)
        {
            try
            {
                if (_screenComponent is not null)
                    await _screenComponent.FocusAsync();
            }
            catch (Exception)
            {
                // Headless test DOM fallback.
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (_isFullScreen)
            return;

        if (args.Key == "Enter")
        {
            await ExecuteInputAsync();
        }
        else if (args.Key == "ArrowUp")
        {
            string? previous = _session.NavigateHistory(-1, _inputBuffer);
            if (previous is not null)
            {
                _inputBuffer = previous;
            }
        }
        else if (args.Key == "ArrowDown")
        {
            string? next = _session.NavigateHistory(1, _inputBuffer);
            if (next is not null)
            {
                _inputBuffer = next;
            }
        }
        else if (args.Key == "c" && args.CtrlKey)
        {
            CancelActiveCommand();
        }
        else if (args.Key == "l" && args.CtrlKey)
        {
            ClearBuffer();
        }
        else if (args.Key == "d" && args.CtrlKey)
        {
            await RequestExitOnEmptyLineAsync();
        }
        else if (args.Key == "Escape")
        {
            _inputBuffer = string.Empty;
        }
        else if (args.Key == "Tab")
        {
            AutoCompleteInput();
        }
    }

    private Task HandleFullScreenKeyAsync(TerminalKeyEvent keyEvent)
    {
        _fullScreenSession?.TryPostKey(keyEvent);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Routes one key press from a <c>VirtualKeyboard</c> into the same actions the physical
    /// keyboard already triggers. Full-screen apps (e.g. <c>nano</c>) receive it through the exact
    /// dispatch surface <see cref="HandleFullScreenKeyAsync"/> already uses, so they gain
    /// virtual-keyboard support with no changes of their own. Line-mode input is mutated directly
    /// in C# rather than by synthesizing a DOM event: browsers do not apply default text-editing
    /// behavior (character insertion, backspace) to programmatically dispatched key events.
    /// </summary>
    public async Task PushVirtualKey(VirtualKeyPressedEvent evt)
    {
        if (_isFullScreen)
        {
            if (TryMapToTerminalKey(evt, out TerminalKeyEvent terminalKeyEvent))
            {
                _fullScreenSession?.TryPostKey(terminalKeyEvent);
            }

            return;
        }

        switch (evt.Key)
        {
            case VirtualKey.Character when evt.Control && evt.Text == "c":
                CancelActiveCommand();
                break;
            case VirtualKey.Character when evt.Control && evt.Text == "l":
                ClearBuffer();
                break;
            case VirtualKey.Character when evt.Control && evt.Text == "d":
                await RequestExitOnEmptyLineAsync();
                break;
            case VirtualKey.Character when !evt.Control && evt.Text is not null:
                _inputBuffer += evt.Text;
                break;
            case VirtualKey.Backspace when _inputBuffer.Length > 0:
                _inputBuffer = _inputBuffer[..^1];
                break;
            case VirtualKey.Enter:
                await ExecuteInputAsync();
                break;
            case VirtualKey.ArrowUp:
                if (_session.NavigateHistory(-1, _inputBuffer) is { } previous)
                {
                    _inputBuffer = previous;
                }
                break;
            case VirtualKey.ArrowDown:
                if (_session.NavigateHistory(1, _inputBuffer) is { } next)
                {
                    _inputBuffer = next;
                }
                break;
            case VirtualKey.Tab:
                AutoCompleteInput();
                break;
            case VirtualKey.Escape:
                _inputBuffer = string.Empty;
                break;
        }
    }

    /// <summary>
    /// Ctrl+D matches a real shell's EOF convention: meaningful only on an empty line, a no-op
    /// otherwise. Invokes <see cref="OnExitRequested"/> if a host bound it; this session does not
    /// decide by itself what "exit" means (e.g. closing a window) — that's a host concern.
    /// </summary>
    private Task RequestExitOnEmptyLineAsync() =>
        _inputBuffer.Length == 0 ? OnExitRequested.InvokeAsync() : Task.CompletedTask;

    private static bool TryMapToTerminalKey(VirtualKeyPressedEvent evt, out TerminalKeyEvent terminalKeyEvent)
    {
        TerminalKey? key = evt.Key switch
        {
            VirtualKey.Character => TerminalKey.Character,
            VirtualKey.Enter => TerminalKey.Enter,
            VirtualKey.Backspace => TerminalKey.Backspace,
            VirtualKey.Delete => TerminalKey.Delete,
            VirtualKey.Escape => TerminalKey.Escape,
            VirtualKey.ArrowLeft => TerminalKey.ArrowLeft,
            VirtualKey.ArrowRight => TerminalKey.ArrowRight,
            VirtualKey.ArrowUp => TerminalKey.ArrowUp,
            VirtualKey.ArrowDown => TerminalKey.ArrowDown,
            VirtualKey.Home => TerminalKey.Home,
            VirtualKey.End => TerminalKey.End,
            VirtualKey.PageUp => TerminalKey.PageUp,
            VirtualKey.PageDown => TerminalKey.PageDown,
            _ => null,
        };

        if (key is null)
        {
            terminalKeyEvent = default!;
            return false;
        }

        terminalKeyEvent = new TerminalKeyEvent(key.Value, evt.Text, evt.Control, evt.Alt, evt.Shift);
        return true;
    }

    private async Task ExecuteInputAsync()
    {
        string rawLine = _inputBuffer.Trim();
        _inputBuffer = string.Empty;

        if (string.IsNullOrWhiteSpace(rawLine))
        {
            _lines.Add(new TerminalOutputLine(_session.GetPrompt(), string.Empty, OutputType.PromptOnly));
            return;
        }

        _lines.Add(new TerminalOutputLine(_session.GetPrompt(), rawLine, OutputType.Input));
        _session.AddHistory(rawLine);

        ShellParseResult parseResult = ShellParser.Parse(rawLine);
        if (!parseResult.IsSuccess)
        {
            _lines.Add(new TerminalOutputLine(string.Empty, parseResult.ErrorMessage!, OutputType.Error));
            _session.LastExitCode = 2;
            return;
        }

        string cmd = parseResult.CommandName;
        IReadOnlyList<string> args = parseResult.Arguments;

        if (cmd is "rmalias" or "unalias")
        {
            args = ["-r", .. args];
            cmd = "alias";
        }
        else if (cmd != "alias" && SessionService.CurrentPrincipal is AuthenticatedPrincipal aliasPrincipal)
        {
            string? expansion = await TryResolveAliasAsync(aliasPrincipal.HomePath, cmd);
            if (expansion is not null)
            {
                ShellParseResult expanded = ShellParser.Parse($"{expansion} {string.Join(" ", args)}".Trim());
                if (expanded.IsSuccess)
                {
                    cmd = expanded.CommandName;
                    args = expanded.Arguments;
                }
            }
        }

        Guid? elevationToken = null;
        ElevationScope? elevationScope = null;

        if (cmd == "sudo")
        {
            if (args.Count == 0)
            {
                _lines.Add(new TerminalOutputLine(string.Empty, "sudo: usage: sudo <command> [args...]", OutputType.Error));
                _session.LastExitCode = 1;
                return;
            }

            ElevationRequestResult? sudoApproval = await RequestElevationAsync(
                "Administrator Authorization Required",
                $"Run as root: {string.Join(" ", args)}",
                (loginName, password, ct) => Elevation.RequestSudoAsync(loginName, password, ct));

            if (sudoApproval is not { Success: true })
            {
                _lines.Add(new TerminalOutputLine(string.Empty, "sudo: authentication failed", OutputType.Error));
                _session.LastExitCode = 1;
                return;
            }

            cmd = args[0];
            args = args.Skip(1).ToArray();
            elevationToken = sudoApproval.Token;
            elevationScope = ElevationScope.SudoRoot;

            if (cmd is "cd" or "pwd" or "clear" or "help" or "sudo")
            {
                _lines.Add(new TerminalOutputLine(string.Empty, $"sudo: {cmd}: command not found", OutputType.Error));
                _session.LastExitCode = 1;
                return;
            }
        }

        if (cmd == "clear")
        {
            ClearBuffer();
            return;
        }

        if (cmd == "pwd")
        {
            _lines.Add(new TerminalOutputLine(string.Empty, _session.Cwd, OutputType.Stdout));
            _session.LastExitCode = 0;
            return;
        }

        if (cmd == "cd")
        {
            string targetPath = args.Count > 0 ? args[0] : "~";
            string resolvedPath = _session.ResolvePath(targetPath);
            var stat = await AppContext.FileSystem.StatAsync(
                new FileSystemStatRequest(VirtualPath.Parse(resolvedPath)), AppContext.CancellationToken);

            if (!stat.Succeeded || stat.Value is null)
            {
                string message = stat.Error?.Code is FileSystemErrorCode.PermissionDenied or FileSystemErrorCode.CapabilityDenied
                    ? $"cd: {targetPath}: Permission denied"
                    : $"cd: {targetPath}: No such file or directory";
                _lines.Add(new TerminalOutputLine(string.Empty, message, OutputType.Error));
                _session.LastExitCode = 1;
            }
            else if (stat.Value.Metadata.Kind != FileSystemEntryKind.Directory)
            {
                _lines.Add(new TerminalOutputLine(string.Empty, $"cd: {targetPath}: Not a directory", OutputType.Error));
                _session.LastExitCode = 1;
            }
            else
            {
                _session.SetCwd(targetPath);
                _session.LastExitCode = 0;
            }
            return;
        }

        if (cmd == "help")
        {
            if (args.Count > 0)
            {
                AppManifest? target = _resolver?.GetTerminalCommands()
                    .FirstOrDefault(m => string.Equals(m.Terminal!.Name, args[0], StringComparison.OrdinalIgnoreCase));
                if (target is null)
                {
                    _lines.Add(new TerminalOutputLine(string.Empty, $"help: no manual entry for '{args[0]}'", OutputType.Error));
                    _session.LastExitCode = 1;
                }
                else
                {
                    _lines.Add(new TerminalOutputLine(string.Empty, $"{target.Terminal!.Name} - {target.Description}", OutputType.System));
                    _lines.Add(new TerminalOutputLine(string.Empty, $"usage: {target.Terminal.Usage}", OutputType.System));
                    _session.LastExitCode = 0;
                }
                return;
            }

            _lines.Add(new TerminalOutputLine(string.Empty, "Built-in commands: clear, cd, pwd, help, sudo", OutputType.System));
            _lines.Add(new TerminalOutputLine(string.Empty, "Catalog commands: " + string.Join(", ", GetCatalogCommands()), OutputType.System));
            _lines.Add(new TerminalOutputLine(string.Empty, "Type 'help <command>' for usage.", OutputType.System));
            _session.LastExitCode = 0;
            return;
        }

        // Resolve external command from AppCatalog
        TerminalCommandResolution? resolution = _resolver?.Resolve(cmd, args);
        if (resolution is null)
        {
            AppContext.Logging.Log(DiagnosticSeverity.Warning, $"Command '{cmd}' not found in system path.");
            _lines.Add(new TerminalOutputLine(string.Empty, $"command not found: {cmd}", OutputType.Error));
            _session.LastExitCode = 127;
            return;
        }

        if (SessionService.CurrentPrincipal is AuthenticatedPrincipal principal)
        {
            _activeCts = new CancellationTokenSource();
            _fullScreenSession = new TerminalFullScreenSession(ApplyFullScreenStateAsync);
            try
            {
                AppIntentDispatchResult result = await IntentDispatcher.DispatchAsync(new AppIntentRequest(
                    RequestId: Guid.NewGuid(),
                    CallerAppId: CallerAppId,
                    UserId: principal.UserId.ToString(),
                    Intent: new ExecuteCommandIntent(
                        $"{cmd} {string.Join(" ", args)}".Trim(), VirtualPath.Parse(_session.Cwd),
                        elevationToken, elevationScope)),
                    principal,
                    _fullScreenSession,
                    _activeCts.Token,
                    _approvalPrompt);

                if (result.Status == AppIntentDispatchStatus.Dispatched)
                {
                    if (!string.IsNullOrEmpty(result.StandardOutput))
                    {
                        _lines.Add(new TerminalOutputLine(string.Empty, result.StandardOutput, OutputType.Stdout));
                    }
                    if (!string.IsNullOrEmpty(result.StandardError))
                    {
                        _lines.Add(new TerminalOutputLine(string.Empty, result.StandardError, OutputType.Stderr));
                    }
                    _session.LastExitCode = result.ExitCode ?? 0;

                    if (result.ExitCode is not 0
                        && elevationToken is null
                        && result.PermissionDenials is { Count: > 0 } denials
                        && denials[0].RequiredCapability is { } requiredCapability)
                    {
                        FileSystemError denied = denials[0];
                        ElevationRequestResult? approval = await RequestElevationAsync(
                            "Permission Denied — Request Approval?",
                            $"'{cmd}' was denied {denied.Code} on '{denied.Path}'. Approve this one operation?",
                            (loginName, password, ct) => Elevation.RequestCapabilityApprovalAsync(
                                loginName, password, requiredCapability, denied.Path, ct));

                        if (approval is { Success: true })
                        {
                            AppIntentDispatchResult retryResult = await IntentDispatcher.DispatchAsync(new AppIntentRequest(
                                RequestId: Guid.NewGuid(),
                                CallerAppId: CallerAppId,
                                UserId: principal.UserId.ToString(),
                                Intent: new ExecuteCommandIntent(
                                    $"{cmd} {string.Join(" ", args)}".Trim(), VirtualPath.Parse(_session.Cwd),
                                    approval.Token, ElevationScope.CapabilityApproval)),
                                principal,
                                _fullScreenSession,
                                _activeCts.Token,
                                _approvalPrompt);

                            if (!string.IsNullOrEmpty(retryResult.StandardOutput))
                            {
                                _lines.Add(new TerminalOutputLine(string.Empty, retryResult.StandardOutput, OutputType.Stdout));
                            }
                            if (!string.IsNullOrEmpty(retryResult.StandardError))
                            {
                                _lines.Add(new TerminalOutputLine(string.Empty, retryResult.StandardError, OutputType.Stderr));
                            }
                            _session.LastExitCode = retryResult.ExitCode ?? 0;
                        }
                    }
                }
                else
                {
                    _lines.Add(new TerminalOutputLine(string.Empty, $"Error [{result.Status}]: {result.ErrorCode}", OutputType.Error));
                    _session.LastExitCode = 1;
                }
            }
            catch (Exception ex)
            {
                _lines.Add(new TerminalOutputLine(string.Empty, $"Fault: {ex.Message}", OutputType.Error));
                _session.LastExitCode = 1;
            }
            finally
            {
                await _fullScreenSession.DisposeAsync();
                _fullScreenSession = null;
                _activeCts = null;
            }
        }
    }

    /// <summary>
    /// Prompts for an enabled Administrator's credentials and, if submitted, verifies them and mints
    /// the requested elevation ticket via <paramref name="requestTicket"/> (`ADR 0042`). Returns null
    /// if the prompt was cancelled; otherwise the (possibly unsuccessful) verification result.
    /// </summary>
    private async Task<ElevationRequestResult?> RequestElevationAsync(
        string title,
        string description,
        Func<string, string, CancellationToken, Task<ElevationRequestResult>> requestTicket)
    {
        CredentialPromptDialogResult prompt = await Dialogs.CredentialPromptAsync(AppContext, new CredentialPromptDialogRequest
        {
            Title = title,
            Description = description
        });

        if (prompt.Status != CredentialPromptStatus.Submitted)
        {
            return null;
        }

        return await requestTicket(prompt.LoginName!, prompt.Password!, AppContext.CancellationToken);
    }

    /// <summary>Appends one line of the text-mode dangerous-capability approval (ADR 0049) and re-renders.</summary>
    private Task WriteApprovalLineAsync(string text, TerminalApprovalLineKind kind)
    {
        _lines.Add(new TerminalOutputLine(string.Empty, text, kind switch
        {
            TerminalApprovalLineKind.Warning => OutputType.Stderr,
            TerminalApprovalLineKind.Error => OutputType.Error,
            _ => OutputType.System
        }));
        return InvokeAsync(StateHasChanged);
    }

    private void CancelActiveCommand()
    {
        if (_activeCts is not null && !_activeCts.IsCancellationRequested)
        {
            _activeCts.Cancel();
            _lines.Add(new TerminalOutputLine(string.Empty, "^C", OutputType.System));
            _session.LastExitCode = 130;
        }
    }

    private void ClearBuffer()
    {
        _lines.Clear();
    }

    private void AutoCompleteInput()
    {
        if (string.IsNullOrWhiteSpace(_inputBuffer))
        {
            return;
        }

        List<string> candidates = ["clear", "cd", "pwd", "help", "sudo"];
        candidates.AddRange(GetCatalogCommands());

        string matches = candidates.FirstOrDefault(c => c.StartsWith(_inputBuffer, StringComparison.OrdinalIgnoreCase)) ?? string.Empty;
        if (!string.IsNullOrEmpty(matches))
        {
            _inputBuffer = matches;
        }
    }

    private async Task<string?> TryResolveAliasAsync(string home, string name)
    {
        VirtualPath aliasFilePath = VirtualPath.Parse($"{home.TrimEnd('/')}/.hackeros/aliases");
        var stat = await AppContext.FileSystem.StatAsync(new FileSystemStatRequest(aliasFilePath), AppContext.CancellationToken);
        if (!stat.Succeeded || stat.Value is null)
        {
            return null;
        }

        var read = await AppContext.FileSystem.ReadAsync(new FileSystemReadRequest(aliasFilePath), AppContext.CancellationToken);
        if (!read.Succeeded || read.Value is null)
        {
            return null;
        }

        using StreamReader reader = new(read.Value.Content);
        string content = await reader.ReadToEndAsync(AppContext.CancellationToken);
        foreach (string rawLine in content.Split('\n'))
        {
            string line = rawLine.TrimEnd('\r').Trim();
            int eqIdx = line.IndexOf('=');
            if (eqIdx <= 0)
            {
                continue;
            }
            if (string.Equals(line[..eqIdx], name, StringComparison.Ordinal))
            {
                return line[(eqIdx + 1)..];
            }
        }

        return null;
    }

    private IEnumerable<string> GetCatalogCommands()
    {
        // Uninstalled commands (ADR 0048) are neither listed by help nor offered by completion.
        // ADR 0051: cd/pwd/clear/help are now installed with the other commands, but this panel
        // still intercepts them (and sudo) and lists them as built-ins; skip them here so help does
        // not show them twice. Removed with the hard-coded names by rebuild/3-shell-commands.
        return (_resolver ?? new TerminalCommandResolver(Catalog, Enablement))
            .GetTerminalCommands()
            .Select(m => m.Terminal!.Name)
            .Where(name => name is not ("cd" or "pwd" or "clear" or "help" or "sudo"));
    }

    /// <summary>Receives character-cell dimensions from the collocated resize observer.</summary>
    [JSInvokable]
    public void UpdateTerminalViewport(int columns, int rows)
    {
        if (columns < 1 || rows < 3)
            return;
        _fullScreenSession?.UpdateViewport(columns, rows);
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _activeCts?.Cancel();
        if (_fullScreenSession is not null)
            await _fullScreenSession.DisposeAsync();
        if (_resizeObserver is not null)
            await _resizeObserver.DisposeAsync();
        if (_module is not null)
            await _module.DisposeAsync();
        _dotNetReference?.Dispose();
        _activeCts?.Dispose();
    }

    private Task ApplyFullScreenStateAsync(TerminalScreenFrame? frame, bool active) =>
        InvokeAsync(() =>
        {
            _fullScreenFrame = frame;
            _isFullScreen = active;
            StateHasChanged();
        });


    private enum OutputType { Input, PromptOnly, Stdout, Stderr, System, Error }

    private sealed record TerminalOutputLine(string Prompt, string Text, OutputType Type)
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string TypeClass => Type switch
        {
            OutputType.Input => "line-input",
            OutputType.Stderr => "line-stderr",
            OutputType.Error => "line-error",
            OutputType.System => "line-system",
            _ => "line-stdout"
        };
    }
}
