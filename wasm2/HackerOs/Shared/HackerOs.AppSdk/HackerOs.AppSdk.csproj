<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.App.Abstractions\HackerOs.App.Abstractions.csproj" />
    <ProjectReference Include="..\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0104: IStringLocalizer, the contract HackStringLocalizer implements. -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0069: the OS's per-process scheduler stamps the time slice CheckpointAsync reads (HackProcessSlice). -->
    <InternalsVisibleTo Include="HackerOs.Platform.Core" />
    <InternalsVisibleTo Include="HackerOs.AppSdk.Tests" />
    <!-- Tests that wait for the work deferred on a stop request, as the OS does. -->
    <InternalsVisibleTo Include="HackerOs.AppSdk.Blazor.Tests" />
    <!-- ADR 0066/0067: only the optional resource-accounting project may install the context-switch
         hook on HackExecutionContext's ambient frame; apps never can. -->
    <InternalsVisibleTo Include="HackerOs.Platform.ResourceAccounting" />
    <!-- ADR 0067: the OS gateways open the "kernel" sub-frame (stime) with HackExecutionContext.EnterKernel. -->
    <InternalsVisibleTo Include="HackerOs.Platform.Core" />
    <!-- ADR 0070: the worker host is the OS inside a Web Worker: it meters CPU with the same hook,
         opens the kernel sub-frame around remote calls and waits for the work deferred on a stop
         request. Apps still never can. -->
    <InternalsVisibleTo Include="HackerOs.Platform.WorkerHost" />
    <InternalsVisibleTo Include="HackerOs.Platform.WorkerHost.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
