@namespace HackerOs.AppSdk.FileView
@using Microsoft.AspNetCore.Components.Web

@*
    One Tree-mode node, recursively rendering its own expanded children (FV-004). The chevron toggles
    expansion (lazy-loading children on first expand); the row itself uses the same select/activate/
    rename/context-menu handlers as FileViewDetails/FileViewIcons — a node doesn't know it's in a tree.
*@
<li role="treeitem" aria-level="@Depth" aria-selected="@Node.Item.IsSelected" aria-expanded="@AriaExpanded">
    <div class="file-view-tree-row @(Node.Item.IsSelected ? "selected" : null)"
         data-item-path="@Node.Item.FullPath.Value"
         tabindex="@(IsTabStop() ? 0 : -1)"
         draggable="@(Owner.AllowDragDrop ? "true" : "false")"
         @onclick="OnRowClick"
         @ondblclick="OnRowDoubleClickAsync"
         @oncontextmenu="OnRowContextMenuAsync"
         @oncontextmenu:preventDefault="true"
         @onkeydown="OnRowKeyDownAsync"
         @ondragstart="OnRowDragStartAsync"
         @ondragover:preventDefault="@(Node.Item.IsDirectory && Owner.AllowDragDrop)"
         @ondrop="OnRowDropAsync">
        <button type="button"
                class="file-view-tree-toggle"
                disabled="@(!Node.Item.IsDirectory)"
                tabindex="-1"
                @onclick="ToggleExpandAsync"
                @onclick:stopPropagation="true">
            @if (Node.Item.IsDirectory)
            {
                @(Node.IsLoading ? "…" : Node.IsExpanded ? "▼" : "▶")
            }
        </button>
        <ShellIcon Icon="ResolveIcon(Node.Item)" Size="16" />
        @if (Node.Item.IsRenaming)
        {
            <input class="file-view-rename-input"
                   value="@GetRenameBuffer()"
                   @oninput="@(args => SetRenameBuffer(args.Value?.ToString() ?? string.Empty))"
                   @onkeydown="OnRenameKeyDownAsync"
                   @onkeydown:stopPropagation="true"
                   @onblur="CommitRenameAsync"
                   @onclick:stopPropagation="true" />
        }
        else
        {
            <span>@Node.Item.FileName</span>
        }
    </div>
    @if (Node.Item.IsDirectory && Node.IsExpanded && Node.Children is not null)
    {
        <ul class="file-view-tree-group" role="group">
            @foreach (FileViewTreeNodeState child in Node.Children)
            {
                <FileViewTreeNode Owner="Owner" Root="Root" Node="child" Depth="Depth + 1" />
            }
        </ul>
    }
</li>
