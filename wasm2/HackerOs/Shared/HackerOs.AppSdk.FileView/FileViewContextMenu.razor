@namespace HackerOs.AppSdk.FileView
@using MudBlazor
@using Microsoft.AspNetCore.Components.Web

@*
    Reusable context menu: default well-known items (open/rename/delete/new-folder/refresh) plus
    IFileViewContextMenuProvider customization, per FileViewControl.md#context-menu-customization (FV-008).
*@
<MudMenu @ref="_menu" PositionAtCursor="true">
    <ActivatorContent></ActivatorContent>
    <ChildContent>
        @if (_currentItems is not null)
        {
            @foreach (FileViewMenuItem menuItem in _currentItems.Items)
            {
                @if (menuItem.IsSeparatorBefore)
                {
                    <MudDivider />
                }
                <MudMenuItem OnClick="menuItem.OnActivate">
                    <span class="file-view-context-menu-item">
                        @if (menuItem.Icon is not null)
                        {
                            <ShellIcon Icon="menuItem.Icon" Size="16" />
                        }
                        @menuItem.Label
                    </span>
                </MudMenuItem>
            }
        }
    </ChildContent>
</MudMenu>
