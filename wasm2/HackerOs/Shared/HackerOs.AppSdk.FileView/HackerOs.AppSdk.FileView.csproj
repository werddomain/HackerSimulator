<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../Platform/Packaging.props" />

  <PropertyGroup>
    <PackageId>HackerOs.AppSdk.FileView</PackageId>
    <Description>HackerOS file views shared by apps: file lists, icons and pickers over the Hack* file API.</Description>
    <PackageTags>hackeros;app-sdk;blazor;files</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.App.Abstractions\HackerOs.App.Abstractions.csproj" />
    <ProjectReference Include="..\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\HackerOs.AppSdk.Icons\HackerOs.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
  </ItemGroup>

</Project>
