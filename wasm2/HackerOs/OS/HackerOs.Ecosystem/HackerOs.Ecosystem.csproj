<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by the [JSImport] DOM-presence check in Program.cs (SYSLIB1074). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <PublishTrimmed>False</PublishTrimmed>
    <!--
      ADR 0047: aggregates the generated manifests of every referenced app into
      BuiltInApplications.json and lazy-loads their assemblies (build/HackerOs.Apps.targets).
      Installing a migrated app takes only its ProjectReference below.
      ADR 0048: IsSystemApp="true" on a ProjectReference makes every app of that project a system
      app (not uninstallable, dangerous capabilities granted). An app cannot declare it itself.
    -->
    <HackerOsAppHost>true</HackerOsAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Infrastructure\HackerOs.Infrastructure.Browser\HackerOs.Infrastructure.Browser.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Platform.Blazor\HackerOs.Platform.Blazor.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Platform.Core\HackerOs.Platform.Core.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Theming.Blazor\HackerOs.Theming.Blazor.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Icons\HackerOs.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.FileView\HackerOs.AppSdk.FileView.csproj" />
    <ProjectReference Include="..\..\Shared\HackerOs.Theming.Abstractions\HackerOs.Theming.Abstractions.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Browser\HackerOs.Apps.Browser.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Calculator\HackerOs.Apps.Calculator.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.CodeEditor\HackerOs.Apps.CodeEditor.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Diagnostic\HackerOs.Apps.Diagnostic.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.ErrorLogViewer\HackerOs.Apps.ErrorLogViewer.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.FileExplorer\HackerOs.Apps.FileExplorer.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.HackPaint\HackerOs.Apps.HackPaint.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.IconViewer\HackerOs.Apps.IconViewer.csproj" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Settings\HackerOs.Apps.Settings.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.SystemMonitor\HackerOs.Apps.SystemMonitor.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.Terminal\HackerOs.Apps.Terminal.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.TextEditor\HackerOs.Apps.TextEditor.csproj" IsSystemApp="true" />
    <!--
      cd/pwd/clear/help are deliberately not wired here: TerminalWindow.razor intercepts those exact
      command names before catalog resolution ever runs (hardcoded built-ins), so their catalog
      command projects (HackerOs.Commands.Cd/Pwd/Clear/Help) would be permanently unreachable dead
      entries if referenced, and would misleadingly show up in both the "Built-in" and "Catalog" lists
      in `help`'s own output. See docs/adr/0034-wire-terminal-command-catalog.md.
    -->

    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Alias\HackerOs.Commands.Alias.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Cat\HackerOs.Commands.Cat.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Chmod\HackerOs.Commands.Chmod.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Cp\HackerOs.Commands.Cp.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Curl\HackerOs.Commands.Curl.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Diff\HackerOs.Commands.Diff.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Echo\HackerOs.Commands.Echo.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Find\HackerOs.Commands.Find.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Grep\HackerOs.Commands.Grep.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Head\HackerOs.Commands.Head.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Kill\HackerOs.Commands.Kill.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Launch\HackerOs.Commands.Launch.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Ls\HackerOs.Commands.Ls.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Mkdir\HackerOs.Commands.Mkdir.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Mv\HackerOs.Commands.Mv.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Nano\HackerOs.Commands.Nano.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Nmap\HackerOs.Commands.Nmap.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Ping\HackerOs.Commands.Ping.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Ps\HackerOs.Commands.Ps.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Rm\HackerOs.Commands.Rm.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Sort\HackerOs.Commands.Sort.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Tail\HackerOs.Commands.Tail.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Touch\HackerOs.Commands.Touch.csproj" IsSystemApp="true" />
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands.Wc\HackerOs.Commands.Wc.csproj" IsSystemApp="true" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
