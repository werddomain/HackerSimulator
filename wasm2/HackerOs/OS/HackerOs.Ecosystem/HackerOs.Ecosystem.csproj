    <EmbeddedResource Include="..\..\Apps\System\HackerOs.Apps.FileExplorer\app.manifest.json" Link="Manifests\org.hackeros.file-explorer.json" />
    <EmbeddedResource Include="..\..\Apps\System\HackerOs.Apps.HackPaint\app.manifest.json" Link="Manifests\org.hackeros.hack-paint.json" />
