@using HackerOs.App.Abstractions
@using HackerOs.AppSdk.Icons
@implements IDisposable

@*
    The Search view of the side bar (Ctrl+Shift+F), as in VS Code: the search box with its three
    toggles (match case, whole word, regular expression), "files to include/exclude" globs, and the
    results grouped by file. A click on a match opens the file and selects the match.
*@
<div class="search-view">
    <div class="view-title">
        <span>Search</span>
        <span class="title-actions">
            <button type="button" class="icon-button" title="Refresh" aria-label="Refresh search" @onclick="RunNowAsync" disabled="@(Workspace is null)">
                <HackerIcon Library="IconLibrary.Lucide" Name="refresh-cw" Size="15" />
            </button>
            <button type="button" class="icon-button" title="Clear Search Results" aria-label="Clear search results" @onclick="Clear">
                <HackerIcon Library="IconLibrary.Lucide" Name="x" Size="15" />
            </button>
            <button type="button" class="icon-button" title="Collapse All" aria-label="Collapse all results" @onclick="CollapseAll">
                <HackerIcon Library="IconLibrary.Lucide" Name="chevrons-down-up" Size="15" />
            </button>
        </span>
    </div>

    @if (Workspace is null)
    {
        <div class="search-empty">
            <p>Open a folder to search across its files.</p>
            <button type="button" class="primary-button" @onclick="OnOpenFolder">Open Folder</button>
        </div>
    }
    else
    {
        <div class="search-form">
            <div class="search-box">
                <input @ref="_searchInput"
                       id="code-search-input"
                       class="search-input"
                       type="text"
                       placeholder="Search"
                       aria-label="Search in folder"
                       spellcheck="false"
                       value="@_text"
                       @oninput="OnTextInput"
                       @onkeydown="OnSearchKeyDownAsync" />
                <span class="search-toggles">
                    <button type="button" class="toggle @(_matchCase ? "is-on" : null)" title="Match Case" aria-label="Match Case" aria-pressed="@_matchCase" @onclick="ToggleMatchCase">
                        <HackerIcon Library="IconLibrary.Lucide" Name="case-sensitive" Size="15" />
                    </button>
                    <button type="button" class="toggle @(_wholeWord ? "is-on" : null)" title="Match Whole Word" aria-label="Match Whole Word" aria-pressed="@_wholeWord" @onclick="ToggleWholeWord">
                        <HackerIcon Library="IconLibrary.Lucide" Name="whole-word" Size="15" />
                    </button>
                    <button type="button" class="toggle @(_useRegex ? "is-on" : null)" title="Use Regular Expression" aria-label="Use Regular Expression" aria-pressed="@_useRegex" @onclick="ToggleRegex">
                        <HackerIcon Library="IconLibrary.Lucide" Name="regex" Size="15" />
                    </button>
                </span>
            </div>

            <button type="button" class="details-toggle" aria-expanded="@_showDetails" @onclick="ToggleDetails">
                @(_showDetails ? "Hide search details" : "Toggle search details")
            </button>
            @if (_showDetails)
            {
                <label class="glob-label">
                    files to include
                    <input id="code-search-include" class="glob-input" type="text" placeholder="e.g. *.cs, src/**" spellcheck="false"
                           value="@_include" @oninput="OnIncludeInput" @onkeydown="OnSearchKeyDownAsync" />
                </label>
                <label class="glob-label">
                    files to exclude
                    <input id="code-search-exclude" class="glob-input" type="text" placeholder="e.g. **/*.min.js" spellcheck="false"
                           value="@_exclude" @oninput="OnExcludeInput" @onkeydown="OnSearchKeyDownAsync" />
                </label>
            }
        </div>

        <div class="search-summary" role="status">@Summary()</div>

        @if (_result.Error is not null)
        {
            <div class="search-error" role="alert">@_result.Error</div>
        }

        <div class="search-results" aria-label="Search results">
            @foreach (CodeEditorSearchFileResult file in _result.Files)
            {
                bool collapsed = _collapsed.Contains(file.File.RelativePath);
                <div class="result-file" @key="file.File.RelativePath">
                    <button type="button" class="file-row" title="@file.File.Path.Value" aria-expanded="@(!collapsed)" @onclick="() => ToggleFile(file.File.RelativePath)">
                        <HackerIcon Library="IconLibrary.Lucide" Name="@(collapsed ? "chevron-right" : "chevron-down")" Size="14" />
                        <HackerIcon Library="IconLibrary.Lucide" Name="file-text" Size="14" />
                        <span class="file-name">@file.File.Name</span>
                        <span class="file-directory">@file.File.Directory</span>
                        <span class="match-count">@file.Matches.Count</span>
                    </button>
                    @if (!collapsed)
                    {
                        @foreach (CodeEditorSearchMatch match in file.Matches)
                        {
                            <button type="button" class="match-row" title="Line @match.Line, column @match.Column"
                                    @onclick="() => OpenMatchAsync(file.File, match)">
                                <span class="match-before">@Before(match)</span><mark class="match-text">@Matched(match)</mark><span class="match-after">@After(match)</span>
                            </button>
                        }
                    }
                </div>
            }
        </div>
    }
</div>
