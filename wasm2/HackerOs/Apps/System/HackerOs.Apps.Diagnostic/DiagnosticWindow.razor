@using HackerOs.AppSdk.Administration
@using HackerOs.AppSdk.Blazor
@using Microsoft.JSInterop
@inherits WindowAppBase
@inject IJSRuntime JS

<div class="diag-container">
    <header class="diag-header">
        <div class="diag-title-area">
            <span class="diag-title">IndexedDB Diagnostic Inspector</span>
            @if (_snapshot is not null)
            {
                <span class="diag-badge">DB: @_snapshot.DatabaseName v@_snapshot.DatabaseVersion</span>
                <span class="diag-badge diag-badge-info">@_snapshot.ResolvedPaths.Count Virtual Paths Resolved</span>
            }
        </div>
        <div class="diag-actions">
            <button class="diag-btn" @onclick="RefreshAsync" disabled="@_isLoading">
                <span>⟳ Refresh</span>
            </button>
            <button class="diag-btn diag-btn-accent" @onclick="CopyToClipboardAsync" disabled="@(_snapshot is null)">
                <span>📋 Copy JSON to Clipboard</span>
            </button>
            <button class="diag-btn diag-btn-primary" @onclick="ExportJsonFileAsync" disabled="@(_snapshot is null)">
                <span>💾 Save JSON File</span>
            </button>
            <button class="diag-btn" @onclick="DownloadJsonAsync" disabled="@(_snapshot is null)">
                <span>⬇ Download JSON</span>
            </button>
        </div>
    </header>

    <div class="diag-notice-banner">
        💡 <span class="diag-notice-highlight">HackerOS Architecture Note:</span> File metadata is stored in <code>fsEntries</code> (inodes) while directory hierarchy links mapping <code>(parentId, name)</code> to <code>entryId</code> reside in <code>fsLinks</code>. Absolute <code>filePath</code> is dynamically resolved below by traversing directory link trees.
    </div>

    <div class="diag-body">
        @if (_isLoading)
        {
            <div class="diag-content">
                <p>Loading IndexedDB snapshot...</p>
            </div>
        }
        else if (_loadError is not null)
        {
            <div class="diag-content">
                <p class="diag-error" role="alert">@_loadError</p>
            </div>
        }
        else if (_snapshot is not null)
        {
            <aside class="diag-sidebar">
                @foreach (var store in _snapshot.Stores)
                {
                    <button class="diag-store-item @(store.Name == _selectedStoreName ? "active" : "")"
                            @onclick="() => SelectStore(store.Name)">
                        <span>@store.Name</span>
                        <span class="diag-store-count">@store.RecordCount</span>
                    </button>
                }

                <div class="diag-sidebar-heading" title="Browser databases of web sites (hackweb.*), outside the OS database and files">Website databases</div>
                @if (_sites.Count == 0)
                {
                    <div class="diag-sidebar-empty">@(_sitesError ?? "No site has a database yet.")</div>
                }
                @foreach (HackWebSiteDatabaseInfo entry in _sites)
                {
                    <button class="diag-store-item diag-site-item @(entry.Name == _selectedSiteName ? "active" : "")"
                            @onclick="() => SelectSite(entry.Name)">
                        <span>@entry.AppId</span>
                        <span class="diag-store-count">@FormatSize(entry.SizeBytes)</span>
                    </button>
                }
            </aside>

            <main class="diag-content">
                @if (SelectedSite is { } site)
                {
                    <div class="diag-store-header">
                        <div class="diag-store-name">@site.Name (version @site.Version)</div>
                        <div class="diag-store-purpose">
                            Browser database of the web site <code>@site.AppId</code> (ADR 0088): IndexedDB of the host browser,
                            not stored in the HackerOS files. @site.RecordCount records, about @FormatSize(site.SizeBytes).
                        </div>
                    </div>

                    <div class="diag-table-wrapper">
                        <table class="diag-table">
                            <thead>
                                <tr>
                                    <th>Object store</th>
                                    <th>Records</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (HackWebSiteDatabaseStoreInfo store in site.Stores)
                                {
                                    <tr>
                                        <td class="diag-path-highlight">@store.Name</td>
                                        <td>@store.RecordCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="diag-site-actions">
                        @if (_confirmDelete)
                        {
                            <span class="diag-site-warning" role="alert">Delete every record of @site.AppId? The site starts again with an empty database.</span>
                            <button class="diag-btn diag-btn-danger" @onclick="DeleteSiteAsync">Delete</button>
                            <button class="diag-btn" @onclick="() => _confirmDelete = false">Cancel</button>
                        }
                        else
                        {
                            <button class="diag-btn diag-btn-danger" @onclick="() => _confirmDelete = true">🗑 Clear this database</button>
                        }
                    </div>
                }
                else if (SelectedStore is { } activeStore)
                {
                    <div class="diag-store-header">
                        <div class="diag-store-name">@activeStore.Name (@activeStore.RecordCount records)</div>
                        <div class="diag-store-purpose">@activeStore.Purpose</div>
                    </div>

                    <div class="diag-filter-bar">
                        <input type="text" class="diag-search-input" placeholder="Search records..."
                               @bind="_searchFilter" @bind:event="oninput" aria-label="Search store records" />
                        <button class="diag-btn" @onclick="ToggleRawJsonView">
                            <span>@(_showRawJson ? "📊 Table View" : "📄 Raw JSON")</span>
                        </button>
                    </div>

                    @if (_showRawJson)
                    {
                        <pre class="diag-json-viewer">@activeStore.FormattedJson</pre>
                    }
                    else if (activeStore.Kind == HackStorageStoreKind.FileEntries)
                    {
                        <div class="diag-table-wrapper">
                            <table class="diag-table">
                                <thead>
                                    <tr>
                                        <th>Resolved Virtual Path</th>
                                        <th>Entry ID</th>
                                        <th>Kind</th>
                                        <th>Owner ID</th>
                                        <th>Content Hash</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in FilteredFsEntries(activeStore))
                                    {
                                        <tr>
                                            <td class="diag-path-highlight">@entry.Path</td>
                                            <td><code>@entry.Id</code></td>
                                            <td>@entry.Kind</td>
                                            <td>@entry.OwnerId</td>
                                            <td><code>@(entry.ContentHash ?? "-")</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (activeStore.Kind == HackStorageStoreKind.FileLinks)
                    {
                        <div class="diag-table-wrapper">
                            <table class="diag-table">
                                <thead>
                                    <tr>
                                        <th>Parent Directory ID</th>
                                        <th>Child Name</th>
                                        <th>Child Entry ID</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var link in FilteredFsLinks(activeStore))
                                    {
                                        <tr>
                                            <td><code>@link.ParentId</code></td>
                                            <td class="diag-path-highlight">@link.Name</td>
                                            <td><code>@link.EntryId</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="diag-table-wrapper">
                            <pre class="diag-json-viewer">@FilteredJson(activeStore)</pre>
                        </div>
                    }
                }
            </main>
        }
    </div>

    @if (_toastMessage is not null)
    {
        <div class="diag-toast" role="status">@_toastMessage</div>
    }
</div>
