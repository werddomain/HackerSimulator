@namespace HackerOs.Apps.SystemMonitor.Tabs
@inherits HackComponentBase

<div class="svc">
    <div class="svc-toolbar">
        <span class="sysmon-muted">@_services.Count service(s) installed</span>
        <button class="sysmon-btn" @onclick="LoadAsync" disabled="@_busy">Reload</button>
    </div>

    @if (_message is not null)
    {
        <div class="svc-message" role="alert">
            <span>@_message</span>
            <button class="sysmon-btn sysmon-btn-ghost" @onclick="() => _message = null" aria-label="Dismiss">&#x2715;</button>
        </div>
    }

    <div class="svc-table-wrapper">
        <table class="sysmon-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th class="num">PID</th>
                    <th>Status</th>
                    <th>Health</th>
                    <th>Start type</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (HackServiceController service in _services)
                {
                    HackServiceController current = service;
                    HackServiceActiveState state = LiveState(current);
                    <tr class="@(state == HackServiceActiveState.Failed ? "svc-row-failed" : null)">
                        <td>
                            <span class="svc-name">@current.DisplayName</span>
                            <span class="svc-id">@current.ServiceName</span>
                        </td>
                        <td class="num mono">@(LivePid(current)?.ToString() ?? "—")</td>
                        <td>
                            <span class="svc-status svc-@state" title="@StateTitle(current, state)">@StateText(current, state)</span>
                        </td>
                        <td>
                            @if (state is HackServiceActiveState.Active or HackServiceActiveState.Activating or HackServiceActiveState.Deactivating || current.StatusText is not null)
                            {
                                <span class="svc-health svc-health-@current.Health">@HealthText(current.Health)</span>
                                @if (current.StatusText is { Length: > 0 } text)
                                {
                                    <span class="svc-status-text">@text</span>
                                }
                            }
                            else
                            {
                                <span class="sysmon-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (current.StartType is { } startType)
                            {
                                <select class="svc-select" value="@startType" disabled="@_busy" aria-label="@($"Start type of {current.DisplayName}")"
                                        @onchange="e => SetStartTypeAsync(current, e.Value)">
                                    @foreach (ServiceStartMode mode in Enum.GetValues<ServiceStartMode>())
                                    {
                                        <option value="@mode">@mode</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <span class="sysmon-muted" title="Reading another app's start type needs services.manage">unknown</span>
                            }
                        </td>
                        <td class="svc-actions">
                            @if (state is HackServiceActiveState.Active or HackServiceActiveState.Activating)
                            {
                                <button class="sysmon-btn btn-danger" disabled="@_busy" @onclick='() => RunAsync(current, current.StopAsync, "stop")'>Stop</button>
                            }
                            else
                            {
                                @if (state == HackServiceActiveState.Failed)
                                {
                                    <button class="sysmon-btn sysmon-btn-ghost" disabled="@_busy" title="Forget the failure (systemctl reset-failed)"
                                            @onclick='() => RunAsync(current, current.ResetFailedAsync, "reset")'>Reset</button>
                                }
                                <button class="sysmon-btn" disabled="@(_busy || current.StartType == ServiceStartMode.Disabled)"
                                        @onclick='() => RunAsync(current, current.StartAsync, "start")'>Start</button>
                            }
                        </td>
                    </tr>
                }
                @if (_services.Count == 0 && !_busy)
                {
                    <tr class="svc-empty"><td colspan="6">No service installed.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
