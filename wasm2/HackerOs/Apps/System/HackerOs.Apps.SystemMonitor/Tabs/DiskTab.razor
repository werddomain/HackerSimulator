@namespace HackerOs.Apps.SystemMonitor.Tabs

<div class="disk">
    <section>
        <h3>Space <span class="sysmon-source">HackDriveInfo</span></h3>
        @if (Drives.Count == 0)
        {
            <p class="sysmon-muted">No drive reported.</p>
        }
        <div class="disk-drives">
            @foreach (HackDriveInfo drive in Drives)
            {
                long used = Math.Max(0, drive.TotalSize - drive.AvailableFreeSpace);
                double percent = drive.TotalSize <= 0 ? 0 : used * 100d / drive.TotalSize;
                <div class="sysmon-card disk-drive">
                    <div class="disk-drive-header">
                        <span class="disk-drive-name">@drive.Name</span>
                        <span class="disk-drive-format">@drive.VolumeLabel · @drive.DriveFormat</span>
                    </div>
                    <svg class="disk-bar" viewBox="0 0 100 6" preserveAspectRatio="none" role="img" aria-label="@($"{Units.Percent(percent)} used")">
                        <rect class="disk-bar-track" x="0" y="0" width="100" height="6" />
                        <rect class="disk-bar-fill @(percent >= 90 ? "critical" : percent >= 75 ? "warning" : null)" x="0" y="0" width="@BarWidth(percent)" height="6" />
                    </svg>
                    <div class="disk-drive-numbers">
                        <span>@Units.Bytes(used) used (@Units.Percent(percent))</span>
                        <span>@Units.Bytes(drive.AvailableFreeSpace) free of @Units.Bytes(drive.TotalSize)</span>
                    </div>
                </div>
            }
        </div>
    </section>

    @foreach (DiskActivity disk in Metrics.Disks)
    {
        <section>
            <h3>Activity of @disk.Name <span class="sysmon-source">/proc/diskstats</span></h3>
            <div class="disk-activity">
                <HackLineChart Title="@($"{disk.Name} throughput")"
                               Series="@([new HackChartSeries("Read", disk.ReadPerSecond.Values), new HackChartSeries("Write", disk.WritePerSecond.Values)])"
                               MinimumScale="4096"
                               Size="HackChartSize.Large"
                               ValueFormatter="Units.Rate" />
                <HackLineChart Title="Active time"
                               Series="@([new HackChartSeries("Busy", disk.BusyPercent.Values)])"
                               Maximum="100"
                               Filled="true"
                               ValueFormatter="Units.Percent" />
            </div>
            @if (disk.Counters is { } counters)
            {
                <table class="sysmon-table disk-counters">
                    <thead>
                        <tr><th></th><th class="num">Requests</th><th class="num">Bytes</th><th class="num">Time</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Reads</td><td class="num">@Units.Count(counters.ReadsCompleted)</td><td class="num">@Units.Bytes(counters.BytesRead)</td><td class="num">@Units.Count(counters.MillisecondsReading) ms</td></tr>
                        <tr><td>Writes</td><td class="num">@Units.Count(counters.WritesCompleted)</td><td class="num">@Units.Bytes(counters.BytesWritten)</td><td class="num">@Units.Count(counters.MillisecondsWriting) ms</td></tr>
                        <tr><td>In flight</td><td class="num">@counters.IosInProgress</td><td class="num">—</td><td class="num">@Units.Count(counters.MillisecondsDoingIo) ms busy</td></tr>
                    </tbody>
                </table>
            }
        </section>
    }

    @if (Metrics.Disks.Count == 0)
    {
        <p class="sysmon-muted">/proc/diskstats lists no disk.</p>
    }
</div>
