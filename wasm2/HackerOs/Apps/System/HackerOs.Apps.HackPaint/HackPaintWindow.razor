@using HackerOs.AppSdk.Blazor
@using Microsoft.AspNetCore.Components.Web
@inherits WindowAppBase
@implements IAsyncDisposable
@implements IWindowCloseGuard

<div class="paint-root" @ref="_root" tabindex="-1" @onkeydown="HandleKeyDownAsync">
    <header class="paint-titlebar">
        <span class="paint-title" id="paint-title">@WindowTitle</span>
        @if (_busyMessage is not null)
        {
            <span class="paint-busy" role="status">@_busyMessage</span>
        }
    </header>
    <div class="paint-toolbar" role="toolbar" aria-label="Hack Paint tools">
        <div class="tool-group" aria-label="File">
            <button id="paint-btn-new" class="paint-btn" title="New (Ctrl+N)" disabled="@IsBusy" @onclick="NewDocumentAsync">New</button>
            <button id="paint-btn-open" class="paint-btn" title="Open (Ctrl+O)" disabled="@IsBusy" @onclick="OpenAsync">Open…</button>
            <button id="paint-btn-save" class="paint-btn" title="Save (Ctrl+S)" disabled="@IsBusy" @onclick="SaveAsync">Save</button>
            <button id="paint-btn-save-as" class="paint-btn" title="Save As (Ctrl+Shift+S)" disabled="@IsBusy" @onclick="SaveAsAsync">Save As…</button>
            <label for="paint-jpeg-quality" class="tool-label">JPEG quality:</label>
            <input id="paint-jpeg-quality" type="number" class="quality-input" min="10" max="100" step="5" @bind="JpegQuality" />
        </div>
        <div class="tool-group" aria-label="History">
            <button id="paint-btn-undo" class="paint-btn" title="Undo (Ctrl+Z)" disabled="@(!_state.CanUndo || IsBusy)" @onclick="UndoAsync">Undo</button>
            <button id="paint-btn-redo" class="paint-btn" title="Redo (Ctrl+Y)" disabled="@(!_state.CanRedo || IsBusy)" @onclick="RedoAsync">Redo</button>
        </div>
        <div class="tool-group" aria-label="Image">
            <button id="paint-btn-rotate" class="paint-btn" disabled="@IsBusy" @onclick="RotateAsync">Rotate 90&deg;</button>
            <button id="paint-btn-grid" class="paint-btn @(_state.ShowGrid ? "active" : "")" aria-pressed="@(_state.ShowGrid ? "true" : "false")" @onclick="ToggleGridAsync">Grid</button>
            <button id="paint-btn-crop" class="paint-btn @(_state.CropMode ? "active" : "")" aria-pressed="@(_state.CropMode ? "true" : "false")" @onclick="ToggleCrop">Crop</button>
            <button id="paint-btn-pan" class="paint-btn @(_state.PanMode ? "active" : "")" aria-pressed="@(_state.PanMode ? "true" : "false")" @onclick="TogglePan">Pan</button>
        </div>
        <div class="tool-group" aria-label="Zoom">
            <button class="paint-btn" @onclick="ZoomIn">Zoom +</button><button class="paint-btn" @onclick="ZoomOut">Zoom -</button>
            <span class="zoom-label">@((int)(_state.Scale * 100))%</span>
        </div>
        <div class="tool-group" aria-label="Brush">
            <label for="paint-color" class="tool-label">Color:</label><input id="paint-color" type="color" class="color-picker" @bind="_state.ActiveColor" />
            <label for="paint-size" class="tool-label">Size:</label><input id="paint-size" type="range" class="size-range" min="1" max="50" @bind="_state.BrushSize" />
            <span class="size-label">@_state.BrushSize px</span>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="paint-error" role="alert">
            <span>@_error</span>
            <button class="paint-btn" @onclick="DismissError">Dismiss</button>
        </div>
    }
    <div class="paint-viewport @(_state.ShowGrid ? "grid-overlay" : "")" tabindex="0" aria-label="Canvas viewport">
        <div class="canvas-frame">
            <canvas @ref="_canvas" class="paint-canvas" width="@_state.Width" height="@_state.Height" aria-label="Hack Paint drawing canvas"
                    @onpointerdown="StartDrawAsync" @onpointermove="DrawAsync" @onpointerup="StopDrawAsync" @onpointercancel="StopDrawAsync"></canvas>
        </div>
    </div>
    <div class="paint-statusbar">
        <span>Canvas: @_state.Width &times; @_state.Height px</span>
        <span>Tool: @(_state.CropMode ? "Crop" : _state.PanMode ? "Pan" : "Brush")</span>
        <span id="paint-path">@(_path?.Value ?? "Not saved")</span>
    </div>
</div>
