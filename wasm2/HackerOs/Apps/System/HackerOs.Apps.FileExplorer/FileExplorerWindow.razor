@using HackerOs.App.Abstractions
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.FileView
@using HackerOs.AppSdk.FileView.ContextMenu
@using HackerOs.AppSdk.FileView.Events
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Apps
@using HackerOs.Simulation.Abstractions.Gateways
@using HackerOs.Simulation.Abstractions.Events
@using HackerOs.Simulation.Abstractions.FileSystem
@using HackerOs.AppSdk.Blazor.Interop
@using HackerOs.AppSdk.Icons
@using HackerOs.AppSdk.IO
@using HackerOs.AppSdk.Clipboard
@using HackerOs.AppSdk.FileView.Transfers
@using HackerOs.Simulation.Abstractions.Notifications
@using System.IO.Compression
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@inherits WindowAppBase
@implements IAsyncDisposable
@inject MudBlazor.IDialogService MudDialogService
@inject IJSRuntime JSRuntime

@*
    Hosts FileView (Shared/HackerOs.AppSdk.FileView) for listing/selection/rename/drag-drop/context-menu —
    this window keeps only the chrome FileView deliberately doesn't own: toolbar, address bar, search box,
    view-mode toggle, the "Places" sidebar with the Trash view (TrashView, ADR 0052), and the
    OpenWithDialog/FilePropertiesDialog modals (ADR 0037, INT-001/INT-002).
    FileView exposes no public Create/Delete methods (only its own internal context-menu wires those), so
    the toolbar's New Folder/New File/Delete/Compress/Extract actions call AppContext.FileSystem directly —
    the same raw gateway calls FileView's own internal handlers make, just from this assembly instead of
    that one — then refresh FileView. Deletion is the exception: FileView hands its Delete key, Shift+Delete
    and menu entries to OnDeleteRequestedAsync, which moves the items to the trash (HackTrash) or, after a
    confirmation, deletes them permanently (ADR 0052, section 5). Rename/Properties/Open With instead go through FileView's public
    FileViewItem/SelectedItem surface directly, with zero duplicated logic.
    Cut/copy/paste (ADR 0058, section 1) go through the session clipboard (HackClipboard, gnome-copied-files), so
    another window can paste; FileView hands its Ctrl+X/C/V and menu entries to OnClipboardRequestedAsync and every
    drop (folder, background, tree, breadcrumb, Places, Trash, host files) to OnDropRequestedAsync. Transfers run
    through FileTransfer (Nautilus naming, Replace/Keep both/Skip window, per-item failure summary).
*@
<div class="file-explorer-container">
    <!-- Navigation & Address Toolbar -->
    <div class="explorer-toolbar">
        <div class="nav-buttons">
            <button class="nav-btn" disabled="@(!_state.CanNavigateBack)" @onclick="NavigateBackAsync" title="Back">
                <HackerIcon Library="IconLibrary.Lucide" Name="arrow-left" Size="16" />
            </button>
            <button class="nav-btn" disabled="@(!_state.CanNavigateForward)" @onclick="NavigateForwardAsync" title="Forward">
                <HackerIcon Library="IconLibrary.Lucide" Name="arrow-right" Size="16" />
            </button>
            <button class="nav-btn" disabled="@(!_state.CanNavigateUp)" @onclick="NavigateUpAsync" title="Up">
                <HackerIcon Library="IconLibrary.Lucide" Name="arrow-up" Size="16" />
            </button>
            <button class="nav-btn" @onclick="RefreshAsync" title="Refresh">
                <HackerIcon Library="IconLibrary.Lucide" Name="refresh-cw" Size="16" />
            </button>
            <button class="nav-btn" @onclick="NavigateHomeAsync" title="Home">
                <HackerIcon Library="IconLibrary.Lucide" Name="house" Size="16" />
            </button>
        </div>

        <div class="address-bar">
            <input type="text" class="address-input" @bind="_addressInput" @bind:event="oninput" @onkeydown="HandleAddressKeyDownAsync" aria-label="Current path address" />
        </div>

        <div class="search-box">
            <input type="text" class="search-input" placeholder="Search..." @bind="_state.SearchQuery" @bind:event="oninput" @bind:after="OnSearchQueryChanged" aria-label="Search directory" />
        </div>

        <div class="view-toggle">
            <button class="view-btn @(_state.ViewMode == FileViewMode.Details ? "active" : "")" @onclick="() => SetViewMode(FileViewMode.Details)" title="Details View">
                <HackerIcon Library="IconLibrary.Lucide" Name="list" Size="16" />
            </button>
            <button class="view-btn @(_state.ViewMode == FileViewMode.Icons ? "active" : "")" @onclick="() => SetViewMode(FileViewMode.Icons)" title="Icons View">
                <HackerIcon Library="IconLibrary.Lucide" Name="layout-grid" Size="16" />
            </button>
            <button class="view-btn @(_state.ViewMode == FileViewMode.Tree ? "active" : "")" @onclick="() => SetViewMode(FileViewMode.Tree)" title="Tree View">
                <HackerIcon Library="IconLibrary.Lucide" Name="list-tree" Size="16" />
            </button>
        </div>
    </div>

    <div class="explorer-body">
    <!-- Places sidebar -->
    <nav class="explorer-sidebar" aria-label="Places">
        <div class="sidebar-heading">Places</div>
        @if (_fileView is not null)
        {
            <FileViewDropZone Owner="_fileView" Destination="_homeDirectory">
                <button class="sidebar-entry @(!_showTrash && _state.CurrentPath == GetHomePath() ? "active" : "")" @onclick="NavigateHomeAsync" title="Home">
                    <HackerIcon Library="IconLibrary.Lucide" Name="house" Size="16" /> <span>Home</span>
                </button>
            </FileViewDropZone>
            <FileViewDropZone Owner="_fileView" Dropped="OnTrashDropAsync">
                <button class="sidebar-entry @(_showTrash ? "active" : "")" @onclick="ShowTrashAsync" title="Trash (drop here to delete)">
                    <HackerIcon Library="IconLibrary.Lucide" Name="trash-2" Size="16" /> <span>Trash</span>
                </button>
            </FileViewDropZone>
        }
    </nav>

    <div class="explorer-main">
    @if (_showTrash && _fileView is not null)
    {
        <FileViewDropZone Owner="_fileView" Dropped="OnTrashDropAsync" Class="explorer-trash-drop">
            <TrashView @ref="_trashView" Restored="OnTrashRestoredAsync" />
        </FileViewDropZone>
    }

    <div class="explorer-files @(_showTrash ? "hidden" : "")">
    @if (_fileView is not null)
    {
        <div class="explorer-locationbar">
            <FileViewBreadcrumb Owner="_fileView" RootLabel="Computer" />
        </div>
    }

    <!-- Actions Toolbar -->
    <div class="actions-toolbar">
        <button class="action-btn" @onclick="CreateFolderAsync" title="New Folder">
            <HackerIcon Library="IconLibrary.Lucide" Name="folder-plus" Size="16" /> <span>New Folder</span>
        </button>
        <button class="action-btn" @onclick="CreateFileAsync" title="New File">
            <HackerIcon Library="IconLibrary.Lucide" Name="file-plus" Size="16" /> <span>New File</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount != 1)" @onclick="RenameSelected" title="Rename">
            <HackerIcon Library="IconLibrary.Lucide" Name="pencil" Size="16" /> <span>Rename</span>
        </button>
        <button class="action-btn danger" disabled="@(SelectedCount == 0)" @onclick="DeleteSelectedAsync" title="Move to Trash (Del)">
            <HackerIcon Library="IconLibrary.Lucide" Name="trash-2" Size="16" /> <span>Delete</span>
        </button>
        <span class="toolbar-divider"></span>

        <button class="action-btn" disabled="@(SelectedCount == 0)" @onclick="CutSelectedAsync" title="Cut (Ctrl+X)">
            <HackerIcon Library="IconLibrary.Lucide" Name="scissors" Size="16" /> <span>Cut</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount == 0)" @onclick="CopySelectedAsync" title="Copy (Ctrl+C)">
            <HackerIcon Library="IconLibrary.Lucide" Name="copy" Size="16" /> <span>Copy</span>
        </button>
        <button class="action-btn" disabled="@(!_canPaste)" @onclick="PasteHereAsync" title="Paste (Ctrl+V)">
            <HackerIcon Library="IconLibrary.Lucide" Name="clipboard-paste" Size="16" /> <span>Paste</span>
        </button>

        <span class="toolbar-divider"></span>

        <button class="action-btn" disabled="@(SelectedCount != 1)" @onclick="ShowPropertiesAsync" title="Properties">
            <HackerIcon Library="IconLibrary.Lucide" Name="info" Size="16" /> <span>Properties</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount != 1)" @onclick="OpenWithAsync" title="Open With...">
            <HackerIcon Library="IconLibrary.Lucide" Name="external-link" Size="16" /> <span>Open With...</span>
        </button>

        <span class="toolbar-divider"></span>

        <InputFile id="fileInput" OnChange="UploadFilesAsync" multiple hidden />
        <label for="fileInput" class="action-btn" title="Upload">
            <HackerIcon Library="IconLibrary.Lucide" Name="upload" Size="16" /> <span>Upload</span>
        </label>
        <button class="action-btn" disabled="@(SelectedCount == 0)" @onclick="DownloadSelectedAsync" title="Download">
            <HackerIcon Library="IconLibrary.Lucide" Name="download" Size="16" /> <span>Download</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount == 0)" @onclick="CompressSelectedAsync" title="Compress to Zip">
            <HackerIcon Library="IconLibrary.Lucide" Name="archive" Size="16" /> <span>Compress</span>
        </button>
        <button class="action-btn" disabled="@(!CanExtractSelection)" @onclick="ExtractSelectedAsync" title="Extract Zip">
            <HackerIcon Library="IconLibrary.Lucide" Name="package-open" Size="16" /> <span>Extract</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-state">@_errorMessage</div>
    }
    else if (_fileView is not null && _fileView.Items.Count == 0)
    {
        <div class="empty-state">This directory is empty.</div>
    }

    <!-- Directory Content View -->
    <div class="explorer-content">
        <FileView @ref="_fileView"
                  FileSystem="AppContext.FileSystem"
                  Watch="AppContext.Watch"
                  Intents="AppContext.Intents"
                  InitialDirectory="_initialDirectory"
                  @bind-Mode="_state.ViewMode"
                  Filter="_searchFilter"
                  ContextMenuProviders="_contextMenuProviders"
                  DeleteRequested="OnDeleteRequestedAsync"
                  DropRequested="OnDropRequestedAsync"
                  ClipboardRequested="OnClipboardRequestedAsync"
                  CanPaste="_canPaste"
                  CutPaths="_cutPaths"
                  OwnerAppId="Manifest.Id" />
    </div>

    <!-- Status Bar -->
    <div class="explorer-statusbar">
        <span>@(_fileView?.Items.Count ?? 0) item(s)</span>
        @if (SelectedCount > 0)
        {
            <span> | @SelectedCount selected</span>
        }
    </div>
    </div>
    </div>
    </div>

</div>

@code {
    private FileExplorerState _state = default!;
    private FileView? _fileView;
    private VirtualPath _initialDirectory;
    private string _addressInput = string.Empty;
    private string? _errorMessage;
    private IDisposable? _eventSub;
    private BrowserFileDownloader? _downloader;
    private Func<FileViewItem, bool> _searchFilter = default!;
    private IReadOnlyList<IFileViewContextMenuProvider> _contextMenuProviders = [];
    private bool _subscribedToFileView;
    private bool _showTrash;
    private TrashView? _trashView;
    private VirtualPath _homeDirectory;
    private bool _canPaste;
    private IReadOnlyCollection<string> _cutPaths = [];
    private bool _subscribedToClipboard;

    private int SelectedCount => _fileView?.SelectedItems.Count ?? 0;

    private bool CanExtractSelection =>
        _fileView?.SelectedItem is { IsDirectory: false } item
        && _fileView.SelectedItems.Count == 1
        && item.FileName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase);

    private string GetHomePath() => HackUser.Describe(AppContext).HomeDirectory;

    /// <summary>Copies, moves, imports and trash moves in flight (ADR 0069).</summary>
    private readonly HashSet<Task> _operations = [];

    /// <summary>
    /// Records a file operation so a stop request can wait for it: each item moves atomically and
    /// <see cref="FileTransfer"/> stops between two when the process is asked to stop, so the window
    /// closes after the current item, with nothing half-copied and the rest reported as not done.
    /// </summary>
    private async Task<FileTransferResult> TrackOperation(Task<FileTransferResult> operation)
    {
        _operations.Add(operation);
        try
        {
            return await operation;
        }
        finally
        {
            _operations.Remove(operation);
        }
    }

    /// <inheritdoc />
    protected override Task OnAppStopRequestedAsync(HackStopRequestedEventArgs e) =>
        _operations.Count == 0 ? Task.CompletedTask : Task.WhenAll(_operations);

    protected override void OnAppInitialized()
    {
        base.OnAppInitialized();
        string homePath = GetHomePath();
        _homeDirectory = VirtualPath.Parse(homePath);
        // Opening a folder (inode/directory, ADR 0039) starts the explorer on it; "Show in folder"
        // adds --select=<path> (RevealFileIntent, ADR 0096 section 1).
        (VirtualPath? folder, VirtualPath? select) = ParseLaunchArguments(LaunchArguments);
        _pendingReveal = select;
        string startPath = (folder ?? _homeDirectory).Value;
        _state = new FileExplorerState(startPath);
        _initialDirectory = VirtualPath.Parse(startPath);
        _addressInput = startPath;
        _searchFilter = MatchesSearchQuery;
        _contextMenuProviders =
        [
            new ZipFileContextMenuProvider(AppContext.FileSystem, () => _fileView, ReportError),
            new PublishSiteContextMenuProvider(LaunchWithAsync)
        ];
        _eventSub = AppContext.Events.Subscribe<AppDisabledEvent>(evt =>
        {
            if (_fileView is not null)
            {
                InvokeAsync(() => _fileView.RefreshAsync());
            }
        });
    }

    protected override async Task OnAppInitializedAsync()
    {
        _downloader = new BrowserFileDownloader(JSRuntime);
        // Another window (or app) may cut or copy at any time: follow the session clipboard.
        AppContext.Clipboard.Changed += OnClipboardChanged;
        _subscribedToClipboard = true;
        await ReadClipboardStateAsync();
        await base.OnAppInitializedAsync();
    }

    protected override void OnAppAfterRender(bool firstRender)
    {
        base.OnAppAfterRender(firstRender);
        if (firstRender && _fileView is not null && !_subscribedToFileView)
        {
            _subscribedToFileView = true;
            _fileView.OnPathChange += OnFileViewPathChanged;
            _fileView.Opened += OnFileViewItemOpened;
            _fileView.SelectionChanged += OnFileViewSelectionChanged;
            // The breadcrumb and the Places drop zones need the view instance: render them now.
            StateHasChanged();
            if (_pendingReveal is { } reveal && _fileView.CurrentDirectory == ParentOf(reveal))
            {
                // The view already listed the folder: select the item now rather than on OnPathChange.
                _pendingReveal = null;
                _ = InvokeAsync(() => RevealAsync(reveal));
            }
        }
    }

    /// <summary>Item to select once the view lists its folder (<c>--select=</c>, ADR 0096 section 1).</summary>
    private VirtualPath? _pendingReveal;

    /// <summary>
    /// Reads the explorer's command line, like Nautilus's: a folder to open and <c>--select=&lt;path&gt;</c>
    /// for "Show in folder". A file given as the folder opens its parent and selects it; anything
    /// malformed is ignored (the explorer then opens the home folder).
    /// </summary>
    internal static (VirtualPath? Folder, VirtualPath? Select) ParseLaunchArguments(IReadOnlyList<string> arguments)
    {
        VirtualPath? folder = null;
        VirtualPath? select = null;
        foreach (string argument in arguments)
        {
            string value = argument.StartsWith(SelectPrefix, StringComparison.Ordinal) ? argument[SelectPrefix.Length..] : argument;
            if (!value.StartsWith('/'))
            {
                continue;
            }

            try
            {
                VirtualPath path = VirtualPath.Parse(value);
                if (argument.StartsWith(SelectPrefix, StringComparison.Ordinal))
                {
                    select = path;
                }
                else
                {
                    folder ??= path;
                }
            }
            catch (FormatException)
            {
            }
        }

        return (select is { } item && folder is null ? ParentOf(item) : folder, select);
    }

    private const string SelectPrefix = "--select=";

    private static VirtualPath ParentOf(VirtualPath path)
    {
        int separator = path.Value.LastIndexOf('/');
        return separator <= 0 ? VirtualPath.Parse("/") : VirtualPath.Parse(path.Value[..separator]);
    }

    private async Task RevealAsync(VirtualPath path)
    {
        if (_fileView is null)
        {
            return;
        }

        try
        {
            if (!await _fileView.RevealAsync(path))
            {
                ReportError($"'{path.Value}' is no longer in this folder.");
            }
        }
        catch (InvalidOperationException exception)
        {
            ReportError(exception.Message);
        }
    }

    private void OnFileViewSelectionChanged(object? sender, FileViewSelectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private bool MatchesSearchQuery(FileViewItem item) =>
        string.IsNullOrWhiteSpace(_state.SearchQuery) ||
        item.FileName.Contains(_state.SearchQuery, StringComparison.OrdinalIgnoreCase);

    private void OnSearchQueryChanged() => _fileView?.RefreshFilter();

    private void ReportError(string message)
    {
        _errorMessage = message;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnFileViewPathChanged(object? sender, FileViewPathChangedEventArgs e)
    {
        _showTrash = false;
        _state.NavigateTo(e.Path.Value);
        _addressInput = _state.CurrentPath;
        _errorMessage = null;
        _ = InvokeAsync(StateHasChanged);
        if (_pendingReveal is { } reveal && e.Path == ParentOf(reveal))
        {
            _pendingReveal = null;
            _ = InvokeAsync(() => RevealAsync(reveal));
        }
    }

    private async void OnFileViewItemOpened(object? sender, FileViewOpenedEventArgs e)
    {
        if (!e.Item.IsDirectory)
        {
            await LaunchFileIntentAsync(e.Item.FullPath.Value);
        }
    }

    private async Task NavigateFileViewAsync(string path)
    {
        _showTrash = false;
        if (_fileView is null) return;

        try
        {
            await _fileView.NavigateAsync(VirtualPath.Parse(path));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private Task NavigateBackAsync()
    {
        _state.NavigateBack();
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task NavigateForwardAsync()
    {
        _state.NavigateForward();
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task NavigateUpAsync()
    {
        _state.NavigateUp();
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task NavigateHomeAsync()
    {
        _state.NavigateTo(GetHomePath());
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task RefreshAsync() => _fileView?.RefreshAsync() ?? Task.CompletedTask;

    private async Task HandleAddressKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _state.NavigateTo(_addressInput);
            await NavigateFileViewAsync(_state.CurrentPath);
        }
    }

    private void SetViewMode(FileViewMode mode)
    {
        _state.ViewMode = mode;
        StateHasChanged();
    }

    private async Task LaunchFileIntentAsync(string fullPath)
    {
        AppIntentOpenFileResult result;
        try
        {
            result = await AppContext.Intents.OpenFileAsync(VirtualPath.Parse(fullPath));
        }
        catch (AppGatewayAccessDeniedException)
        {
            ReportError("You don't have permission to open files.");
            return;
        }

        switch (result.Outcome)
        {
            case AppIntentOpenFileOutcome.Opened:
                break;
            case AppIntentOpenFileOutcome.ChooserRequired:
                await ShowOpenWithChooserAsync(fullPath, result.CandidateAppIds ?? []);
                break;
            case AppIntentOpenFileOutcome.NoHandler:
                ReportError("No application is registered to open this file.");
                break;
            default:
                ReportError($"Could not open file: {result.ErrorCode}");
                break;
        }
    }

    private async Task ShowOpenWithChooserAsync(string fullPath, IReadOnlyList<string> candidateAppIds)
    {
        IReadOnlyList<HackAppInfo> installed = await AppContext.Catalog.GetInstalledAsync(AppContext.CancellationToken);
        IReadOnlyList<HackAppInfo> candidates = installed
            .Where(app => candidateAppIds.Contains(app.Id, StringComparer.Ordinal))
            .ToList();

        DialogParameters parameters = new()
        {
            { nameof(OpenWithDialog.OwnerAppContext), AppContext },
            { nameof(OpenWithDialog.FilePath), fullPath },
            { nameof(OpenWithDialog.AvailableApps), candidates }
        };

        IDialogReference dialog = await MudDialogService.ShowAsync<OpenWithDialog>("Open With", parameters);
        DialogResult? dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled && dialogResult.Data is HackAppInfo selectedApp)
        {
            await LaunchWithAsync(selectedApp.Id, fullPath);
        }
    }

    private async Task LaunchWithAsync(string appId, string fullPath)
    {
        try
        {
            await AppContext.Intents.LaunchAsync(appId, [fullPath]);
        }
        catch (AppGatewayAccessDeniedException)
        {
            ReportError("You don't have permission to launch applications.");
        }
    }

    private static VirtualPath CombineChild(VirtualPath parent, string name) =>
        VirtualPath.Parse(parent.Value == "/" ? $"/{name}" : $"{parent.Value}/{name}");

    private async Task CreateFolderAsync()
    {
        if (_fileView is null) return;

        TextInputDialogResult result = await base.TextInput(
            title: "New Folder",
            content: "Enter the name of the new folder:",
            defaultValue: "New Folder",
            placeholder: "Folder name...");

        if (result.Status != TextInputStatus.Submitted || string.IsNullOrWhiteSpace(result.Value)) return;

        string folderName = result.Value.Trim();
        VirtualPath fullPath = CombineChild(_fileView.CurrentDirectory, folderName);
        FileSystemMutationResult creation = await AppContext.FileSystem.CreateAsync(
            new FileSystemCreateRequest(fullPath, FileSystemEntryKind.Directory, FileSystemPermissions.FromMode(0b111_101_101)),
            AppContext.CancellationToken);

        if (creation.Succeeded)
        {
            _errorMessage = null;
            await _fileView.RefreshAsync();
        }
        else
        {
            ReportError(creation.Transaction.Error?.Code == FileSystemErrorCode.AlreadyExists
                ? $"'{folderName}' already exists."
                : "Could not create the folder.");
        }
    }

    private async Task CreateFileAsync()
    {
        if (_fileView is null) return;

        TextInputDialogResult result = await base.TextInput(
            title: "New File",
            content: "Enter the name of the new file:",
            defaultValue: "NewFile.txt",
            placeholder: "File name...");

        if (result.Status != TextInputStatus.Submitted || string.IsNullOrWhiteSpace(result.Value)) return;

        string fileName = result.Value.Trim();
        VirtualPath fullPath = CombineChild(_fileView.CurrentDirectory, fileName);
        FileSystemMutationResult creation = await AppContext.FileSystem.CreateAsync(
            new FileSystemCreateRequest(fullPath, FileSystemEntryKind.File, FileSystemPermissions.FromMode(0b110_100_100)),
            AppContext.CancellationToken);

        if (creation.Succeeded)
        {
            _errorMessage = null;
            await _fileView.RefreshAsync();
        }
        else
        {
            ReportError(creation.Transaction.Error?.Code == FileSystemErrorCode.AlreadyExists
                ? $"'{fileName}' already exists."
                : "Could not create the file.");
        }
    }

    /// <summary>Uses FileView's own inline rename (label ↔ textbox swap) — no modal dialog, unlike every other action here.</summary>
    private void RenameSelected() => _fileView?.SelectedItem?.Rename();

    /// <summary>Toolbar "Delete": moves the selection to the trash, without confirmation (it is reversible).</summary>
    private Task DeleteSelectedAsync() =>
        _fileView is null || _fileView.SelectedItems.Count == 0
            ? Task.CompletedTask
            : DeleteItemsAsync(_fileView.SelectedItems.ToList(), permanent: false);

    /// <summary>FileView's Delete key, Shift+Delete and context-menu entries (ADR 0052, section 5).</summary>
    private Task OnDeleteRequestedAsync(FileViewDeleteRequestedEventArgs e) => DeleteItemsAsync(e.Items, e.Permanent);

    /// <summary>
    /// Moves <paramref name="items"/> to the trash, or — for Shift+Delete / "Delete permanently" and only
    /// after a confirmation — deletes them for good. Runs as this app (ambient scope of the event handler),
    /// so the usual file permissions and capabilities apply.
    /// </summary>
    private async Task DeleteItemsAsync(IReadOnlyList<FileViewItem> items, bool permanent)
    {
        if (_fileView is null || items.Count == 0) return;

        if (permanent)
        {
            string question = items.Count == 1
                ? $"Permanently delete '{items[0].FileName}'? This cannot be undone."
                : $"Permanently delete these {items.Count} items? This cannot be undone.";
            MessageBoxDialogResult answer = await base.MessageBox("Delete permanently", question, MessageBoxType.YesNo);
            if (answer.Result != MessageBoxResult.Yes) return;
        }

        List<string> failures = [];
        foreach (FileViewItem item in items)
        {
            try
            {
                if (!permanent)
                {
                    await HackTrash.MoveToTrashAsync(item.FullPath.Value, AppContext.CancellationToken);
                }
                else if (item.Metadata.Kind == FileSystemEntryKind.Directory)
                {
                    await HackDirectory.DeleteAsync(item.FullPath.Value, recursive: true, AppContext.CancellationToken);
                }
                else
                {
                    await HackFile.DeleteAsync(item.FullPath.Value, AppContext.CancellationToken);
                }
            }
            catch (UnauthorizedAccessException)
            {
                failures.Add($"'{item.FileName}': permission denied");
            }
            catch (IOException ex)
            {
                failures.Add($"'{item.FileName}': {ex.Message}");
            }
        }

        _errorMessage = failures.Count == 0 ? null : "Could not delete " + string.Join("; ", failures);
        _fileView.ClearSelect();
        await _fileView.RefreshAsync();
    }

    // ---- Clipboard (ADR 0056 section 12, ADR 0058 section 1) ----------------------------------------

    private Task CutSelectedAsync() => PutSelectionOnClipboardAsync(HackClipboardFileOperation.Cut);

    private Task CopySelectedAsync() => PutSelectionOnClipboardAsync(HackClipboardFileOperation.Copy);

    private Task PasteHereAsync() =>
        _fileView is null ? Task.CompletedTask : PasteIntoAsync(_fileView.CurrentDirectory);

    /// <summary>FileView's Ctrl+X/C/V and its Cut/Copy/Paste/Paste Into Folder menu entries.</summary>
    private Task OnClipboardRequestedAsync(FileViewClipboardRequestedEventArgs e) => e.Action switch
    {
        FileViewClipboardAction.Cut => PutOnClipboardAsync(e.Items, HackClipboardFileOperation.Cut),
        FileViewClipboardAction.Copy => PutOnClipboardAsync(e.Items, HackClipboardFileOperation.Copy),
        _ => PasteIntoAsync(e.Destination)
    };

    private Task PutSelectionOnClipboardAsync(HackClipboardFileOperation operation) =>
        _fileView is null ? Task.CompletedTask : PutOnClipboardAsync(_fileView.SelectedItems, operation);

    /// <summary>Cut or copy: writes the paths to the session clipboard. Nothing moves before the paste.</summary>
    private async Task PutOnClipboardAsync(IReadOnlyList<FileViewItem> items, HackClipboardFileOperation operation)
    {
        if (items.Count == 0) return;

        try
        {
            await HackClipboard.SetFileDropListAsync(items.Select(item => item.FullPath.Value), operation, AppContext.CancellationToken);
            _errorMessage = null;
        }
        catch (UnauthorizedAccessException)
        {
            ReportError("You don't have permission to use the clipboard.");
        }
    }

    /// <summary>
    /// Paste: copies (or, for cut files, moves) the clipboard's files into <paramref name="destination"/>.
    /// After a cut, the clipboard is emptied once every file was moved.
    /// </summary>
    private async Task PasteIntoAsync(VirtualPath destination)
    {
        HackClipboardFileList? list;
        try
        {
            list = await HackClipboard.GetFileDropListAsync(AppContext.CancellationToken);
        }
        catch (UnauthorizedAccessException)
        {
            ReportError("You don't have permission to use the clipboard.");
            return;
        }

        if (list is null || list.Paths.Count == 0) return;

        bool cut = list.Operation == HackClipboardFileOperation.Cut;
        FileTransferResult result = await TrackOperation(FileTransfer.TransferAsync(
            list.Paths,
            destination.Value,
            cut ? FileTransferMode.Move : FileTransferMode.Copy,
            AskConflictAsync,
            AppContext.CancellationToken));

        if (cut && result.Succeeded)
        {
            await HackClipboard.ClearAsync(AppContext.CancellationToken);
        }

        ReportTransfer(result, cut ? "move" : "copy");
        await RefreshAfterTransferAsync();
    }

    private void OnClipboardChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            await ReadClipboardStateAsync();
            StateHasChanged();
        });

    /// <summary>Reads whether there is something to paste and which items to dim as cut.</summary>
    private async Task ReadClipboardStateAsync()
    {
        try
        {
            HackClipboardFileList? list = await AppContext.Clipboard.GetFileDropListAsync(AppContext.CancellationToken);
            _canPaste = list is { Paths.Count: > 0 };
            _cutPaths = list is { Operation: HackClipboardFileOperation.Cut }
                ? new HashSet<string>(list.Paths, StringComparer.Ordinal)
                : [];
        }
        catch (Exception exception) when (exception is AppGatewayAccessDeniedException or NotSupportedException)
        {
            _canPaste = false;
            _cutPaths = [];
        }
    }

    // ---- Drag and drop (ADR 0058 section 1) ---------------------------------------------------------

    /// <summary>
    /// Every drop FileView hands over: HackerOS entries are moved (copied with Ctrl), with the conflict
    /// window; files from the host system are imported. One summary covers both.
    /// </summary>
    private async Task OnDropRequestedAsync(FileViewDropRequestedEventArgs e)
    {
        if (e.Destination is not { } destination) return;

        List<FileTransferItemResult> completed = [];
        List<string> skipped = [];
        List<FileTransferFailure> failures = [];

        if (e.Entries.Count > 0)
        {
            FileTransferResult moved = await TrackOperation(FileTransfer.TransferAsync(
                e.Entries.Select(entry => entry.Path.Value).ToList(),
                destination.Value,
                e.Copy ? FileTransferMode.Copy : FileTransferMode.Move,
                AskConflictAsync,
                AppContext.CancellationToken));
            completed.AddRange(moved.Completed);
            skipped.AddRange(moved.Skipped);
            failures.AddRange(moved.Failures);
        }

        if (e.HostFiles.Count > 0)
        {
            FileTransferResult imported = await TrackOperation(FileTransfer.ImportAsync(e.HostFiles, destination.Value, AppContext.CancellationToken));
            completed.AddRange(imported.Completed);
            failures.AddRange(imported.Failures);
        }

        ReportTransfer(new FileTransferResult(completed, skipped, failures), e.Copy || e.Entries.Count == 0 ? "copy" : "move");
        await RefreshAfterTransferAsync();
    }

    /// <summary>A drop on the Trash place or view: moves the dragged entries to the trash (ADR 0052).</summary>
    private async Task OnTrashDropAsync(FileViewDropRequestedEventArgs e)
    {
        if (e.Entries.Count == 0) return;

        FileTransferResult result = await TrackOperation(FileTransfer.MoveToTrashAsync(
            e.Entries.Select(entry => entry.Path.Value).ToList(), AppContext.CancellationToken));
        ReportTransfer(result, "move to the trash");
        await RefreshAfterTransferAsync();
        if (_trashView is not null && _showTrash)
        {
            await _trashView.ReloadAsync();
        }
    }

    /// <summary>The "Replace / Keep both / Skip" window; closing it skips the item.</summary>
    private async Task<FileConflictResolution> AskConflictAsync(FileTransferConflict conflict)
    {
        DialogParameters parameters = new()
        {
            { nameof(FileConflictDialog.OwnerAppContext), AppContext },
            { nameof(FileConflictDialog.Conflict), conflict }
        };
        IDialogReference dialog = await MudDialogService.ShowAsync<FileConflictDialog>("Name conflict", parameters);
        DialogResult? result = await dialog.Result;
        return result is { Canceled: false, Data: FileConflictResolution resolution }
            ? resolution
            : new FileConflictResolution(FileConflictChoice.Skip);
    }

    /// <summary>
    /// Shows the end-of-operation summary: the failures (with their reason) in the error banner and as a
    /// desktop notification; nothing when everything went through.
    /// </summary>
    private void ReportTransfer(FileTransferResult result, string verb)
    {
        string? summary = result.DescribeFailures(verb);
        _errorMessage = summary;
        if (summary is not null)
        {
            try
            {
                AppContext.Notifications.Post(NotificationSeverity.Warning, "File Explorer", summary);
            }
            catch (AppGatewayAccessDeniedException)
            {
                // The banner already shows it.
            }
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAfterTransferAsync()
    {
        if (_fileView is null) return;
        try
        {
            await _fileView.RefreshAsync();
        }
        catch (InvalidOperationException)
        {
            // The current folder itself was moved away: go home.
            await NavigateHomeAsync();
        }
    }

    private async Task ShowTrashAsync()
    {
        _showTrash = true;
        _errorMessage = null;
        if (_trashView is not null)
        {
            await _trashView.ReloadAsync();
        }
    }

    /// <summary>Restored elements may have landed in the folder FileView is showing.</summary>
    private Task OnTrashRestoredAsync(IReadOnlyList<string> paths) => _fileView?.RefreshAsync() ?? Task.CompletedTask;

    /// <summary>
    /// Toolbar "Upload": imports host files into the current folder, like a drop of host files — a taken
    /// name gets a "(copy)" suffix rather than overwriting (ADR 0058, section 1).
    /// </summary>
    private async Task UploadFilesAsync(InputFileChangeEventArgs e)
    {
        if (_fileView is null) return;

        IReadOnlyList<FileTransferHostFile> files = e.GetMultipleFiles(maximumFileCount: 100)
            .Select(file => new FileTransferHostFile(
                file.Name,
                file.Size,
                file.ContentType,
                (maxBytes, cancellationToken) => Task.FromResult(file.OpenReadStream(maxBytes, cancellationToken))))
            .ToList();
        FileTransferResult result = await TrackOperation(FileTransfer.ImportAsync(files, _fileView.CurrentDirectory.Value, AppContext.CancellationToken));
        ReportTransfer(result, "upload");
        await _fileView.RefreshAsync();
    }

    private async Task DownloadSelectedAsync()
    {
        if (_downloader is null || _fileView is null) return;
        IReadOnlyList<FileViewItem> selected = _fileView.SelectedItems;

        if (selected.Count == 1)
        {
            FileViewItem item = selected[0];
            if (!item.IsDirectory)
            {
                FileSystemResult<FileSystemContentReadHandle> result = await AppContext.FileSystem.ReadAsync(
                    new FileSystemReadRequest(item.FullPath), AppContext.CancellationToken);
                if (result.Succeeded && result.Value is not null)
                {
                    await using FileSystemContentReadHandle handle = result.Value;
                    await _downloader.DownloadFileFromStreamAsync(item.FileName, handle.Content);
                }
            }
            else
            {
                using MemoryStream ms = new();
                using (ZipArchive archive = new(ms, ZipArchiveMode.Create, true))
                {
                    await FileExplorerZipService.AddDirectoryToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                }
                ms.Position = 0;
                await _downloader.DownloadFileFromStreamAsync(item.FileName + ".zip", ms);
            }
        }
        else if (selected.Count > 1)
        {
            using MemoryStream ms = new();
            using (ZipArchive archive = new(ms, ZipArchiveMode.Create, true))
            {
                foreach (FileViewItem item in selected)
                {
                    if (!item.IsDirectory)
                    {
                        await FileExplorerZipService.AddFileToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                    }
                    else
                    {
                        await FileExplorerZipService.AddDirectoryToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                    }
                }
            }
            ms.Position = 0;
            await _downloader.DownloadFileFromStreamAsync("Archive.zip", ms);
        }
    }

    private async Task CompressSelectedAsync()
    {
        if (_fileView is null || _fileView.SelectedItems.Count == 0) return;
        IReadOnlyList<FileViewItem> selected = _fileView.SelectedItems;

        string defaultName = selected.Count == 1 ? selected[0].FileName + ".zip" : "Archive.zip";
        TextInputDialogResult result = await base.TextInput(
            title: "Compress to Zip",
            content: "Enter the name of the zip archive:",
            defaultValue: defaultName,
            placeholder: "Archive name...");

        if (result.Status != TextInputStatus.Submitted || string.IsNullOrWhiteSpace(result.Value)) return;

        string archiveName = result.Value.Trim();
        if (!archiveName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            archiveName += ".zip";
        }

        VirtualPath destPath = CombineChild(_fileView.CurrentDirectory, archiveName);
        FileSystemResult<FileSystemEntrySnapshot> destStat = await AppContext.FileSystem.StatAsync(
            new FileSystemStatRequest(destPath), AppContext.CancellationToken);
        if (destStat.Succeeded)
        {
            ReportError($"'{archiveName}' already exists.");
            return;
        }

        using MemoryStream ms = new();
        using (ZipArchive archive = new(ms, ZipArchiveMode.Create, true))
        {
            foreach (FileViewItem item in selected)
            {
                if (!item.IsDirectory)
                {
                    await FileExplorerZipService.AddFileToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                }
                else
                {
                    await FileExplorerZipService.AddDirectoryToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                }
            }
        }
        ms.Position = 0;

        FileSystemMutationResult createResult = await AppContext.FileSystem.CreateAsync(
            new FileSystemCreateRequest(destPath, FileSystemEntryKind.File, FileSystemPermissions.FromMode(0b110_100_100)),
            AppContext.CancellationToken);

        if (!createResult.Succeeded)
        {
            ReportError("Could not create the archive.");
            return;
        }

        MemoryStreamContentSource source = new(FileSystemContentDescriptor.Binary("application/zip"), ms);
        FileSystemMutationResult writeResult = await AppContext.FileSystem.WriteAsync(
            new FileSystemWriteRequest(destPath), source, AppContext.CancellationToken);

        if (writeResult.Succeeded)
        {
            _errorMessage = null;
            _fileView.ClearSelect();
            await _fileView.RefreshAsync();
        }
        else
        {
            ReportError("Failed to write the archive.");
        }
    }

    private async Task ExtractSelectedAsync()
    {
        if (_fileView is null || !CanExtractSelection) return;

        FileViewItem item = _fileView.SelectedItem!;
        string folderName = item.FileName[..^".zip".Length];
        VirtualPath destDir = CombineChild(_fileView.CurrentDirectory, folderName);

        string? error = await FileExplorerZipService.ExtractAsync(AppContext.FileSystem, item.FullPath, destDir, AppContext.CancellationToken);
        if (error is not null)
        {
            ReportError(error);
            return;
        }

        _errorMessage = null;
        _fileView.ClearSelect();
        await _fileView.RefreshAsync();
    }

    private async Task ShowPropertiesAsync()
    {
        FileViewItem? item = _fileView?.SelectedItem;
        if (item is null) return;

        DialogParameters parameters = new()
        {
            { nameof(FilePropertiesDialog.OwnerAppContext), AppContext },
            { nameof(FilePropertiesDialog.EntryName), item.FileName },
            { nameof(FilePropertiesDialog.Path), item.FullPath.Value },
            { nameof(FilePropertiesDialog.Metadata), item.Metadata }
        };

        await MudDialogService.ShowAsync<FilePropertiesDialog>("Properties", parameters);
    }

    private async Task OpenWithAsync()
    {
        FileViewItem? item = _fileView?.SelectedItem;
        if (item is null) return;

        // Only installed apps are listed (ADR 0048): the catalog gateway hides uninstalled ones.
        IReadOnlyList<HackAppInfo> windowApps = (await AppContext.Catalog.GetInstalledAsync(AppContext.CancellationToken))
            .Where(app => app.Kind == AppKind.Window)
            .ToList();

        DialogParameters parameters = new()
        {
            { nameof(OpenWithDialog.OwnerAppContext), AppContext },
            { nameof(OpenWithDialog.FilePath), item.FullPath.Value },
            { nameof(OpenWithDialog.AvailableApps), windowApps }
        };

        IDialogReference dialog = await MudDialogService.ShowAsync<OpenWithDialog>("Open With", parameters);
        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is HackAppInfo selectedApp)
        {
            await LaunchWithAsync(selectedApp.Id, item.FullPath.Value);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_fileView is not null)
        {
            _fileView.OnPathChange -= OnFileViewPathChanged;
            _fileView.Opened -= OnFileViewItemOpened;
            _fileView.SelectionChanged -= OnFileViewSelectionChanged;
        }

        _eventSub?.Dispose();
        if (_subscribedToClipboard)
        {
            AppContext.Clipboard.Changed -= OnClipboardChanged;
        }

        if (_downloader is not null)
        {
            await _downloader.DisposeAsync();
        }
    }
}
