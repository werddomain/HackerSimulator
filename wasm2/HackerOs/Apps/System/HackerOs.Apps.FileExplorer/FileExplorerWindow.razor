@using HackerOs.App.Abstractions
@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.FileView
@using HackerOs.AppSdk.FileView.ContextMenu
@using HackerOs.AppSdk.FileView.Events
@using HackerOs.Platform.Core
@using HackerOs.Simulation.Abstractions.Gateways
@using HackerOs.Simulation.Abstractions.Events
@using HackerOs.Simulation.Abstractions.FileSystem
@using HackerOs.Simulation.Abstractions.Sessions
@using HackerOs.AppSdk.Blazor.Interop
@using HackerOs.AppSdk.Icons
@using System.IO.Compression
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@inherits WindowAppBase
@implements IAsyncDisposable
@inject AppCatalog Catalog
@inject ISessionService SessionService
@inject MudBlazor.IDialogService MudDialogService
@inject IJSRuntime JSRuntime

@*
    Hosts FileView (Shared/HackerOs.AppSdk.FileView) for listing/selection/rename/drag-drop/context-menu —
    this window keeps only the chrome FileView deliberately doesn't own: toolbar, address bar, search box,
    view-mode toggle, and the OpenWithDialog/FilePropertiesDialog modals (ADR 0037, INT-001/INT-002).
    FileView exposes no public Create/Delete methods (only its own internal context-menu wires those), so
    the toolbar's New Folder/New File/Delete/Compress/Extract actions call AppContext.FileSystem directly —
    the same raw gateway calls FileView's own internal handlers make, just from this assembly instead of
    that one — then refresh FileView. Rename/Properties/Open With instead go through FileView's public
    FileViewItem/SelectedItem surface directly, with zero duplicated logic.
*@
<div class="file-explorer-container">
    <!-- Navigation & Address Toolbar -->
    <div class="explorer-toolbar">
        <div class="nav-buttons">
            <button class="nav-btn" disabled="@(!_state.CanNavigateBack)" @onclick="NavigateBackAsync" title="Back">
                <HackerIcon Library="IconLibrary.Lucide" Name="arrow-left" Size="16" />
            </button>
            <button class="nav-btn" disabled="@(!_state.CanNavigateForward)" @onclick="NavigateForwardAsync" title="Forward">
                <HackerIcon Library="IconLibrary.Lucide" Name="arrow-right" Size="16" />
            </button>
            <button class="nav-btn" disabled="@(!_state.CanNavigateUp)" @onclick="NavigateUpAsync" title="Up">
                <HackerIcon Library="IconLibrary.Lucide" Name="arrow-up" Size="16" />
            </button>
            <button class="nav-btn" @onclick="RefreshAsync" title="Refresh">
                <HackerIcon Library="IconLibrary.Lucide" Name="refresh-cw" Size="16" />
            </button>
            <button class="nav-btn" @onclick="NavigateHomeAsync" title="Home">
                <HackerIcon Library="IconLibrary.Lucide" Name="house" Size="16" />
            </button>
        </div>

        <div class="address-bar">
            <input type="text" class="address-input" @bind="_addressInput" @bind:event="oninput" @onkeydown="HandleAddressKeyDownAsync" aria-label="Current path address" />
        </div>

        <div class="search-box">
            <input type="text" class="search-input" placeholder="Search..." @bind="_state.SearchQuery" @bind:event="oninput" @bind:after="OnSearchQueryChanged" aria-label="Search directory" />
        </div>

        <div class="view-toggle">
            <button class="view-btn @(_state.ViewMode == FileViewMode.Details ? "active" : "")" @onclick="() => SetViewMode(FileViewMode.Details)" title="Details View">
                <HackerIcon Library="IconLibrary.Lucide" Name="list" Size="16" />
            </button>
            <button class="view-btn @(_state.ViewMode == FileViewMode.Icons ? "active" : "")" @onclick="() => SetViewMode(FileViewMode.Icons)" title="Icons View">
                <HackerIcon Library="IconLibrary.Lucide" Name="layout-grid" Size="16" />
            </button>
            <button class="view-btn @(_state.ViewMode == FileViewMode.Tree ? "active" : "")" @onclick="() => SetViewMode(FileViewMode.Tree)" title="Tree View">
                <HackerIcon Library="IconLibrary.Lucide" Name="list-tree" Size="16" />
            </button>
        </div>
    </div>

    <!-- Actions Toolbar -->
    <div class="actions-toolbar">
        <button class="action-btn" @onclick="CreateFolderAsync" title="New Folder">
            <HackerIcon Library="IconLibrary.Lucide" Name="folder-plus" Size="16" /> <span>New Folder</span>
        </button>
        <button class="action-btn" @onclick="CreateFileAsync" title="New File">
            <HackerIcon Library="IconLibrary.Lucide" Name="file-plus" Size="16" /> <span>New File</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount != 1)" @onclick="RenameSelected" title="Rename">
            <HackerIcon Library="IconLibrary.Lucide" Name="pencil" Size="16" /> <span>Rename</span>
        </button>
        <button class="action-btn danger" disabled="@(SelectedCount == 0)" @onclick="DeleteSelectedAsync" title="Delete">
            <HackerIcon Library="IconLibrary.Lucide" Name="trash-2" Size="16" /> <span>Delete</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount != 1)" @onclick="ShowPropertiesAsync" title="Properties">
            <HackerIcon Library="IconLibrary.Lucide" Name="info" Size="16" /> <span>Properties</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount != 1)" @onclick="OpenWithAsync" title="Open With...">
            <HackerIcon Library="IconLibrary.Lucide" Name="external-link" Size="16" /> <span>Open With...</span>
        </button>

        <span class="toolbar-divider"></span>

        <InputFile id="fileInput" OnChange="UploadFilesAsync" multiple hidden />
        <label for="fileInput" class="action-btn" title="Upload">
            <HackerIcon Library="IconLibrary.Lucide" Name="upload" Size="16" /> <span>Upload</span>
        </label>
        <button class="action-btn" disabled="@(SelectedCount == 0)" @onclick="DownloadSelectedAsync" title="Download">
            <HackerIcon Library="IconLibrary.Lucide" Name="download" Size="16" /> <span>Download</span>
        </button>
        <button class="action-btn" disabled="@(SelectedCount == 0)" @onclick="CompressSelectedAsync" title="Compress to Zip">
            <HackerIcon Library="IconLibrary.Lucide" Name="archive" Size="16" /> <span>Compress</span>
        </button>
        <button class="action-btn" disabled="@(!CanExtractSelection)" @onclick="ExtractSelectedAsync" title="Extract Zip">
            <HackerIcon Library="IconLibrary.Lucide" Name="package-open" Size="16" /> <span>Extract</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-state">@_errorMessage</div>
    }
    else if (_fileView is not null && _fileView.Items.Count == 0)
    {
        <div class="empty-state">This directory is empty.</div>
    }

    <!-- Directory Content View -->
    <div class="explorer-content">
        <FileView @ref="_fileView"
                  FileSystem="AppContext.FileSystem"
                  Watch="AppContext.Watch"
                  Intents="AppContext.Intents"
                  InitialDirectory="_initialDirectory"
                  @bind-Mode="_state.ViewMode"
                  Filter="_searchFilter"
                  ContextMenuProviders="_contextMenuProviders"
                  OwnerAppId="Manifest.Id" />
    </div>

    <!-- Status Bar -->
    <div class="explorer-statusbar">
        <span>@(_fileView?.Items.Count ?? 0) item(s)</span>
        @if (SelectedCount > 0)
        {
            <span> | @SelectedCount selected</span>
        }
    </div>

</div>

@code {
    private FileExplorerState _state = default!;
    private FileView? _fileView;
    private VirtualPath _initialDirectory;
    private string _addressInput = string.Empty;
    private string? _errorMessage;
    private IDisposable? _eventSub;
    private BrowserFileDownloader? _downloader;
    private Func<FileViewItem, bool> _searchFilter = default!;
    private IReadOnlyList<IFileViewContextMenuProvider> _contextMenuProviders = [];
    private bool _subscribedToFileView;

    private int SelectedCount => _fileView?.SelectedItems.Count ?? 0;

    private bool CanExtractSelection =>
        _fileView?.SelectedItem is { IsDirectory: false } item
        && _fileView.SelectedItems.Count == 1
        && item.FileName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase);

    private string GetHomePath() => SessionService.CurrentPrincipal?.HomePath ?? $"/home/{AppContext.UserId}";

    protected override void OnAppInitialized()
    {
        base.OnAppInitialized();
        string homePath = GetHomePath();
        _state = new FileExplorerState(homePath);
        _initialDirectory = VirtualPath.Parse(homePath);
        _addressInput = homePath;
        _searchFilter = MatchesSearchQuery;
        _contextMenuProviders = [new ZipFileContextMenuProvider(AppContext.FileSystem, () => _fileView, ReportError)];
        _eventSub = AppContext.Events.Subscribe<AppDisabledEvent>(evt =>
        {
            if (_fileView is not null)
            {
                InvokeAsync(() => _fileView.RefreshAsync());
            }
        });
    }

    protected override async Task OnAppInitializedAsync()
    {
        _downloader = new BrowserFileDownloader(JSRuntime);
        await base.OnAppInitializedAsync();
    }

    protected override void OnAppAfterRender(bool firstRender)
    {
        base.OnAppAfterRender(firstRender);
        if (firstRender && _fileView is not null && !_subscribedToFileView)
        {
            _subscribedToFileView = true;
            _fileView.OnPathChange += OnFileViewPathChanged;
            _fileView.Opened += OnFileViewItemOpened;
            _fileView.SelectionChanged += OnFileViewSelectionChanged;
        }
    }

    private void OnFileViewSelectionChanged(object? sender, FileViewSelectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private bool MatchesSearchQuery(FileViewItem item) =>
        string.IsNullOrWhiteSpace(_state.SearchQuery) ||
        item.FileName.Contains(_state.SearchQuery, StringComparison.OrdinalIgnoreCase);

    private void OnSearchQueryChanged() => _fileView?.RefreshFilter();

    private void ReportError(string message)
    {
        _errorMessage = message;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnFileViewPathChanged(object? sender, FileViewPathChangedEventArgs e)
    {
        _state.NavigateTo(e.Path.Value);
        _addressInput = _state.CurrentPath;
        _errorMessage = null;
        _ = InvokeAsync(StateHasChanged);
    }

    private async void OnFileViewItemOpened(object? sender, FileViewOpenedEventArgs e)
    {
        if (!e.Item.IsDirectory)
        {
            await LaunchFileIntentAsync(e.Item.FullPath.Value);
        }
    }

    private async Task NavigateFileViewAsync(string path)
    {
        if (_fileView is null) return;

        try
        {
            await _fileView.NavigateAsync(VirtualPath.Parse(path));
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    private Task NavigateBackAsync()
    {
        _state.NavigateBack();
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task NavigateForwardAsync()
    {
        _state.NavigateForward();
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task NavigateUpAsync()
    {
        _state.NavigateUp();
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task NavigateHomeAsync()
    {
        _state.NavigateTo(GetHomePath());
        return NavigateFileViewAsync(_state.CurrentPath);
    }

    private Task RefreshAsync() => _fileView?.RefreshAsync() ?? Task.CompletedTask;

    private async Task HandleAddressKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            _state.NavigateTo(_addressInput);
            await NavigateFileViewAsync(_state.CurrentPath);
        }
    }

    private void SetViewMode(FileViewMode mode)
    {
        _state.ViewMode = mode;
        StateHasChanged();
    }

    private async Task LaunchFileIntentAsync(string fullPath)
    {
        AppIntentOpenFileResult result;
        try
        {
            result = await AppContext.Intents.OpenFileAsync(VirtualPath.Parse(fullPath));
        }
        catch (AppGatewayAccessDeniedException)
        {
            ReportError("You don't have permission to open files.");
            return;
        }

        switch (result.Outcome)
        {
            case AppIntentOpenFileOutcome.Opened:
                break;
            case AppIntentOpenFileOutcome.ChooserRequired:
                await ShowOpenWithChooserAsync(fullPath, result.CandidateAppIds ?? []);
                break;
            case AppIntentOpenFileOutcome.NoHandler:
                ReportError("No application is registered to open this file.");
                break;
            default:
                ReportError($"Could not open file: {result.ErrorCode}");
                break;
        }
    }

    private async Task ShowOpenWithChooserAsync(string fullPath, IReadOnlyList<string> candidateAppIds)
    {
        IReadOnlyList<AppManifest> candidates = candidateAppIds
            .Select(id => Catalog.Manifests.GetValueOrDefault(id))
            .Where(manifest => manifest is not null)
            .Select(manifest => manifest!)
            .ToList();

        DialogParameters parameters = new()
        {
            { nameof(OpenWithDialog.FilePath), fullPath },
            { nameof(OpenWithDialog.AvailableApps), candidates }
        };

        IDialogReference dialog = await MudDialogService.ShowAsync<OpenWithDialog>("Open With", parameters);
        DialogResult? dialogResult = await dialog.Result;

        if (dialogResult is not null && !dialogResult.Canceled && dialogResult.Data is AppManifest selectedApp)
        {
            await LaunchWithAsync(selectedApp.Id, fullPath);
        }
    }

    private async Task LaunchWithAsync(string appId, string fullPath)
    {
        try
        {
            await AppContext.Intents.LaunchAsync(appId, [fullPath]);
        }
        catch (AppGatewayAccessDeniedException)
        {
            ReportError("You don't have permission to launch applications.");
        }
    }

    private static VirtualPath CombineChild(VirtualPath parent, string name) =>
        VirtualPath.Parse(parent.Value == "/" ? $"/{name}" : $"{parent.Value}/{name}");

    private async Task CreateFolderAsync()
    {
        if (_fileView is null) return;

        TextInputDialogResult result = await base.TextInput(
            title: "New Folder",
            content: "Enter the name of the new folder:",
            defaultValue: "New Folder",
            placeholder: "Folder name...");

        if (result.Status != TextInputStatus.Submitted || string.IsNullOrWhiteSpace(result.Value)) return;

        string folderName = result.Value.Trim();
        VirtualPath fullPath = CombineChild(_fileView.CurrentDirectory, folderName);
        FileSystemMutationResult creation = await AppContext.FileSystem.CreateAsync(
            new FileSystemCreateRequest(fullPath, FileSystemEntryKind.Directory, FileSystemPermissions.FromMode(0b111_101_101)),
            AppContext.CancellationToken);

        if (creation.Succeeded)
        {
            _errorMessage = null;
            await _fileView.RefreshAsync();
        }
        else
        {
            ReportError(creation.Transaction.Error?.Code == FileSystemErrorCode.AlreadyExists
                ? $"'{folderName}' already exists."
                : "Could not create the folder.");
        }
    }

    private async Task CreateFileAsync()
    {
        if (_fileView is null) return;

        TextInputDialogResult result = await base.TextInput(
            title: "New File",
            content: "Enter the name of the new file:",
            defaultValue: "NewFile.txt",
            placeholder: "File name...");

        if (result.Status != TextInputStatus.Submitted || string.IsNullOrWhiteSpace(result.Value)) return;

        string fileName = result.Value.Trim();
        VirtualPath fullPath = CombineChild(_fileView.CurrentDirectory, fileName);
        FileSystemMutationResult creation = await AppContext.FileSystem.CreateAsync(
            new FileSystemCreateRequest(fullPath, FileSystemEntryKind.File, FileSystemPermissions.FromMode(0b110_100_100)),
            AppContext.CancellationToken);

        if (creation.Succeeded)
        {
            _errorMessage = null;
            await _fileView.RefreshAsync();
        }
        else
        {
            ReportError(creation.Transaction.Error?.Code == FileSystemErrorCode.AlreadyExists
                ? $"'{fileName}' already exists."
                : "Could not create the file.");
        }
    }

    /// <summary>Uses FileView's own inline rename (label ↔ textbox swap) — no modal dialog, unlike every other action here.</summary>
    private void RenameSelected() => _fileView?.SelectedItem?.Rename();

    private async Task DeleteSelectedAsync()
    {
        if (_fileView is null || _fileView.SelectedItems.Count == 0) return;

        FileSystemResult<FileSystemEntrySnapshot> parentStat = await AppContext.FileSystem.StatAsync(
            new FileSystemStatRequest(_fileView.CurrentDirectory), AppContext.CancellationToken);
        long parentRevision = parentStat.Succeeded && parentStat.Value is not null ? parentStat.Value.Metadata.Revision : 1;

        foreach (FileViewItem item in _fileView.SelectedItems.ToList())
        {
            await AppContext.FileSystem.DeleteAsync(
                new FileSystemDeleteRequest(item.FullPath, item.Metadata.Revision, parentRevision, recursive: true),
                AppContext.CancellationToken);
        }

        _fileView.ClearSelect();
        await _fileView.RefreshAsync();
    }

    private async Task UploadFilesAsync(InputFileChangeEventArgs e)
    {
        if (_fileView is null) return;

        foreach (IBrowserFile file in e.GetMultipleFiles())
        {
            VirtualPath path = CombineChild(_fileView.CurrentDirectory, file.Name);

            FileSystemResult<FileSystemEntrySnapshot> stat = await AppContext.FileSystem.StatAsync(new FileSystemStatRequest(path), AppContext.CancellationToken);
            if (!stat.Succeeded && stat.Error?.Code == FileSystemErrorCode.NotFound)
            {
                FileSystemMutationResult createResult = await AppContext.FileSystem.CreateAsync(
                    new FileSystemCreateRequest(path, FileSystemEntryKind.File, FileSystemPermissions.FromMode(0b110_100_100)),
                    AppContext.CancellationToken);

                if (!createResult.Succeeded) continue;
            }
            else if (!stat.Succeeded)
            {
                continue;
            }

            // Unconditional write: an upload always replaces whatever is at this path with the freshly
            // selected file — there is no "revision the browser read before editing" to protect here the
            // way there is for a text editor.
            BrowserFileContentSource source = new(file);
            await AppContext.FileSystem.WriteAsync(new FileSystemWriteRequest(path), source, AppContext.CancellationToken);
        }

        await _fileView.RefreshAsync();
    }

    private async Task DownloadSelectedAsync()
    {
        if (_downloader is null || _fileView is null) return;
        IReadOnlyList<FileViewItem> selected = _fileView.SelectedItems;

        if (selected.Count == 1)
        {
            FileViewItem item = selected[0];
            if (!item.IsDirectory)
            {
                FileSystemResult<FileSystemContentReadHandle> result = await AppContext.FileSystem.ReadAsync(
                    new FileSystemReadRequest(item.FullPath), AppContext.CancellationToken);
                if (result.Succeeded && result.Value is not null)
                {
                    await using FileSystemContentReadHandle handle = result.Value;
                    await _downloader.DownloadFileFromStreamAsync(item.FileName, handle.Content);
                }
            }
            else
            {
                using MemoryStream ms = new();
                using (ZipArchive archive = new(ms, ZipArchiveMode.Create, true))
                {
                    await FileExplorerZipService.AddDirectoryToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                }
                ms.Position = 0;
                await _downloader.DownloadFileFromStreamAsync(item.FileName + ".zip", ms);
            }
        }
        else if (selected.Count > 1)
        {
            using MemoryStream ms = new();
            using (ZipArchive archive = new(ms, ZipArchiveMode.Create, true))
            {
                foreach (FileViewItem item in selected)
                {
                    if (!item.IsDirectory)
                    {
                        await FileExplorerZipService.AddFileToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                    }
                    else
                    {
                        await FileExplorerZipService.AddDirectoryToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                    }
                }
            }
            ms.Position = 0;
            await _downloader.DownloadFileFromStreamAsync("Archive.zip", ms);
        }
    }

    private async Task CompressSelectedAsync()
    {
        if (_fileView is null || _fileView.SelectedItems.Count == 0) return;
        IReadOnlyList<FileViewItem> selected = _fileView.SelectedItems;

        string defaultName = selected.Count == 1 ? selected[0].FileName + ".zip" : "Archive.zip";
        TextInputDialogResult result = await base.TextInput(
            title: "Compress to Zip",
            content: "Enter the name of the zip archive:",
            defaultValue: defaultName,
            placeholder: "Archive name...");

        if (result.Status != TextInputStatus.Submitted || string.IsNullOrWhiteSpace(result.Value)) return;

        string archiveName = result.Value.Trim();
        if (!archiveName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            archiveName += ".zip";
        }

        VirtualPath destPath = CombineChild(_fileView.CurrentDirectory, archiveName);
        FileSystemResult<FileSystemEntrySnapshot> destStat = await AppContext.FileSystem.StatAsync(
            new FileSystemStatRequest(destPath), AppContext.CancellationToken);
        if (destStat.Succeeded)
        {
            ReportError($"'{archiveName}' already exists.");
            return;
        }

        using MemoryStream ms = new();
        using (ZipArchive archive = new(ms, ZipArchiveMode.Create, true))
        {
            foreach (FileViewItem item in selected)
            {
                if (!item.IsDirectory)
                {
                    await FileExplorerZipService.AddFileToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                }
                else
                {
                    await FileExplorerZipService.AddDirectoryToZipAsync(AppContext.FileSystem, archive, item.FullPath, item.FileName, AppContext.CancellationToken);
                }
            }
        }
        ms.Position = 0;

        FileSystemMutationResult createResult = await AppContext.FileSystem.CreateAsync(
            new FileSystemCreateRequest(destPath, FileSystemEntryKind.File, FileSystemPermissions.FromMode(0b110_100_100)),
            AppContext.CancellationToken);

        if (!createResult.Succeeded)
        {
            ReportError("Could not create the archive.");
            return;
        }

        MemoryStreamContentSource source = new(FileSystemContentDescriptor.Binary("application/zip"), ms);
        FileSystemMutationResult writeResult = await AppContext.FileSystem.WriteAsync(
            new FileSystemWriteRequest(destPath), source, AppContext.CancellationToken);

        if (writeResult.Succeeded)
        {
            _errorMessage = null;
            _fileView.ClearSelect();
            await _fileView.RefreshAsync();
        }
        else
        {
            ReportError("Failed to write the archive.");
        }
    }

    private async Task ExtractSelectedAsync()
    {
        if (_fileView is null || !CanExtractSelection) return;

        FileViewItem item = _fileView.SelectedItem!;
        string folderName = item.FileName[..^".zip".Length];
        VirtualPath destDir = CombineChild(_fileView.CurrentDirectory, folderName);

        string? error = await FileExplorerZipService.ExtractAsync(AppContext.FileSystem, item.FullPath, destDir, AppContext.CancellationToken);
        if (error is not null)
        {
            ReportError(error);
            return;
        }

        _errorMessage = null;
        _fileView.ClearSelect();
        await _fileView.RefreshAsync();
    }

    private async Task ShowPropertiesAsync()
    {
        FileViewItem? item = _fileView?.SelectedItem;
        if (item is null) return;

        DialogParameters parameters = new()
        {
            { nameof(FilePropertiesDialog.EntryName), item.FileName },
            { nameof(FilePropertiesDialog.Path), item.FullPath.Value },
            { nameof(FilePropertiesDialog.Metadata), item.Metadata }
        };

        await MudDialogService.ShowAsync<FilePropertiesDialog>("Properties", parameters);
    }

    private async Task OpenWithAsync()
    {
        FileViewItem? item = _fileView?.SelectedItem;
        if (item is null) return;

        IReadOnlyList<AppManifest> windowApps = Catalog.Manifests.Values.Where(m => m.Kind == AppKind.Window).ToList();

        DialogParameters parameters = new()
        {
            { nameof(OpenWithDialog.FilePath), item.FullPath.Value },
            { nameof(OpenWithDialog.AvailableApps), windowApps }
        };

        IDialogReference dialog = await MudDialogService.ShowAsync<OpenWithDialog>("Open With", parameters);
        DialogResult? result = await dialog.Result;

        if (result is not null && !result.Canceled && result.Data is AppManifest selectedApp)
        {
            await LaunchWithAsync(selectedApp.Id, item.FullPath.Value);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_fileView is not null)
        {
            _fileView.OnPathChange -= OnFileViewPathChanged;
            _fileView.Opened -= OnFileViewItemOpened;
            _fileView.SelectionChanged -= OnFileViewSelectionChanged;
        }

        _eventSub?.Dispose();
        if (_downloader is not null)
        {
            await _downloader.DisposeAsync();
        }
    }
}
