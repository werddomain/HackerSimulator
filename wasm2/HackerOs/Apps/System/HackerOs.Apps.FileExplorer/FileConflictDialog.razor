@inherits FileExplorerDialogBase
@using HackerOs.AppSdk.FileView.Transfers
@using MudBlazor

@*
    "Replace / Keep both / Skip" window of a move whose name is taken (ADR 0058, section 1), with
    "Apply to all" for the rest of the operation. Closing it without a choice skips the item.
*@
<MudDialog Class="gothic-dialog">
    <DialogContent>
        <div class="conflict-container">
            <p class="conflict-title">
                @ExistsText.Before<strong>@Conflict.Name</strong>@ExistsText.After
            </p>
            <p class="conflict-detail">
                @MovingText.Before<span class="conflict-path">@Conflict.SourcePath</span>@MovingText.After
            </p>
            @if (Conflict.DestinationIsDirectory)
            {
                <p class="conflict-warning">@L["Conflict.ReplaceWarning"]</p>
            }
            @if (ShowApplyToAll)
            {
                <MudCheckBox T="bool" @bind-Value="_applyToAll" Label="@L["Conflict.ApplyToAll"]" Dense="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="() => Close(FileConflictChoice.Skip)">@L["Conflict.Skip"]</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="() => Close(FileConflictChoice.KeepBoth)">@L["Conflict.KeepBoth"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => Close(FileConflictChoice.Replace)">@L["Conflict.Replace"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The conflict to settle.</summary>
    [Parameter]
    public FileTransferConflict Conflict { get; set; } = default!;

    /// <summary>Whether more items follow, so "Apply to all" makes sense.</summary>
    [Parameter]
    public bool ShowApplyToAll { get; set; } = true;

    private bool _applyToAll;

    // "A folder named {0} already exists here." split around the bold name.
    private (string Before, string After) ExistsText =>
        Strings.Around(L[Conflict.DestinationIsDirectory ? "Conflict.FolderExists" : "Conflict.FileExists"]);

    // "Moving {0}" split around the styled source path.
    private (string Before, string After) MovingText => Strings.Around(L["Conflict.Moving"]);

    private void Close(FileConflictChoice choice) =>
        MudDialog.Close(DialogResult.Ok(new FileConflictResolution(choice, _applyToAll)));
}
