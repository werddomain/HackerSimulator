@inherits FileExplorerDialogBase
@using HackerOs.AppSdk.Apps
@using MudBlazor

<MudDialog Class="gothic-dialog">
    <DialogContent>
        <div class="openwith-container">
            <p class="openwith-subtitle">@PromptText.Before<strong>@FilePath</strong>@PromptText.After</p>
            <MudList T="HackAppInfo" SelectionMode="SelectionMode.SingleSelection" SelectedValue="_selectedApp" SelectedValueChanged="HandleSelectedAppChanged">
                @foreach (HackAppInfo manifest in AvailableApps)
                {
                    <MudListItem Value="@manifest">
                        <div class="app-item">
                            <span class="app-name">@manifest.Name</span>
                            <span class="app-id">(@manifest.Id)</span>
                        </div>
                    </MudListItem>
                }
            </MudList>
            @if (CanRemember)
            {
                <MudCheckBox T="bool" @bind-Value="_alwaysUse" Label="@L["OpenWith.AlwaysUse", Extension!]" Dense="true" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">@L["OpenWith.Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_selectedApp is null)" OnClick="Confirm">@L["OpenWith.Open"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string FilePath { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<HackAppInfo> AvailableApps { get; set; } = [];

    /// <summary>
    /// Lowercase extension of the file (<c>.md</c>), or <see langword="null"/>: with one, the dialog
    /// offers "Always use" for an app that declares it (ADR 0121, section 4).
    /// </summary>
    [Parameter]
    public string? Extension { get; set; }

    private HackAppInfo? _selectedApp;
    private bool _alwaysUse;

    // Only an app that declares the extension can become its default: the OS refuses the others.
    private bool CanRemember => Extension is not null && _selectedApp is not null
        && _selectedApp.FileHandlers.Any(handler =>
            handler.Extensions.Any(e => string.Equals(e, Extension, StringComparison.OrdinalIgnoreCase))
            && handler.Actions.Any(a => string.Equals(a, "open", StringComparison.OrdinalIgnoreCase)));

    // "Select an installed app to open {0}:" split around the bold file path.
    private (string Before, string After) PromptText => Strings.Around(L["OpenWith.Prompt"]);

    private void HandleSelectedAppChanged(HackAppInfo manifest)
    {
        _selectedApp = manifest;
    }

    private void Confirm()
    {
        if (_selectedApp is not null)
        {
            MudDialog.Close(DialogResult.Ok(new OpenWithChoice(_selectedApp, CanRemember && _alwaysUse)));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
