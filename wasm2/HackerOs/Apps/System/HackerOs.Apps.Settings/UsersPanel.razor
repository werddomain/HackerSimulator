@inherits HackerOs.AppSdk.Blazor.HackComponentBase
@using HackerOs.AppSdk.Administration

<div class="setting-group users-panel">
    <h4>@L["Users.List.Title"]</h4>
    <p class="setting-desc">
        @LocalizedMarkup.Format(L["Users.List.Description"], LocalizedMarkup.Code("passwd"), LocalizedMarkup.Code("sudo passwd"))
    </p>
    @if (_accounts.Count == 0)
    {
        <p class="setting-desc">@L["Users.List.Empty"]</p>
    }
    else
    {
        <ul class="account-list" aria-label="@L["Users.List.Title"]">
            @foreach (HackUserAccount account in _accounts)
            {
                <li class="@(account.IsCurrentUser ? "account is-current" : "account")">
                    <span class="account-login">@account.LoginName</span>
                    <span class="account-name">@account.DisplayName</span>
                    <span class="account-badges">
                        @if (account.IsAdministrator)
                        {
                            <span class="badge badge-admin">@L["Users.Badge.Administrator"]</span>
                        }
                        @if (account.IsCurrentUser)
                        {
                            <span class="badge">@L["Users.Badge.You"]</span>
                        }
                        <span class="@StateClass(account)" title="@StateTitle(account)">@StateCode(account)</span>
                    </span>
                </li>
            }
        </ul>
    }
</div>

<div class="setting-group users-panel">
    <h4>@L["Users.Own.Title"]</h4>
    <p class="setting-desc">@L["Users.Own.Description"]</p>
    <form class="password-form" @onsubmit="ChangeOwnAsync" @onsubmit:preventDefault>
        @if (CurrentHasPassword)
        {
            <label class="field">
                <span>@L["Users.Field.Current"]</span>
                <input class="text-input" type="password" autocomplete="current-password" @bind="_current" disabled="@_busy" />
            </label>
        }
        <label class="field">
            <span>@L["Users.Field.New"]</span>
            <input class="text-input" type="password" autocomplete="new-password" @bind="_ownNew" disabled="@_busy" />
        </label>
        <label class="field">
            <span>@L["Users.Field.Confirm"]</span>
            <input class="text-input" type="password" autocomplete="new-password" @bind="_ownConfirm" disabled="@_busy" />
        </label>
        <button type="submit" class="btn-secondary" disabled="@_busy">@L["Users.Own.Submit"]</button>
    </form>
    @if (!string.IsNullOrEmpty(_ownMessage))
    {
        <p class="@(_ownFailed ? "dialog-error" : "users-result")" role="@(_ownFailed ? "alert" : "status")">@_ownMessage</p>
    }
</div>

@if (CurrentIsAdministrator && OtherAccounts.Count > 0)
{
    <div class="setting-group users-panel danger-zone">
        <h4>@L["Users.Reset.Title"]</h4>
        <p class="setting-desc">
            @LocalizedMarkup.Format(L["Users.Reset.Description"],
                LocalizedMarkup.Code("~/.local/share/keyrings/login.keyring.old"),
                LocalizedMarkup.Code("users.manage"))
        </p>
        <form class="password-form" @onsubmit="ResetAsync" @onsubmit:preventDefault>
            <label class="field">
                <span>@L["Users.Field.Account"]</span>
                <select class="text-input" @bind="_resetLogin" disabled="@_busy">
                    @foreach (HackUserAccount account in OtherAccounts)
                    {
                        <option value="@account.LoginName">@account.LoginName (@account.DisplayName)</option>
                    }
                </select>
            </label>
            <label class="field">
                <span>@L["Users.Field.New"]</span>
                <input class="text-input" type="password" autocomplete="new-password" @bind="_resetNew" disabled="@_busy" />
            </label>
            <label class="field">
                <span>@L["Users.Field.Confirm"]</span>
                <input class="text-input" type="password" autocomplete="new-password" @bind="_resetConfirm" disabled="@_busy" />
            </label>
            <div class="form-actions">
                <button type="submit" class="btn-danger" disabled="@_busy">@L["Users.Reset.Submit"]</button>
                <button type="button" class="btn-secondary" disabled="@_busy" @onclick="RemoveAsync">@L["Users.Reset.Remove"]</button>
            </div>
        </form>
        @if (!string.IsNullOrEmpty(_resetMessage))
        {
            <p class="@(_resetFailed ? "dialog-error" : "users-result")" role="@(_resetFailed ? "alert" : "status")">@_resetMessage</p>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_loadError))
{
    <p class="dialog-error" role="alert">@_loadError</p>
}
