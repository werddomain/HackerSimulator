@inherits HackerOs.AppSdk.Blazor.HackComponentBase
@using HackerOs.AppSdk.Administration

@*
    Settings > Server Connection > Network relay (ADR 0102 §5): what the connected server lets apps
    holding network.real.access reach, as GET /api/proxy/policy reports it. Read-only: the policy
    lives in the server's appsettings.json, under HackerOs:Proxy.
*@
<section class="relay-policy" aria-label="Network relay policy">
    <h5>Network relay</h5>
    @if (_isLoading)
    {
        <p class="setting-desc">Reading the server's relay policy...</p>
    }
    else if (_error is not null)
    {
        <p class="relay-error">@_error</p>
    }
    else if (_policy is null)
    {
        <p class="setting-desc">The relay policy is not available on this host.</p>
    }
    else if (!_policy.Enabled)
    {
        <p class="relay-off">The server's operator turned the relay off: apps have no route to the real network.</p>
    }
    else
    {
        <dl class="relay-grid">
            <dt>HTTP ports</dt>
            <dd>@Ports(_policy.HttpPorts)</dd>
            <dt>TCP ports</dt>
            <dd>@Ports(_policy.TcpPorts)</dd>
            <dt>UDP ports</dt>
            <dd>@Ports(_policy.UdpPorts)</dd>
            <dt>Private networks</dt>
            <dd>@(_policy.AllowPrivateNetworks ? "Reachable" : "Blocked")</dd>
            <dt>Quotas</dt>
            <dd>@Quotas(_policy)</dd>
            <dt>Granted apps</dt>
            <dd>@string.Join(", ", _policy.GrantedApps)</dd>
        </dl>
        @foreach (string warning in _policy.Warnings)
        {
            <p class="relay-warning">@warning</p>
        }
    }
</section>
