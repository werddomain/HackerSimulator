@inherits HackerOs.AppSdk.Blazor.HackComponentBase
@using HackerOs.AppSdk.Apps

<div class="setting-group">
    <h4>Installed Applications</h4>
    <p class="setting-desc">
        Uninstalling an app hides it everywhere, blocks every way to start it and stops its running
        windows. Nothing is deleted: its settings and your files stay in place for a reinstall. Only a
        website loses its browser database.
        The list lives in <code>~/.config/hackeros/apps.config</code> (for you) and
        <code>/etc/hackeros/apps.config</code> (for every user: an administrator must authenticate).
    </p>

    @if (_apps is null)
    {
        <p class="setting-desc">Loading applications...</p>
    }

    <div class="apps-list" role="list">
        @foreach (HackAppInstallInfo app in Applications)
        {
            @Row(app)
        }
    </div>

    @if (Commands.Count > 0)
    {
        <details class="commands-group">
            <summary>Terminal commands (@Commands.Count) — part of the system, always installed</summary>
            <div class="apps-list" role="list">
                @foreach (HackAppInstallInfo command in Commands)
                {
                    @Row(command)
                }
            </div>
        </details>
    }

    @if (_pending is null && !string.IsNullOrEmpty(_message))
    {
        <p class="apps-message" role="alert">@_message</p>
    }
</div>

@if (_pending is not null)
{
    <div class="apps-backdrop" @onclick="CancelUninstall">
        <div class="apps-dialog"
             role="dialog"
             aria-modal="true"
             aria-labelledby="uninstall-title"
             @onclick:stopPropagation>
            <header class="apps-dialog-header">
                <span class="apps-dialog-mark" aria-hidden="true">⏏</span>
                <h2 id="uninstall-title">Uninstall @_pending.App.Name?</h2>
            </header>

            <div class="apps-dialog-body">
                @if (_pending.UninstallClosure.Count > 1)
                {
                    <p>These apps need it and will be uninstalled too:</p>
                    <ul class="closure-list">
                        @foreach (string dependentId in _pending.UninstallClosure.Where(id => id != _pending.App.Id))
                        {
                            <li>@NameOf(dependentId)</li>
                        }
                    </ul>
                }

                <p>Running windows are closed. Settings and files are kept.</p>

                @foreach (string siteId in WebSitesIn(_pending.UninstallClosure))
                {
                    <p class="apps-site-data">
                        The website data of @NameOf(siteId) (its browser database <code>hackweb.@siteId</code>) is deleted:
                        it is not in your files and cannot come back with a reinstall.
                    </p>
                }

                @if (IsAdministrator && _scope == HackInstallScope.Machine)
                {
                    <p>The system will ask an administrator to authenticate.</p>
                }

                @if (IsAdministrator)
                {
                    <div class="scope-options" role="radiogroup" aria-label="Uninstall for">
                        <button type="button" role="radio"
                                aria-checked="@(_scope == HackInstallScope.User ? "true" : "false")"
                                class="@ScopeClass(HackInstallScope.User)"
                                @onclick="() => _scope = HackInstallScope.User">
                            Only for me
                        </button>
                        <button type="button" role="radio"
                                aria-checked="@(_scope == HackInstallScope.Machine ? "true" : "false")"
                                class="@ScopeClass(HackInstallScope.Machine)"
                                @onclick="() => _scope = HackInstallScope.Machine">
                            For all users
                        </button>
                    </div>
                }
                else
                {
                    <p>This uninstalls it for you only.</p>
                }

                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="apps-message" role="alert">@_message</p>
                }
            </div>

            <footer class="apps-dialog-footer">
                <button type="button" class="apps-btn" disabled="@_isBusy" @onclick="CancelUninstall">Cancel</button>
                <button type="button" class="apps-btn apps-btn-danger" disabled="@_isBusy" @onclick="ConfirmUninstallAsync">
                    @(_isBusy ? "Uninstalling..." : "Uninstall")
                </button>
            </footer>
        </div>
    </div>
}

@code {
    /// <summary>One app line: identity, badge, and the one action its state allows.</summary>
    private RenderFragment Row(HackAppInstallInfo entry) => __builder =>
    {
        HackAppInfo app = entry.App;
        <div class="app-row @RowClass(entry)" role="listitem">
            <div class="app-identity">
                <span class="app-name">@app.Name</span>
                <span class="app-meta">@app.PublisherId · v@(app.Version)</span>
                @if (entry.Problem is { } problem)
                {
                    <span class="app-problem">@problem</span>
                }
            </div>
            <div class="app-actions">
                @if (entry.State == HackAppInstallState.Incompatible)
                {
                    <span class="app-badge app-badge-incompatible" title="This app was built for another version of the App SDK and cannot run">Incompatible</span>
                }
                else if (entry.State == HackAppInstallState.Damaged)
                {
                    <span class="app-badge app-badge-damaged" title="A file of this app does not match its manifest">Damaged</span>
                }
                else if (app.IsSystemApp)
                {
                    <span class="app-badge app-badge-system" title="System apps cannot be uninstalled">System</span>
                }
                else
                {
                    @switch (entry.State)
                    {
                        case HackAppInstallState.Installed:
                            <button type="button" class="apps-btn apps-btn-danger" disabled="@_isBusy" @onclick="() => AskUninstall(entry)">Uninstall</button>
                            break;
                        case HackAppInstallState.UninstalledForMachine when !IsAdministrator:
                            <span class="app-badge app-badge-locked">Uninstalled by the administrator</span>
                            break;
                        default:
                            <span class="app-badge">@(entry.State == HackAppInstallState.UninstalledForMachine ? "Uninstalled for all users" : "Uninstalled")</span>
                            <button type="button" class="apps-btn" disabled="@_isBusy" @onclick="() => ReinstallAsync(entry)">Reinstall</button>
                            break;
                    }
                }
            </div>
        </div>
    };
}
