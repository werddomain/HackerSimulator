@using HackerOs.App.Abstractions
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Blazor
@using HackerOs.Theming.Abstractions
@using HackerOs.Theming.Blazor
@using HackerOs.Simulation.Abstractions.Settings
@using MudBlazor
@inherits WindowAppBase

<div class="settings-window-container">
    <header class="settings-header">
        <span class="settings-header-title">HackerOS System Settings</span>
    </header>

    <div class="settings-body">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="settings-tabs" TabHeaderClass="hos-tab-header">
            <MudTabPanel Text="Appearance" Icon="@Icons.Material.Filled.Palette">
                <div class="setting-group layer-picker">
                    <h4>Apply changes to</h4>
                    <p class="setting-desc">
                        Your choices are saved in <code>~/.config/hackeros/appearance.config</code>.
                        The default for every user lives in <code>/etc/hackeros/appearance.config</code> and needs administrator approval.
                    </p>
                    <div class="layer-options" role="radiogroup" aria-label="Settings layer">
                        <button type="button" role="radio" class="@LayerOptionClass(SettingLayer.User)"
                                aria-checked="@(_targetLayer == SettingLayer.User)"
                                @onclick="() => SelectLayer(SettingLayer.User)">Only me</button>
                        <button type="button" role="radio" class="@LayerOptionClass(SettingLayer.System)"
                                aria-checked="@(_targetLayer == SettingLayer.System)"
                                @onclick="() => SelectLayer(SettingLayer.System)">All users (system default)</button>
                    </div>
                    @if (_targetLayer == SettingLayer.System)
                    {
                        <button type="button" class="btn-secondary" disabled="@_isSavingAppearance" @onclick="ApplyCurrentAsSystemDefaultAsync">
                            Save the current look as the system default
                        </button>
                    }
                    @if (!string.IsNullOrEmpty(_appearanceMessage))
                    {
                        <div class="layer-message" role="status">@_appearanceMessage</div>
                    }
                </div>
                <div class="setting-group">
                    <h4>Desktop theme <SettingOriginBadge Source="@SourceOf(DesktopThemeKey)" IsLocked="@IsLocked(DesktopThemeKey)" /></h4>
                    <p class="setting-desc">Applied to the desktop, windows, taskbar, and Start menu.</p>
                    <div class="theme-options" aria-label="Desktop themes">
                        @foreach (ThemeDefinition theme in ThemeCatalog.DesktopThemes)
                        {
                            <button type="button"
                                    class="@ThemeOptionClass(theme.Id, _appearanceSettings.DesktopThemeId)"
                                    aria-pressed="@(theme.Id == _appearanceSettings.DesktopThemeId)"
                                    disabled="@IsBlocked(DesktopThemeKey)"
                                    @onclick="() => ChangeDesktopTheme(theme.Id)">
                                <ThemePreview ThemeId="@theme.Id"
                                              AccentId="@_appearanceSettings.AccentId"
                                              AnimationsEnabled="@_appearanceSettings.AnimationsEnabled" />
                                <span class="theme-option-label">@theme.DisplayName</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="setting-group">
                    <h4>Mobile theme <SettingOriginBadge Source="@SourceOf(MobileThemeKey)" IsLocked="@IsLocked(MobileThemeKey)" /></h4>
                    <p class="setting-desc">Saved independently and applied when the mobile shell is active.</p>
                    <div class="theme-options mobile-theme-options" aria-label="Mobile themes">
                        @foreach (ThemeDefinition theme in ThemeCatalog.MobileThemes)
                        {
                            <button type="button"
                                    class="@ThemeOptionClass(theme.Id, _appearanceSettings.MobileThemeId)"
                                    aria-pressed="@(theme.Id == _appearanceSettings.MobileThemeId)"
                                    disabled="@IsBlocked(MobileThemeKey)"
                                    @onclick="() => ChangeMobileTheme(theme.Id)">
                                <ThemePreview ThemeId="@theme.Id"
                                              AccentId="@_appearanceSettings.AccentId"
                                              AnimationsEnabled="@_appearanceSettings.AnimationsEnabled" />
                                <span class="theme-option-label">@theme.DisplayName</span>
                            </button>
                        }
                    </div>
                </div>
                @if (CurrentDesktopThemeSupportsAccent)
                {
                    <div class="setting-group">
                        <h4>HackerOS accent <SettingOriginBadge Source="@SourceOf(AccentKey)" IsLocked="@IsLocked(AccentKey)" /></h4>
                        <p class="setting-desc">Accent colors are intentionally available only for the HackerOS theme.</p>
                        <div class="accent-options" aria-label="HackerOS accent colors">
                            @foreach (string accentId in ThemeCatalog.AccentIds)
                            {
                                <button type="button"
                                        class="@AccentOptionClass(accentId)"
                                        aria-pressed="@(accentId == _appearanceSettings.AccentId)"
                                        disabled="@IsBlocked(AccentKey)"
                                        @onclick="() => ChangeAccent(accentId)">
                                    <span class="accent-swatch" aria-hidden="true"></span>
                                    @accentId
                                </button>
                            }
                        </div>
                    </div>
                }
                <div class="setting-group">
                    <h4>Animations <SettingOriginBadge Source="@SourceOf(AnimationsKey)" IsLocked="@IsLocked(AnimationsKey)" /></h4>
                    <MudSwitch T="bool" Value="@_appearanceSettings.AnimationsEnabled" ValueChanged="ToggleAnimations" Color="Color.Primary"
                               Disabled="@IsBlocked(AnimationsKey)"
                               Label="Enable desktop transitions and micro-animations" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="File Associations" Icon="@Icons.Material.Filled.Extension">
                <div class="setting-group">
                    <h4>File Association Policy</h4>
                    <p class="setting-desc">Default applications per extension, from installed apps' declared file handlers.</p>
                    <div class="associations-list">
                        @if (_fileHandlers.Count == 0)
                        {
                            <div class="assoc-row"><span>No file handlers are currently registered.</span></div>
                        }
                        else
                        {
                            @foreach ((string extension, string appName) in _fileHandlers)
                            {
                                <div class="assoc-row"><span>@extension</span> <strong>@appName</strong></div>
                            }
                        }
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Capability Grants" Icon="@Icons.Material.Filled.Security">
                <div class="setting-group">
                    <h4>Granted Application Capabilities</h4>
                    <p class="setting-desc">Active security grants for current session.</p>
                    <div class="grants-list">
                        @foreach (string cap in Manifest.Capabilities)
                        {
                            <div class="grant-tag">✓ @cap</div>
                        }
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Permissions" Icon="@Icons.Material.Filled.AdminPanelSettings">
                <AppPermissionsPanel AppContext="AppContext" />
            </MudTabPanel>

            <MudTabPanel Text="Installed Apps" Icon="@Icons.Material.Filled.Apps">
                <InstalledAppsPanel AppContext="@AppContext" />
            </MudTabPanel>

            <MudTabPanel Text="Server Connection" Icon="@Icons.Material.Filled.Cloud">
                <div class="setting-group">
                    <h4>Optional Server</h4>
                    <p class="setting-desc">
                        Connecting a device to an optional HackerOS server enables real network
                        access for apps like Terminal's <code>curl</code>/<code>ping</code>. Local
                        storage remains the source of truth either way — connecting is never
                        required for normal use.
                    </p>

                    @if (_connectionState.IsConnected)
                    {
                        <div class="server-connection-status connected">
                            <div class="info-line"><span>Status:</span> <strong>Connected</strong></div>
                            <div class="info-line"><span>Server:</span> <strong>@_connectionState.ServerUrl</strong></div>
                            <div class="info-line"><span>Account:</span> <strong>@_connectionState.AccountId</strong></div>
                            @if (!string.IsNullOrEmpty(_syncStatusMessage))
                            {
                                <div class="info-line"><span>Sync:</span> <strong>@_syncStatusMessage</strong></div>
                            }
                            @if (_conflictCount > 0)
                            {
                                <div class="info-line sync-conflict-warning">
                                    <span>Files:</span>
                                    <strong>@_conflictCount file(s) have unresolved sync conflicts</strong>
                                </div>
                            }
                        </div>
                        <div class="server-connection-actions">
                            <button class="btn-secondary" disabled="@(_isConnecting || _isSyncing)" @onclick="SyncNowAsync">
                                @(_isSyncing ? "Syncing..." : "Sync now")
                            </button>
                            <button class="btn-danger" disabled="@_isConnecting" @onclick="DisconnectAsync">
                                Disconnect
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="server-connection-status disconnected">
                            <div class="info-line"><span>Status:</span> <strong>Not connected</strong></div>
                        </div>
                        <form class="server-connection-form" @onsubmit="() => ConnectAsync(createNewAccount: false)" @onsubmit:preventDefault>
                            <label for="server-url">Server URL</label>
                            <input id="server-url" type="url" placeholder="https://example.com" autocomplete="off"
                                   disabled="@_isConnecting" @bind="_serverUrl" @bind:event="oninput" />

                            <label for="server-username">Username</label>
                            <input id="server-username" type="text" autocomplete="username" maxlength="128"
                                   disabled="@_isConnecting" @bind="_username" @bind:event="oninput" />

                            <label for="server-password">Password</label>
                            <input id="server-password" type="password" autocomplete="current-password"
                                   disabled="@_isConnecting" @bind="_password" @bind:event="oninput" />

                            @if (!string.IsNullOrEmpty(_connectionErrorMessage))
                            {
                                <p class="dialog-error" role="alert">@_connectionErrorMessage</p>
                            }

                            <div class="server-connection-actions">
                                <button type="submit" class="btn-secondary" disabled="@(_isConnecting || !CanSubmitConnection)">
                                    @(_isConnecting ? "Connecting..." : "Log In")
                                </button>
                                <button type="button" class="btn-secondary" disabled="@(_isConnecting || !CanSubmitConnection)"
                                        @onclick="() => ConnectAsync(createNewAccount: true)">
                                    @(_isConnecting ? "Connecting..." : "Create Account")
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </MudTabPanel>

            <MudTabPanel Text="About System" Icon="@Icons.Material.Filled.Info">
                <div class="system-info-box">
                    <div class="info-line"><span>OS Version:</span> <strong>HackerOS 1.0 (Blazor WASM v3)</strong></div>
                    <div class="info-line"><span>Runtime:</span> <strong>.NET 10.0 WebAssembly</strong></div>
                    <div class="info-line"><span>Architecture:</span> <strong>C# Kernel / Scoped CSS / MudBlazor</strong></div>
                    <div class="info-line"><span>User ID:</span> <strong>@(AppContext?.UserId ?? "guest")</strong></div>
                    <div class="info-line"><span>Authority:</span> <strong>@(AppContext?.UserAuthority.ToString() ?? "User")</strong></div>
                </div>

                <div class="setting-group">
                    <h4>Restart</h4>
                    <p class="setting-desc">
                        Flush the logs, end every process and restart HackerOS, like <code>reboot</code>.
                        An administrator must confirm with their password.
                    </p>
                    <button class="btn-secondary" disabled="@_isRebooting" @onclick="RebootAsync">
                        @(_isRebooting ? "Restarting..." : "Restart HackerOS")
                    </button>
                    @if (!string.IsNullOrEmpty(_systemMessage))
                    {
                        <p class="dialog-error" role="alert">@_systemMessage</p>
                    }
                </div>

                <div class="setting-group danger-zone">
                    <h4>Danger Zone</h4>
                    <p class="setting-desc">
                        Reset HackerOS to its factory state. This permanently clears the local database
                        — all accounts, files, sessions, and settings — and restores your account
                        to its default configuration. This action cannot be undone. An administrator
                        must confirm with their password.
                    </p>
                    <button class="btn-danger" @onclick="OpenResetDialog">
                        Reset to Factory Settings
                    </button>
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>

    @if (_isResetDialogOpen)
    {
        <div class="modal-backdrop" @onclick="CancelReset">
            <div class="reset-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="reset-title"
                 @onclick:stopPropagation>
                <header class="dialog-header">
                    <div class="reset-mark" aria-hidden="true">⚠</div>
                    <h2 id="reset-title">Reset to Factory Settings</h2>
                </header>

                <div class="dialog-body">
                    <p>
                        This will permanently delete the entire local HackerOS database, including:
                    </p>
                    <ul class="reset-affected-list">
                        <li>All local user accounts and sessions</li>
                        <li>All files and folders</li>
                        <li>All application and account settings (restored to defaults)</li>
                        <li>All capability grants and audit history</li>
                    </ul>
                    <p>HackerOS will restart afterward as if freshly installed.</p>

                    <label class="confirm-label" for="reset-confirm-input">
                        Type <strong>RESET</strong> to confirm:
                    </label>
                    <input id="reset-confirm-input"
                           class="confirm-input"
                           type="text"
                           autocomplete="off"
                           disabled="@_isResetting"
                           @bind="_confirmText"
                           @bind:event="oninput" />

                    @if (!string.IsNullOrEmpty(_resetErrorMessage))
                    {
                        <p class="dialog-error" role="alert">@_resetErrorMessage</p>
                    }
                </div>

                <footer class="dialog-footer">
                    <button type="button"
                            class="btn-secondary"
                            disabled="@_isResetting"
                            @onclick="CancelReset">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn-danger"
                            disabled="@(_isResetting || !IsConfirmed)"
                            @onclick="ConfirmResetAsync">
                        @(_isResetting ? "Resetting..." : "Reset to Factory Settings")
                    </button>
                </footer>
            </div>
        </div>
    }
</div>
