@using HackerOs.App.Abstractions
@using HackerOs.AppSdk
@using HackerOs.AppSdk.Blazor
@using HackerOs.Infrastructure.Browser.Schema
@using HackerOs.Platform.Core
@using Microsoft.JSInterop
@using MudBlazor
@inherits WindowAppBase
@implements IAsyncDisposable
@inject AppCatalog Catalog
@inject IJSRuntime JS

<div class="settings-window-container">
    <header class="settings-header">
        <span class="settings-header-title">HackerOS System Settings</span>
    </header>

    <div class="settings-body">
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="settings-tabs">
            <MudTabPanel Text="Appearance" Icon="@Icons.Material.Filled.Palette">
                <div class="setting-group">
                    <h4>Color Theme</h4>
                    <p class="setting-desc">Select modern gothic system accent color token.</p>
                    <div class="accent-options">
                        <button class="accent-btn accent-green" @onclick='() => ChangeAccent("green")'>Green</button>
                        <button class="accent-btn accent-cyan" @onclick='() => ChangeAccent("cyan")'>Cyan</button>
                        <button class="accent-btn accent-purple" @onclick='() => ChangeAccent("purple")'>Purple</button>
                    </div>
                </div>
                <div class="setting-group">
                    <h4>Animations</h4>
                    <MudSwitch T="bool" Value="@_animationsEnabled" ValueChanged="ToggleAnimations" Color="Color.Primary" Label="Enable desktop transitions and micro-animations" />
                </div>
            </MudTabPanel>

            <MudTabPanel Text="File Associations" Icon="@Icons.Material.Filled.Extension">
                <div class="setting-group">
                    <h4>File Association Policy</h4>
                    <p class="setting-desc">Default applications per extension, from installed apps' declared file handlers.</p>
                    <div class="associations-list">
                        @if (_fileHandlers.Count == 0)
                        {
                            <div class="assoc-row"><span>No file handlers are currently registered.</span></div>
                        }
                        else
                        {
                            @foreach ((string extension, string appName) in _fileHandlers)
                            {
                                <div class="assoc-row"><span>@extension</span> <strong>@appName</strong></div>
                            }
                        }
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="Capability Grants" Icon="@Icons.Material.Filled.Security">
                <div class="setting-group">
                    <h4>Granted Application Capabilities</h4>
                    <p class="setting-desc">Active security grants for current session.</p>
                    <div class="grants-list">
                        @foreach (string cap in Manifest.Capabilities)
                        {
                            <div class="grant-tag">✓ @cap</div>
                        }
                    </div>
                </div>
            </MudTabPanel>

            <MudTabPanel Text="About System" Icon="@Icons.Material.Filled.Info">
                <div class="system-info-box">
                    <div class="info-line"><span>OS Version:</span> <strong>HackerOS 1.0 (Blazor WASM v3)</strong></div>
                    <div class="info-line"><span>Runtime:</span> <strong>.NET 10.0 WebAssembly</strong></div>
                    <div class="info-line"><span>Architecture:</span> <strong>C# Kernel / Scoped CSS / MudBlazor</strong></div>
                    <div class="info-line"><span>User ID:</span> <strong>@(AppContext?.UserId ?? "guest")</strong></div>
                    <div class="info-line"><span>Authority:</span> <strong>@(AppContext?.UserAuthority.ToString() ?? "User")</strong></div>
                </div>

                <div class="setting-group danger-zone">
                    <h4>Danger Zone</h4>
                    <p class="setting-desc">
                        Reset HackerOS to its factory state. This permanently clears the local IndexedDB
                        database — all accounts, files, sessions, and settings — and restores your account
                        to its default configuration. This action cannot be undone.
                    </p>
                    <button class="btn-danger" @onclick="OpenResetDialog">
                        Reset to Factory Settings
                    </button>
                </div>
            </MudTabPanel>
        </MudTabs>
    </div>

    @if (_isResetDialogOpen)
    {
        <div class="modal-backdrop" @onclick="CancelReset">
            <div class="reset-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="reset-title"
                 @onclick:stopPropagation>
                <header class="dialog-header">
                    <div class="reset-mark" aria-hidden="true">⚠</div>
                    <h2 id="reset-title">Reset to Factory Settings</h2>
                </header>

                <div class="dialog-body">
                    <p>
                        This will permanently delete the entire local <code>@HackerOsIndexedDbSchema.DatabaseName</code>
                        IndexedDB database, including:
                    </p>
                    <ul class="reset-affected-list">
                        <li>All local user accounts and sessions</li>
                        <li>All files and folders</li>
                        <li>All application and account settings (restored to defaults)</li>
                        <li>All capability grants and audit history</li>
                    </ul>
                    <p>HackerOS will reload afterward as if freshly installed.</p>

                    <label class="confirm-label" for="reset-confirm-input">
                        Type <strong>RESET</strong> to confirm:
                    </label>
                    <input id="reset-confirm-input"
                           class="confirm-input"
                           type="text"
                           autocomplete="off"
                           disabled="@_isResetting"
                           @bind="_confirmText"
                           @bind:event="oninput" />

                    @if (!string.IsNullOrEmpty(_resetErrorMessage))
                    {
                        <p class="dialog-error" role="alert">@_resetErrorMessage</p>
                    }
                </div>

                <footer class="dialog-footer">
                    <button type="button"
                            class="btn-secondary"
                            disabled="@_isResetting"
                            @onclick="CancelReset">
                        Cancel
                    </button>
                    <button type="button"
                            class="btn-danger"
                            disabled="@(_isResetting || !IsConfirmed)"
                            @onclick="ConfirmResetAsync">
                        @(_isResetting ? "Resetting..." : "Reset to Factory Settings")
                    </button>
                </footer>
            </div>
        </div>
    }
</div>

@code {
    public static AppManifest StaticManifest { get; } = new()
    {
        SchemaVersion = 1,
        Id = "org.hackeros.settings",
        Name = "Settings",
        Version = "1.0.0",
        PublisherId = "pub.hackeros",
        Description = "System control panel for user preferences, appearance, file associations, capabilities, and device configuration",
        Kind = AppKind.Window,
        EntryPoint = new AppEntryPointManifest("HackerOs.Apps.Settings.dll", "HackerOs.Apps.Settings.SettingsWindow"),
        SdkCompatibility = new AppSdkCompatibilityManifest("1.0.0"),
        Presentation = new PresentationManifest("system", AppLaunchVisibility.Visible, []),
        Capabilities = ["settings.read", "settings.write", "settings.system.read", "settings.system.write", "file-associations.read", "file-associations.write", "process.list"],
        Resources = AppResourceProfileManifest.None,
        SingleInstancePerUser = true
    };

    private const string ResetConfirmPhrase = "RESET";

    private bool _animationsEnabled = true;
    private string _activeAccent = "green";
    private AppearancePersistenceService? _appearance;
    private IJSObjectReference? _module;
    private List<(string Extension, string AppName)> _fileHandlers = [];

    private bool _isResetDialogOpen;
    private bool _isResetting;
    private string _confirmText = string.Empty;
    private string? _resetErrorMessage;

    private bool IsConfirmed => string.Equals(_confirmText, ResetConfirmPhrase, StringComparison.Ordinal);

    protected override async Task OnAppInitializedAsync()
    {
        _appearance = new AppearancePersistenceService(AppContext.Settings);
        AppearanceSettings current = await _appearance.ReadAsync(AppContext.CancellationToken);
        _activeAccent = current.Accent;
        _animationsEnabled = current.AnimationsEnabled;

        _fileHandlers = [.. Catalog.Manifests.Values
            .SelectMany(manifest => manifest.FileHandlers.SelectMany(handler =>
                handler.Extensions.Select(extension => (Extension: extension, AppName: manifest.Name))))
            .OrderBy(entry => entry.Extension, StringComparer.OrdinalIgnoreCase)];
    }

    protected override async Task OnAppAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HackerOs.Apps.Settings/SettingsWindow.razor.js");
                await _module.InvokeVoidAsync("applyAccent", _activeAccent);
                await _module.InvokeVoidAsync("applyAnimations", _animationsEnabled);
            }
            catch (Exception)
            {
                // Headless test DOM and unavailable-JS fallback: preferences still persist,
                // just without a live visual application in this environment.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    private async Task ChangeAccent(string accent)
    {
        string previous = _activeAccent;
        _activeAccent = accent;
        StateHasChanged();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("applyAccent", accent);
        }

        if (_appearance is null || !await _appearance.WriteAsync(accent, _animationsEnabled, AppContext.CancellationToken))
        {
            _activeAccent = previous;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("applyAccent", previous);
            }
            StateHasChanged();
        }
    }

    private async Task ToggleAnimations(bool value)
    {
        bool previous = _animationsEnabled;
        _animationsEnabled = value;
        StateHasChanged();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync("applyAnimations", value);
        }

        if (_appearance is null || !await _appearance.WriteAsync(_activeAccent, value, AppContext.CancellationToken))
        {
            _animationsEnabled = previous;
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("applyAnimations", previous);
            }
            StateHasChanged();
        }
    }

    private void OpenResetDialog()
    {
        _isResetDialogOpen = true;
        _confirmText = string.Empty;
        _resetErrorMessage = null;
    }

    private void CancelReset()
    {
        if (_isResetting)
        {
            return;
        }

        _isResetDialogOpen = false;
        _confirmText = string.Empty;
        _resetErrorMessage = null;
    }

    private async Task ConfirmResetAsync()
    {
        if (!IsConfirmed || _isResetting)
        {
            return;
        }

        _isResetting = true;
        _resetErrorMessage = null;

        try
        {
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/HackerOs.Infrastructure.Browser/indexedDb.js");
            await module.InvokeVoidAsync("deleteDatabase", HackerOsIndexedDbSchema.DatabaseName);

            await JS.InvokeVoidAsync("location.reload");
        }
        catch (Exception ex)
        {
            _resetErrorMessage = $"Reset failed: {ex.Message}";
            _isResetting = false;
        }
    }
}
