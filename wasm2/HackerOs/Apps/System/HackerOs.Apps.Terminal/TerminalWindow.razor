@using HackerOs.AppSdk.Blazor
@using HackerOs.AppSdk.Terminal
@inherits WindowAppBase

@*
    Thin host around the reusable Terminal control (Shared/HackerOs.AppSdk.Terminal) — session, shell
    parsing, command execution, and rendering all live there so other apps (e.g. CodeEditor) can embed
    a terminal too. This window only supplies its own AppContext and caller id.
*@
<TerminalPanel AppContext="AppContext" CallerAppId="org.hackeros.terminal" />
