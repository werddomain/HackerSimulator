{
  "schemaVersion": 1,
  "id": "org.hackeros.terminal",
  "name": "Terminal",
  "version": "1.0.0",
  "publisherId": "pub.hackeros",
  "description": "Command line interface and interactive shell for HackerOS",
  "kind": "window",
  "entryPoint": {
    "assembly": "HackerOs.Apps.Terminal.dll",
    "type": "HackerOs.Apps.Terminal.TerminalWindow"
  },
  "sdkCompatibility": {
    "minimumVersion": "1.0.0"
  },
  "presentation": {
    "category": "utilities",
    "launchVisibility": "visible",
    "iconAssetPaths": []
  },
  "capabilities": [
    "apps.launch",
    "filesystem.user-home.read",
    "filesystem.user-home.write",
    "process.list",
    "process.manage",
    "notifications.post",
    "settings.read",
    "settings.write"
  ],
  "resources": {
    "baselineCpuWeight": 0.05,
    "burstCpuWeight": 0.3,
    "baselineMemoryWeight": 0.05,
    "burstMemoryWeight": 0.2,
    "baselineStorageIoWeight": 0.02,
    "burstStorageIoWeight": 0.1,
    "baselineNetworkIoWeight": 0.0,
    "burstNetworkIoWeight": 0.0
  },
  "singleInstancePerUser": true
}
