{
  "schemaVersion": 1,
  "id": "org.hackeros.error-log-viewer",
  "name": "Error Log Viewer",
  "version": "1.0.0",
  "publisherId": "pub.hackeros",
  "description": "System diagnostic error log viewer, stack trace inspector, and event log manager",
  "kind": "window",
  "entryPoint": {
    "assembly": "HackerOs.Apps.ErrorLogViewer.dll",
    "type": "HackerOs.Apps.ErrorLogViewer.ErrorLogViewerWindow"
  },
  "sdkCompatibility": {
    "minimumVersion": "1.0.0"
  },
  "presentation": {
    "category": "system",
    "launchVisibility": "visible",
    "iconAssetPaths": []
  },
  "capabilities": [
    "settings.system.read",
    "process.list"
  ],
  "resources": {
    "baselineCpuWeight": 0.02,
    "burstCpuWeight": 0.1,
    "baselineMemoryWeight": 0.05,
    "burstMemoryWeight": 0.1,
    "baselineStorageIoWeight": 0.0,
    "burstStorageIoWeight": 0.0,
    "baselineNetworkIoWeight": 0.0,
    "burstNetworkIoWeight": 0.0
  },
  "singleInstancePerUser": true
}
