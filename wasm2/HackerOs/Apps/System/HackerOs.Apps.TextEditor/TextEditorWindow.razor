@using HackerOs.App.Abstractions
@using HackerOs.AppSdk.Blazor
@using HackerOs.Simulation.Abstractions.FileSystem
@using HackerOs.Simulation.Abstractions.Gateways
@using HackerOs.Simulation.Abstractions.Sessions
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MudBlazor
@inherits WindowAppBase
@implements IAsyncDisposable
@inject MudBlazor.IDialogService MudDialogService
@inject ISessionService SessionService
@inject IJSRuntime JavaScript

<div class="editor-container" @ref="_editorContainerRef" @onkeydown="HandleGlobalKeyDownAsync" tabindex="0">
    <!-- Menu Bar -->
    <nav class="editor-menubar" aria-label="Text editor menu">
        <div class="menu-group">
            <span class="menu-label">File</span>
            <div class="menu-dropdown">
                <button class="menu-item" id="btn-new" @onclick="NewDocumentAsync">New</button>
                <button class="menu-item" id="btn-open" @onclick="OpenFileAsync">Open...</button>
                <button class="menu-item" id="btn-save" @onclick="SaveAsync" disabled="@(!_doc.IsDirty)">Save</button>
                <button class="menu-item" id="btn-save-as" @onclick="SaveAsAsync">Save As...</button>
            </div>
        </div>
        <div class="menu-group">
            <span class="menu-label">Edit</span>
            <div class="menu-dropdown">
                <button class="menu-item" id="btn-find" @onclick="ToggleFindBar">Find (Ctrl+F)</button>
            </div>
        </div>
        <div class="editor-title-display">
            @_doc.GetWindowTitle()
            @if (_doc.LoadState == TextEditorLoadState.Error)
            {
                <span class="title-error"> ⚠</span>
            }
        </div>
    </nav>

    <!-- Find Bar (P2-TEXT-006) -->
    @if (_showFindBar)
    {
        <div class="find-bar" role="search" aria-label="Find in document">
            <input id="find-input"
                   type="text"
                   class="find-input"
                   placeholder="Search…"
                   value="@_findQuery"
                   @oninput="HandleFindQueryChangedAsync"
                   @onkeydown="HandleFindKeyDown"
                   aria-label="Search text" />
            <span class="find-match-count">@FindMatchSummary</span>
            <button class="find-nav-btn" id="btn-find-prev" @onclick="FindPrev" title="Previous match (Shift+Enter)">↑</button>
            <button class="find-nav-btn" id="btn-find-next" @onclick="FindNext" title="Next match (Enter)">↓</button>
            <button class="find-close-btn" id="btn-find-close" @onclick="ToggleFindBar" aria-label="Close find bar">✕</button>
        </div>
    }

    <!-- Loading / Error Overlay -->
    @if (_doc.LoadState == TextEditorLoadState.Loading)
    {
        <div class="overlay-state" role="status">Loading file…</div>
    }
    else if (_doc.LoadState == TextEditorLoadState.Error)
    {
        <div class="overlay-error" role="alert">
            <span>@_doc.ErrorMessage</span>
            <button class="retry-btn" id="btn-retry" @onclick="ReloadCurrentFileAsync">Retry</button>
        </div>
    }
    else
    {
        <!-- Text Area (P2-TEXT-002, P2-TEXT-003) -->
        <textarea id="editor-textarea"
                  class="editor-textarea"
                  aria-label="Document content editor"
                  spellcheck="false"
                  value="@_doc.Content"
                  @oninput="HandleTextInput"
                  @ref="_textAreaRef"
                  disabled="@(_doc.LoadState == TextEditorLoadState.Loading)">
        </textarea>
    }

    <!-- Status Bar -->
    <div class="editor-statusbar" aria-label="Editor status bar">
        <span class="status-path">@(_doc.Path?.ToString() ?? "New document")</span>
        <span class="status-sep">|</span>
        <span class="status-media">@_doc.MediaType</span>
        @if (_conflictDetected)
        {
            <span class="status-conflict" role="alert">⚡ Conflict detected – please Save As</span>
        }
    </div>

    <!-- Dirty-close Confirmation Dialog (rendered inline via Mud) -->
</div>

@code {
    private readonly TextEditorDocument _doc = new();
    private ElementReference _editorContainerRef;
    private ElementReference _textAreaRef;
    private bool _showFindBar = false;
    private string _findQuery = string.Empty;
    private int _findIndex = -1;
    private bool _conflictDetected = false;
    private IJSObjectReference? _module;

    // The filesystem gateway used for the current document. Defaults to the app's
    // capability-scoped gateway (home directory only). When the user picks a file or
    // destination outside that scope via the Open/Save dialogs, this is replaced with
    // a gateway carrying the handle issued for that specific resource, so subsequent
    // reads/writes to the same path stay authorized (P2-TEXT-003).
    private IAppFileSystemGateway _fileSystem = default!;

    /// <summary>
    /// Optional initial file path. When supplied by the window host (e.g. via an
    /// open/edit file intent), the editor loads that file immediately on startup (P2-TEXT-002).
    /// </summary>
    [Parameter]
    public string? LaunchFilePath { get; set; }

    // Supported editable extensions (P2-TEXT-001 MIME review).
    private static readonly IReadOnlySet<string> EditableExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
    {
        ".txt", ".log", ".conf", ".json", ".md"
    };

    // Max file size for text editor: 512 KiB (P2-TEXT-002)
    private const int MaxTextFileSizeBytes = 512 * 1024;

    // ──────────────────────────── Blazor lifecycle ────────────────────────────────

    protected override async Task OnAppInitializedAsync()
    {
        _fileSystem = AppContext.FileSystem;

        // Accept open/edit intent file paths passed by the window host (P2-TEXT-002)
        if (!string.IsNullOrWhiteSpace(LaunchFilePath))
        {
            await LoadFileAsync(VirtualPath.Parse(LaunchFilePath));
        }
    }

    protected override async Task OnAppAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JavaScript.InvokeAsync<IJSObjectReference>(
                    "import", "./_content/HackerOs.Apps.TextEditor/TextEditorWindow.razor.js");
            }
            catch (Exception)
            {
                // Headless test DOM and unavailable-JS fallback: find still works, just without
                // visual selection/scroll.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }

    // ──────────────────────────── File operations ─────────────────────────────────

    /// <summary>
    /// Opens a new empty buffer, prompting the user to save if the current buffer is
    /// dirty (P2-TEXT-004).
    /// </summary>
    private async Task NewDocumentAsync()
    {
        if (!await ConfirmDiscardDirtyAsync()) return;
        _doc.ResetToNew();
        _fileSystem = AppContext.FileSystem;
        _conflictDetected = false;
        StateHasChanged();
    }

    private string GetParentDirectory(VirtualPath? path)
    {
        if (path is { } p)
        {
            string val = p.Value;
            int lastSlash = val.LastIndexOf('/');
            if (lastSlash > 0)
            {
                return val[..lastSlash];
            }
        }

        return SessionService.CurrentPrincipal?.HomePath ?? $"/home/{AppContext.UserId}";
    }

    /// <summary>
    /// Displays the standard file-open dialog and loads the selected file (P2-TEXT-003).
    /// </summary>
    private async Task OpenFileAsync()
    {
        if (!await ConfirmDiscardDirtyAsync()) return;

        string defaultDir = GetParentDirectory(_doc.Path);
        OpenFileDialogResult result = await base.OpenFileAsync(new OpenFileDialogRequest
        {
            Title = "Open Text File",
            InitialDirectory = VirtualPath.Parse(defaultDir),
            Filters =
            [
                new FileDialogFilter("Text files", [".txt", ".log", ".conf", ".json", ".md"],
                    ["text/plain", "application/json", "text/markdown"]),
                new FileDialogFilter("All files", [], [])
            ],
            RequestedAccess = SelectedFileAccess.ReadWrite
        });

        if (result.Status == FileDialogStatus.Selected && result.Resources.Count > 0)
        {
            SelectedFileResource selected = result.Resources[0];
            _fileSystem = AppContext.FileSystem.WithSelectedHandle(selected.Handle);
            await LoadFileAsync(selected.Path);
        }
    }

    /// <summary>
    /// Loads a virtual file by path, validating its type and size before accepting content (P2-TEXT-002).
    /// </summary>
    private async Task LoadFileAsync(VirtualPath path)
    {
        // Reject unsupported extensions
        string fileName = path.ToString();
        int dot = fileName.LastIndexOf('.');
        string ext = dot >= 0 ? fileName[dot..] : string.Empty;
        if (!EditableExtensions.Contains(ext) && !string.IsNullOrEmpty(ext))
        {
            _doc.BeginLoading(path);
            _doc.FailLoading($"Unsupported file type '{ext}'. Text Editor only opens: {string.Join(", ", EditableExtensions)}.");
            StateHasChanged();
            return;
        }

        _doc.BeginLoading(path);
        StateHasChanged();

        try
        {
            FileSystemResult<FileSystemContentReadHandle> result = await _fileSystem.ReadAsync(
                new FileSystemReadRequest(path), AppContext.CancellationToken);

            if (!result.Succeeded || result.Value is null)
            {
                string reason = result.Error?.Code switch
                {
                    FileSystemErrorCode.PermissionDenied => "Permission denied.",
                    FileSystemErrorCode.NotFound => "File not found.",
                    FileSystemErrorCode.NotFile => "Path is not a regular file.",
                    _ => result.Error?.Code.ToString() ?? "Unknown read error."
                };
                _doc.FailLoading(reason);
                StateHasChanged();
                return;
            }

            await using FileSystemContentReadHandle handle = result.Value;

            // Reject binary content (P2-TEXT-002)
            if (handle.Descriptor.Kind == FileSystemContentKind.Binary)
            {
                _doc.FailLoading("Binary files are not supported by Text Editor.");
                StateHasChanged();
                return;
            }

            // Guard against oversized files (P2-TEXT-002)
            if (handle.Entry.Metadata is FileMetadata fm && fm.Length > MaxTextFileSizeBytes)
            {
                _doc.FailLoading($"File is too large ({fm.Length / 1024} KiB). Text Editor supports up to {MaxTextFileSizeBytes / 1024} KiB.");
                StateHasChanged();
                return;
            }

            using StreamReader reader = new(handle.Content, leaveOpen: true);
            string content = await reader.ReadToEndAsync(AppContext.CancellationToken);

            _doc.CompleteLoading(content, handle.Descriptor.MediaType, handle.Entry.Metadata.Revision);
            _conflictDetected = false;
        }
        catch (OperationCanceledException)
        {
            _doc.FailLoading("Load cancelled.");
        }
        catch (Exception ex)
        {
            _doc.FailLoading($"Unexpected error: {ex.Message}");
        }

        StateHasChanged();
    }

    /// <summary>
    /// Saves the current buffer to its existing path, or falls back to Save As for new buffers (P2-TEXT-003).
    /// </summary>
    private async Task SaveAsync()
    {
        if (_doc.Path is { } path)
        {
            await WriteToDiskAsync(path);
        }
        else
        {
            await SaveAsAsync();
        }
    }

    /// <summary>
    /// Displays the file-save dialog and writes the buffer to the chosen path (P2-TEXT-003).
    /// </summary>
    private async Task SaveAsAsync()
    {
        string defaultDir = GetParentDirectory(_doc.Path);
        
        SaveFileDialogResult result = await base.SaveFileAsync(new SaveFileDialogRequest
        {
            Title = "Save Text File",
            InitialDirectory = VirtualPath.Parse(defaultDir),
            SuggestedFileName = _doc.Title != "Untitled" ? _doc.Title : "untitled.txt",
            DefaultExtension = ".txt",
            Filters =
            [
                new FileDialogFilter("Text files", [".txt", ".log", ".conf", ".json", ".md"],
                    ["text/plain", "application/json", "text/markdown"]),
                new FileDialogFilter("All files", [], [])
            ],
            ConfirmOverwrite = true
        });

        if (result.Status == FileDialogStatus.Selected && result.Resource is not null)
        {
            _fileSystem = AppContext.FileSystem.WithSelectedHandle(result.Resource.Handle);
            await WriteToDiskAsync(result.Resource.Path);
        }
    }

    /// <summary>
    /// Writes the current document content to a virtual path using an optimistic
    /// revision check. Detects concurrent conflicts and surfaces them to the user (P2-TEXT-003, P2-TEXT-004).
    /// </summary>
    private async Task WriteToDiskAsync(VirtualPath path)
    {
        _suppressGenericPermissionNotice = true;
        try
        {
            long? expectedRevision = _doc.LoadedRevision;

            if (expectedRevision is null)
            {
                // Buffer has never been persisted, so there is no existing entry for
                // WriteAsync to replace (it requires the target to already exist). Create
                // it first; an AlreadyExists failure means the user chose Save As over an
                // existing file, so fall through to an unconditional overwrite below.
                FileSystemMutationResult creation = await _fileSystem.CreateAsync(
                    new FileSystemCreateRequest(
                        path,
                        FileSystemEntryKind.File,
                        FileSystemPermissions.FromMode(0b110_100_100)),
                    AppContext.CancellationToken);

                if (creation.Succeeded && creation.Entry is not null)
                {
                    expectedRevision = creation.Entry.Metadata.Revision;
                }
                else if (creation.Transaction.Error?.Code != FileSystemErrorCode.AlreadyExists)
                {
                    await ShowErrorDialogAsync("Save Failed", DescribeSaveError(creation.Transaction.Error?.Code));
                    StateHasChanged();
                    return;
                }
            }

            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(_doc.Content);
            MemoryStream stream = new(bytes);
            MemoryStreamContentSource source = new(
                FileSystemContentDescriptor.Text(_doc.MediaType, "utf-8"),
                stream);

            // WriteAsync(request, content, ct) returns FileSystemMutationResult (P2-TEXT-003)
            FileSystemMutationResult result = await _fileSystem.WriteAsync(
                new FileSystemWriteRequest(path, expectedRevision),
                source,
                AppContext.CancellationToken);

            if (result.Succeeded && result.Entry is not null)
            {
                _doc.CompleteSave(path, result.Entry.Metadata.Revision);
                _conflictDetected = false;
            }
            else if (result.Transaction.Error?.Code == FileSystemErrorCode.RevisionConflict)
            {
                // File was changed externally – surface conflict (P2-TEXT-004)
                _conflictDetected = true;
                await ShowConflictDialogAsync();
            }
            else
            {
                await ShowErrorDialogAsync("Save Failed", DescribeSaveError(result.Transaction.Error?.Code));
            }
        }
        catch (OperationCanceledException)
        {
            // User cancelled – leave buffer dirty, no message.
        }
        catch (Exception ex)
        {
            await ShowErrorDialogAsync("Save Failed", ex.Message);
        }
        finally
        {
            _suppressGenericPermissionNotice = false;
        }

        StateHasChanged();
    }

    private static string DescribeSaveError(FileSystemErrorCode? code) => code switch
    {
        FileSystemErrorCode.PermissionDenied => "Permission denied.",
        FileSystemErrorCode.NotFound => "Destination directory not found.",
        FileSystemErrorCode.RevisionConflict => "Revision conflict.",
        _ => code?.ToString() ?? "Write failed."
    };

    /// <summary>
    /// Minimal in-memory implementation of <see cref="IFileSystemContentSource"/> used
    /// by <see cref="WriteToDiskAsync"/> to stream encoded text to the VFS provider.
    /// </summary>
    private sealed class MemoryStreamContentSource : IFileSystemContentSource
    {
        private readonly MemoryStream _stream;

        public MemoryStreamContentSource(FileSystemContentDescriptor descriptor, MemoryStream stream)
        {
            Descriptor = descriptor;
            _stream = stream;
            Length = stream.Length;
        }

        public FileSystemContentDescriptor Descriptor { get; }
        public long? Length { get; }

        public ValueTask<Stream> OpenReadAsync(CancellationToken cancellationToken = default)
        {
            _stream.Position = 0;
            return ValueTask.FromResult<Stream>(_stream);
        }
    }

    private async Task ReloadCurrentFileAsync()
    {
        if (_doc.Path is { } path)
        {
            await LoadFileAsync(path);
        }
    }

    // ──────────────────────────── Dirty-state guard ───────────────────────────────

    /// <summary>
    /// Prompts the user when the buffer is dirty. Returns true when it is safe to
    /// proceed, false when the user chose to cancel (P2-TEXT-004).
    /// </summary>
    private async Task<bool> ConfirmDiscardDirtyAsync()
    {
        if (!_doc.IsDirty) return true;

        bool confirmed = await ShowDirtyConfirmDialogAsync();
        return confirmed;
    }

    // ──────────────────────────── Find / search (P2-TEXT-006) ────────────────────

    private void ToggleFindBar()
    {
        _showFindBar = !_showFindBar;
        if (!_showFindBar)
        {
            _findQuery = string.Empty;
            _findIndex = -1;
        }
        StateHasChanged();
    }

    private string FindMatchSummary
    {
        get
        {
            if (string.IsNullOrEmpty(_findQuery)) return string.Empty;
            int count = CountMatches();
            return count == 0 ? "No matches" : $"Match {_findIndex + 1}/{count}";
        }
    }

    private List<int> GetMatchIndexes() => TextEditorFindEngine.FindMatches(_doc.Content, _findQuery);

    private int CountMatches() => GetMatchIndexes().Count;

    private async Task HandleFindQueryChangedAsync(ChangeEventArgs args)
    {
        _findQuery = args.Value as string ?? string.Empty;
        List<int> indexes = GetMatchIndexes();
        _findIndex = indexes.Count > 0 ? 0 : -1;
        StateHasChanged();
        await HighlightCurrentMatchAsync(indexes);
    }

    private async Task FindNext()
    {
        List<int> indexes = GetMatchIndexes();
        _findIndex = TextEditorFindEngine.Next(_findIndex, indexes.Count);
        StateHasChanged();
        await HighlightCurrentMatchAsync(indexes);
    }

    private async Task FindPrev()
    {
        List<int> indexes = GetMatchIndexes();
        _findIndex = TextEditorFindEngine.Previous(_findIndex, indexes.Count);
        StateHasChanged();
        await HighlightCurrentMatchAsync(indexes);
    }

    /// <summary>Selects and scrolls to the current match in the live textarea, best-effort.</summary>
    private async Task HighlightCurrentMatchAsync(List<int>? indexes = null)
    {
        indexes ??= GetMatchIndexes();
        if (_module is null || _findIndex < 0 || _findIndex >= indexes.Count)
        {
            return;
        }

        int start = indexes[_findIndex];
        int end = start + _findQuery.Length;
        try
        {
            await _module.InvokeVoidAsync("selectRange", _textAreaRef, start, end);
        }
        catch (Exception)
        {
            // Headless test DOM and unavailable-JS fallback: matching still works, just
            // without visual selection/scroll.
        }
    }

    private async Task HandleFindKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey) await FindNext();
        else if (args.Key == "Enter" && args.ShiftKey) await FindPrev();
        else if (args.Key == "Escape") ToggleFindBar();
    }

    // ──────────────────────────── Keyboard shortcuts (P2-TEXT-006) ────────────────

    private async Task HandleGlobalKeyDownAsync(KeyboardEventArgs args)
    {
        if (!args.CtrlKey) return;
        switch (args.Key)
        {
            case "s" or "S":
                if (args.ShiftKey) await SaveAsAsync();
                else await SaveAsync();
                break;
            case "o" or "O":
                await OpenFileAsync();
                break;
            case "n" or "N":
                await NewDocumentAsync();
                break;
            case "f" or "F":
                ToggleFindBar();
                break;
        }
    }

    private void HandleTextInput(ChangeEventArgs args)
    {
        if (args.Value is string newContent)
        {
            _doc.Edit(newContent);
        }
    }

    // ──────────────────────────── Permission-error notifications ─────────────────

    /// <summary>
    /// Set while <see cref="WriteToDiskAsync"/> is in flight, since it already inspects the
    /// mutation result and shows its own tailored dialog (<see cref="ShowErrorDialogAsync"/>) for
    /// every failure code, including permission-class ones. Left <see langword="false"/> at all
    /// other times so read failures from <see cref="LoadFileAsync"/> — which today only surface
    /// as inline overlay text — still get the host's default error notification.
    /// </summary>
    private bool _suppressGenericPermissionNotice;

    protected override void OnPermissionErrorRaised(AppPermissionErrorEventArgs e)
    {
        if (_suppressGenericPermissionNotice)
        {
            e.ErrorHandled = true;
        }
    }

    // ──────────────────────────── MudBlazor dialog helpers ───────────────────────

    private async Task<bool> ShowDirtyConfirmDialogAsync()
    {
        bool? result = await MudDialogService.ShowMessageBoxAsync(
            "Unsaved Changes",
            $"'{_doc.Title}' has unsaved changes. Discard them and continue?",
            yesText: "Discard",
            cancelText: "Cancel");
        return result == true;
    }

    private async Task ShowConflictDialogAsync()
    {
        await MudDialogService.ShowMessageBoxAsync(
            "Save Conflict",
            "The file was changed by another process since it was last loaded. " +
            "Use 'Save As' to write a new copy, or reload the file to accept external changes.",
            yesText: "OK");
    }

    private async Task ShowErrorDialogAsync(string title, string message)
    {
        await MudDialogService.ShowMessageBoxAsync(title, message, yesText: "OK");
    }
}
