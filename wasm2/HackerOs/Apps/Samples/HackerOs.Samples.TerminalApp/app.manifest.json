{
  "schemaVersion": 1,
  "id": "org.hackeros.samples.terminal-app",
  "name": "Sample Terminal App",
  "version": "1.0.0",
  "publisherId": "pub.hackeros",
  "description": "Complete sample Terminal command application demonstrating streams, arguments, VFS, cancellation, and exit codes",
  "kind": "terminal",
  "entryPoint": {
    "assembly": "HackerOs.Samples.TerminalApp.dll",
    "type": "HackerOs.Samples.TerminalApp.SampleTerminalApp"
  },
  "sdkCompatibility": {
    "minimumVersion": "1.0.0"
  },
  "presentation": {
    "category": "utilities",
    "launchVisibility": "visible",
    "iconAssetPaths": []
  },
  "terminal": {
    "commandName": "sample-cmd",
    "aliases": ["sample"],
    "helpSummary": "Executes sample SDK terminal command"
  },
  "capabilities": [
    "filesystem.user-home.read",
    "filesystem.user-home.write"
  ],
  "resources": {
    "baselineCpuWeight": 0.01,
    "burstCpuWeight": 0.05,
    "baselineMemoryWeight": 0.01,
    "burstMemoryWeight": 0.02,
    "baselineStorageIoWeight": 0.0,
    "burstStorageIoWeight": 0.0,
    "baselineNetworkIoWeight": 0.0,
    "burstNetworkIoWeight": 0.0
  }
}
