{
  "schemaVersion": 1,
  "id": "org.hackeros.samples.service-app",
  "name": "Sample Ticker Service",
  "version": "1.0.0",
  "publisherId": "pub.hackeros",
  "description": "Deterministic status and ticker background service for HackerOS sessions",
  "kind": "service",
  "entryPoint": {
    "assembly": "HackerOs.Samples.ServiceApp.dll",
    "type": "HackerOs.Samples.ServiceApp.SampleTickerService"
  },
  "sdkCompatibility": {
    "minimumVersion": "1.0.0"
  },
  "presentation": {
    "category": "utilities",
    "launchVisibility": "hidden",
    "iconAssetPaths": []
  },
  "capabilities": [
    "notifications.post"
  ],
  "resources": {
    "baselineCpuWeight": 0.01,
    "burstCpuWeight": 0.05,
    "baselineMemoryWeight": 0.02,
    "burstMemoryWeight": 0.05,
    "baselineStorageIoWeight": 0.0,
    "burstStorageIoWeight": 0.0,
    "baselineNetworkIoWeight": 0.0,
    "burstNetworkIoWeight": 0.0
  },
  "autoStart": true
}
