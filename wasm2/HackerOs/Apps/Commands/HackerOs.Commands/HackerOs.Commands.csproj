<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR 0051: every built-in terminal command lives in this single project, one folder per command
    (Cat/CatApp.cs + Cat/CatCommand.cs, namespace HackerOs.Commands.Cat). Each [AppManifest] class
    produces manifests/<appId>.json (ADR 0047); the host references this project once, with
    IsSystemApp="true", and lazy-loads the whole assembly on first use.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\HackerOs.App.Abstractions\HackerOs.App.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.AppSdk\HackerOs.AppSdk.csproj" />
    <ProjectReference Include="..\..\..\Shared\HackerOs.Simulation.Abstractions\HackerOs.Simulation.Abstractions.csproj" />
    <ProjectReference Include="..\..\..\Platform\HackerOs.Platform.Core\HackerOs.Platform.Core.csproj" />
    <!-- ADR 0028 (ping): the optional server's shared contracts are designed for use by any
         browser-independent client adapter/consumer, not just the ASP.NET Core server. -->
    <ProjectReference Include="..\..\..\Server\HackerOs.Server.Contracts\HackerOs.Server.Contracts.csproj" />
  </ItemGroup>

</Project>
