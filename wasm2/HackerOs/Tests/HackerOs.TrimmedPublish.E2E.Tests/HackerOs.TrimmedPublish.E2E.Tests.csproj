<Project Sdk="Microsoft.NET.Sdk">

  <!--
    E2E test of the trimmed Release publish of OS/HackerOs.Ecosystem (ADR 0106 §5, ADR 0113). It
    does not publish or serve anything itself: build/publish-trimmed.sh publishes the host, serves
    the output and runs this suite with HACKEROS_TRIMMED_URL pointing at it. Without that variable
    every test reports as skipped, so a plain `dotnet test HackerOs.sln` stays unaffected.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Deque.AxeCore.Playwright" Version="4.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackerOs.E2E.Support\HackerOs.E2E.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="HackerOs.E2E.Support" />
  </ItemGroup>

</Project>
