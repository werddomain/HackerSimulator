<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared Playwright plumbing for every browser-driven suite (HackerOs.E2E.Tests,
    HackerOs.UI.E2E.Tests, HackerOs.Pwa.E2E.Tests, HackerOs.HostSmoke.Tests,
    HackerOs.TrimmedPublish.E2E.Tests). Test-only code:
    never referenced by a shipping project, so the trim analysis Directory.Build.props turns on
    for every non-".Tests" project does not apply here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>

</Project>
