<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      BL0005 ("component parameter set outside its component") fires for the [Parameter] properties
      DesktopAreaBackgroundContentTests.cs sets directly on a DesktopArea instance before attaching it to
      FrameCapturingRenderer, and BL0006 fires for that renderer's direct use of
      Microsoft.AspNetCore.Components.RenderTree — both are the intended, supported way to drive a
      component under test without bUnit (which this solution doesn't use); see
      Tests/HackerOs.AppSdk.FileView.Tests/TestComponentRenderer.cs for the established precedent.
    -->
    <NoWarn>$(NoWarn);BL0005;BL0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\HackerOs.Platform.Blazor\HackerOs.Platform.Blazor.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Theming.Blazor\HackerOs.Theming.Blazor.csproj" />
    <ProjectReference Include="..\..\OS\HackerOs.Ecosystem\HackerOs.Ecosystem.csproj" />
  </ItemGroup>

</Project>
