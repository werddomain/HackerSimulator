<!-- Razor SDK: MvcSite has .razor views and an embedded wwwroot (web/7, ADR 0083). -->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\HackerOs.Platform.WorkerHost\HackerOs.Platform.WorkerHost.csproj" />
    <!-- ADR 0070, section 5.1 of the plan: every built-in command runs in both modes. -->
    <ProjectReference Include="..\..\Apps\Commands\HackerOs.Commands\HackerOs.Commands.csproj" />
    <ProjectReference Include="..\..\Apps\Samples\HackerOs.Samples.ServiceApp\HackerOs.Samples.ServiceApp.csproj" />
    <ProjectReference Include="..\..\Apps\Samples\HackerOs.Samples.TerminalApp\HackerOs.Samples.TerminalApp.csproj" />
    <!-- ADR 0077/0080: hackwebd runs in the headless OS of these tests. -->
    <ProjectReference Include="..\..\Apps\System\HackerOs.Apps.WebServer\HackerOs.Apps.WebServer.csproj" />
    <ProjectReference Include="..\HackerOs.Tests.Support\HackerOs.Tests.Support.csproj" />
    <!-- ADR 0076: an ASP.Hack MVC site (MvcSite.cs) served through the real web worker. -->
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Web\HackerOs.AppSdk.Web.csproj" />
    <ProjectReference Include="..\..\Tools\HackerOs.Tools.WebRouteGenerator\HackerOs.Tools.WebRouteGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
