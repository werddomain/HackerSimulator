<Project>
  <!--
    The Razor SDK adds app.manifest.json as Content after Directory.Build.props is
    imported. Apply the package-qualified publish path here, after SDK item setup,
    so hosts can reference multiple app projects without filename collisions.
  -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\app.manifest.json')">
    <Content Update="app.manifest.json"
             Link="app-manifests\$(MSBuildProjectName).json"
             TargetPath="app-manifests\$(MSBuildProjectName).json" />
  </ItemGroup>

  <Target Name="ValidateHackerOsRazorAssets"
          BeforeTargets="CoreCompile"
          Condition="'$(UsingMicrosoftNETSdkRazor)' == 'true'">
    <ItemGroup>
      <_HackerOsRazorSource Include="$(MSBuildProjectDirectory)/**/*.razor"
                            Exclude="$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**" />
      <_HackerOsRazorViolation Include="@(_HackerOsRazorSource)"
          Condition="'%(_HackerOsRazorSource.FullPath)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch($([System.IO.File]::ReadAllText('%(_HackerOsRazorSource.FullPath)')), '(?is)&lt;\s*(style|script)\b|\sstyle\s*=|(?&lt;!@)(?-i:\bon[a-z][a-z0-9_-]*)\s*='))" />
    </ItemGroup>

    <!--<Error Condition="'@(_HackerOsRazorViolation)' != ''"
           Text="HackerOS Razor components cannot contain inline CSS or JavaScript. Move assets to Component.razor.css or Component.razor.js. Files: @(_HackerOsRazorViolation, ', ')" />-->
  </Target>
</Project>
