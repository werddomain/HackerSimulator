@*
    ASP.Hack root imports of every .cshtml of a site (ADR 0086 §2), added by build/HackerOs.Apps.targets.
    The Razor compiler of the SDK compiles .cshtml files in MVC mode; these lines replace MVC's base class
    and its five implicit @inject properties by ASP.Hack's, so the generated C# never needs ASP.NET MVC.
    TModel is replaced by the type a view declares with @model (dynamic without @model).
    Put a site's own imports in Views/_ViewImports.cshtml.
*@
@using HackerOs.AppSdk.Web.Views
@using HackerOs.AppSdk.Web.Mvc
@inherits HackerOs.AppSdk.Web.Views.HackRazorPage<TModel>
@inject HackerOs.AppSdk.Web.Views.HackHtmlHelper<TModel> Html
@inject HackerOs.AppSdk.Web.Views.HackJsonHelper Json
@inject HackerOs.AppSdk.Web.Views.HackViewComponentHelper Component
@inject HackerOs.AppSdk.Web.Mvc.IHackUrlHelper Url
@inject HackerOs.AppSdk.Web.Views.HackModelExpressionProvider<TModel> ModelExpressionProvider
