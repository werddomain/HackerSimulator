@namespace HackerOs.MobileShell.Blazor
@inject IServiceProvider LocalizationServices

<nav class="mobile-nav-bar" aria-label="@L["Navigation.Label"]">
    <button type="button" class="mobile-nav-button" aria-label="@BackLabel" title="@BackLabel" @onclick="HandleBack">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polygon points="16,4 6,12 16,20" />
        </svg>
    </button>
    <button type="button" class="mobile-nav-button" aria-label="@HomeLabel" title="@HomeLabel" @onclick="HandleHome">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="8" />
        </svg>
    </button>
    <button type="button" class="mobile-nav-button" aria-label="@RecentLabel" title="@RecentLabel" @onclick="HandleRecent">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="5" y="5" width="14" height="14" />
        </svg>
    </button>
</nav>

@code {
    /// <summary>
    /// Gets or sets the dispatcher for the three system-navigation actions. Unlike
    /// <c>HackerOs.Taskbar.Blazor</c>'s optional contract parameters, this is required: the
    /// Mobile shell has no floating chrome equivalent for Back/Home/Recent, so a bar with nothing
    /// to dispatch to is a host configuration error, not a legitimately reduced state.
    /// </summary>
    [Parameter, EditorRequired]
    public IMobileNavigationCommands Commands { get; set; } = null!;

    /// <summary>Gets or sets host-supplied accessible labels for the three buttons.</summary>
    [Parameter]
    public MobileSystemNavigationBarOptions Options { get; set; } = new();

    private void HandleBack() => Commands.RequestBack();
    private void HandleHome() => Commands.RequestHome();
    private void HandleRecent() => Commands.RequestRecent();

    private string BackLabel => Options.BackLabel ?? L["Navigation.Back"];
    private string HomeLabel => Options.HomeLabel ?? L["Navigation.Home"];
    private string RecentLabel => Options.RecentLabel ?? L["Navigation.Recent"];

    /// <summary>Gets the package's texts: the host's session language, or English without localization (ADR 0104).</summary>
    private IStringLocalizer L => _localizer ??= PackageStringLocalizer.Resolve<Strings>(LocalizationServices);
    private IStringLocalizer? _localizer;
}
