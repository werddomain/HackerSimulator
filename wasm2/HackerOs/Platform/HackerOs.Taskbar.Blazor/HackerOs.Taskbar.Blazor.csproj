<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HackerOs.Taskbar.Blazor</PackageId>
    <Description>A taskbar Razor component driven entirely by host-supplied contracts (window source, command dispatcher, launcher, status, notifications, session commands) -- each optional, each cleanly absent from render when not supplied.</Description>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- Native Blazor only. No MudBlazor: a consumer must be able to adopt the taskbar
         without the window engine's chrome dependencies, per EXT-WIN-008. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\HackerOs.AppSdk.Icons\HackerOs.AppSdk.Icons.csproj" />
    <ProjectReference Include="..\HackerOs.Theming.Blazor\HackerOs.Theming.Blazor.csproj" />
    <ProjectReference Include="..\HackerOs.Windowing.Abstractions\HackerOs.Windowing.Abstractions.csproj" />
    <ProjectReference Include="..\HackerOs.Windowing.Core\HackerOs.Windowing.Core.csproj" />
  </ItemGroup>

</Project>
