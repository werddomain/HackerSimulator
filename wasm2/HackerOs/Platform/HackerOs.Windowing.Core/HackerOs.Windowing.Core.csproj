<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HackerOs.Windowing.Core</PackageId>
    <Description>Headless, renderer-independent window manager engine: identity, geometry, focus, z-order, modality, and lifecycle transitions as deterministic commands and events.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the RenderFragment delegate type carried by WindowRuntimeState.Content.
         No browser pipeline, no .razor components, no MudBlazor: this project stays headless. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.10" />
  </ItemGroup>

</Project>
