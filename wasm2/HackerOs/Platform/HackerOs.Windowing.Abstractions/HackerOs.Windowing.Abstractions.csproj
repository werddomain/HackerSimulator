<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\Packaging.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>HackerOs.Windowing.Abstractions</PackageId>
    <Description>Renderer- and host-independent window contracts: identity, geometry, constraints, visual state, modality, and the commands/events HackerOs.Windowing.Core's engine consumes and produces.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for the RenderFragment delegate type carried by WindowRuntimeState.Content.
         No browser pipeline, no .razor components, no MudBlazor: this project stays headless. -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.10" />
  </ItemGroup>

</Project>
