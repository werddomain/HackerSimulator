@using HackerOs.Platform.Blazor.Windows
@using HackerOs.Simulation.Abstractions.Time
@inject WindowRuntime WindowRuntime
@inject ISimulationClock SimulationClock
@implements IDisposable

<footer class="taskbar-container" role="contentinfo" aria-label="Desktop taskbar">
    <div class="taskbar-start">
        <button type="button"
                class="launcher-trigger @(IsLauncherOpen ? "is-active" : "")"
                aria-label="App launcher"
                aria-expanded="@IsLauncherOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleLauncherAsync">
            <span class="launcher-mark" aria-hidden="true">H_</span>
            <span class="launcher-label">Applications</span>
        </button>
    </div>

    <nav class="taskbar-center" aria-label="Running applications">
        @foreach (WindowRuntimeState window in WindowRuntime.Windows)
        {
            bool isFocused = window.IsFocused && window.VisualState != WindowVisualState.Minimized;
            <button type="button"
                    key="@window.Id.Value"
                    class="taskbar-item @(isFocused ? "is-active" : "") @(window.VisualState == WindowVisualState.Minimized ? "is-minimized" : "")"
                    aria-label="@(window.Title) (@(isFocused ? "focused" : window.VisualState == WindowVisualState.Minimized ? "minimized" : "background"))"
                    @onclick="() => HandleWindowItemClick(window)">
                <span class="item-icon" aria-hidden="true">🗔</span>
                <span class="item-title">@window.Title</span>
            </button>
        }
    </nav>

    <div class="taskbar-end">
        <button type="button"
                class="notification-trigger @(IsNotificationsOpen ? "is-active" : "")"
                aria-label="Notifications (@UnreadNotificationCount unread)"
                aria-expanded="@IsNotificationsOpen.ToString().ToLowerInvariant()"
                @onclick="ToggleNotificationsAsync">
            <span class="notification-icon" aria-hidden="true">🔔</span>
            @if (UnreadNotificationCount > 0)
            {
                <span class="notification-badge" role="status">@UnreadNotificationCount</span>
            }
        </button>

        <div class="taskbar-clock" aria-label="System clock" role="timer">
            <span class="clock-icon" aria-hidden="true">⏱</span>
            <span class="clock-text">@_formattedTime</span>
        </div>

        <button type="button"
                class="logout-trigger"
                aria-label="User session and logout"
                @onclick="RequestLogoutAsync">
            <span class="logout-icon" aria-hidden="true">⏻</span>
        </button>
    </div>
</footer>

@code {
    private IDisposable? _clockSubscription;
    private string _formattedTime = string.Empty;

    [Parameter]
    public bool IsLauncherOpen { get; set; }

    [Parameter]
    public bool IsNotificationsOpen { get; set; }

    [Parameter]
    public int UnreadNotificationCount { get; set; }

    [Parameter]
    public EventCallback OnToggleLauncher { get; set; }

    [Parameter]
    public EventCallback OnToggleNotifications { get; set; }

    [Parameter]
    public EventCallback OnRequestLogout { get; set; }

    protected override void OnInitialized()
    {
        UpdateTimeDisplay();
        ScheduleNextClockUpdate();
    }

    private void ScheduleNextClockUpdate()
    {
        _clockSubscription?.Dispose();
        _clockSubscription = SimulationClock.Schedule(TimeSpan.FromSeconds(1), () =>
        {
            InvokeAsync(() =>
            {
                UpdateTimeDisplay();
                StateHasChanged();
                ScheduleNextClockUpdate();
            });
        });
    }

    private void UpdateTimeDisplay()
    {
        _formattedTime = SimulationClock.UtcNow.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task ToggleLauncherAsync()
    {
        if (OnToggleLauncher.HasDelegate)
        {
            await OnToggleLauncher.InvokeAsync();
        }
    }

    private async Task ToggleNotificationsAsync()
    {
        if (OnToggleNotifications.HasDelegate)
        {
            await OnToggleNotifications.InvokeAsync();
        }
    }

    private async Task RequestLogoutAsync()
    {
        if (OnRequestLogout.HasDelegate)
        {
            await OnRequestLogout.InvokeAsync();
        }
    }

    private void HandleWindowItemClick(WindowRuntimeState window)
    {
        if (window.VisualState == WindowVisualState.Minimized)
        {
            WindowRuntime.Apply(new RestoreWindowCommand(window.Id));
            WindowRuntime.Apply(new FocusWindowCommand(window.Id));
        }
        else if (window.IsFocused)
        {
            WindowRuntime.Apply(new MinimizeWindowCommand(window.Id));
        }
        else
        {
            WindowRuntime.Apply(new FocusWindowCommand(window.Id));
        }
    }

    public void Dispose()
    {
        _clockSubscription?.Dispose();
        _clockSubscription = null;
    }
}
