@using HackerOs.MobileShell.Blazor
@using HackerOs.Platform.Blazor.Windows
@using HackerOs.Platform.Core.Discovery
@using HackerOs.Platform.Core.Lifecycle
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject WindowRuntime WindowRuntime
@inject AppLifecycleOrchestrator Orchestrator
@inject WindowCloseGuardRegistry CloseGuards
@inject AppBackHandlerRegistry BackHandlers
@inject IJSRuntime JSRuntime

<div class="mobile-shell">
    <div class="mobile-shell-workspace">
        <SingleSurfaceArea Windows="WindowRuntime.Windows"
                           OnFocus="HandleFocus"
                           OnGesture="HandleGesture">
            <WindowContent Context="window">
                @if (window.Content is not null)
                {
                    @window.Content
                }
                else if (Orchestrator.TryGetRunningInstance(AppInstanceId.FromGuid(window.OwnerInstanceId.Value), out AppDescriptor? descriptor, out IAppExecutionContext? context))
                {
                    <WindowAppRenderer Window="window"
                                       Descriptor="descriptor"
                                       AppContext="context"
                                       CloseGuards="CloseGuards"
                                       BackHandlers="BackHandlers" />
                }
                else
                {
                    <div class="window-content-placeholder">@window.Title</div>
                }
            </WindowContent>
        </SingleSurfaceArea>
        <button type="button"
                class="mobile-shade-handle"
                @ref="_swipeHandleElement"
                aria-label="Notifications, calendar, and platform mode"
                aria-expanded="@(_isShadeOpen ? "true" : "false")"
                @onclick="ToggleShade">
            <span class="mobile-shade-grabber" aria-hidden="true"></span>
        </button>
    </div>

    @if (_isShadeOpen)
    {
        <div class="mobile-shade-backdrop" @onclick="CloseShade">
            <div class="mobile-shade-panel" @onclick:stopPropagation="true">
                <ClockPanel OnClose="CloseShade" />
            </div>
        </div>
    }

    <MobileSystemNavigationBar Commands="_navigationCommands" />
</div>

@code {
    /// <summary>
    /// Mobile counterpart to <see cref="DesktopShell"/> (<c>MOB-008</c>/<c>MOB-009</c>/<c>MOB-010</c>):
    /// a single full-screen surface, the Android-inspired system navigation bar, and a swipe-down
    /// notification shade reusing <see cref="ClockPanel"/> (notifications, calendar, and the
    /// Auto/Desktop/Mobile toggle) — Mobile's equivalent of the Desktop taskbar clock, since Mobile
    /// has no taskbar to anchor it to. Reachable from the running app via <c>App.razor</c> once
    /// <c>UiPlatformPreferenceService.Current.ActivePlatform</c> is Mobile.
    /// </summary>
    private MobileNavigationCommandsAdapter _navigationCommands = null!;
    private ElementReference _swipeHandleElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MobileShell>? _selfReference;
    private bool _isShadeOpen;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        WindowRuntime.StateChanged += Rerender;
        _navigationCommands = new MobileNavigationCommandsAdapter(WindowRuntime, BackHandlers);
    }

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/HackerOs.Platform.Blazor/Shell/MobileShell.razor.js");
        // Confirmed via staticwebassets.build.json's RelativePath ("Shell/MobileShell...razor.js") --
        // Razor SDK co-located JS preserves the project-relative folder, unlike the flat
        // wwwroot/*.js convention BrowserPlatformEnvironmentProbe.cs uses in this same project.
        _selfReference = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("attachSwipeDownGesture", _swipeHandleElement, _selfReference);
    }

    /// <summary>Invoked from JS when a downward swipe past the open threshold is detected on the handle.</summary>
    [JSInvokable]
    public void OnSwipeDownDetected() => OpenShade();

    private void ToggleShade()
    {
        if (_isShadeOpen)
        {
            CloseShade();
        }
        else
        {
            OpenShade();
        }
    }

    private void OpenShade()
    {
        _isShadeOpen = true;
        StateHasChanged();
    }

    private void CloseShade()
    {
        _isShadeOpen = false;
        StateHasChanged();
    }

    private void Rerender() => InvokeAsync(StateHasChanged);

    private void HandleFocus(WindowId id) => WindowRuntime.Apply(new FocusWindowCommand(id));

    private void HandleGesture(WindowCommand command)
    {
        try
        {
            WindowRuntime.Apply(command);
        }
        catch (InvalidOperationException)
        {
            // Same defense-in-depth as DesktopShell.HandleGesture: a policy-issued command
            // (SingleSurfaceArea's own Minimize/Maximize) racing a just-closed window should not
            // raise an unhandled exception through the render loop.
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        WindowRuntime.StateChanged -= Rerender;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("detachSwipeDownGesture", _swipeHandleElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _selfReference?.Dispose();
    }
}
