@using HackerOs.MobileShell.Blazor
@using HackerOs.Platform.Blazor.Windows
@using HackerOs.Platform.Core.Discovery
@using HackerOs.Platform.Core.Lifecycle
@implements IDisposable
@inject WindowRuntime WindowRuntime
@inject AppLifecycleOrchestrator Orchestrator
@inject WindowCloseGuardRegistry CloseGuards
@inject PlatformShellSwitchCoordinator PlatformSwitch

<div class="mobile-shell">
    <div class="mobile-shell-workspace">
        <SingleSurfaceArea Windows="WindowRuntime.Windows"
                           OnFocus="HandleFocus"
                           OnGesture="HandleGesture">
            <WindowContent Context="window">
                @if (window.Content is not null)
                {
                    @window.Content
                }
                else if (Orchestrator.TryGetRunningInstance(AppInstanceId.FromGuid(window.OwnerInstanceId.Value), out AppDescriptor? descriptor, out IAppExecutionContext? context))
                {
                    <WindowAppRenderer Window="window"
                                       Descriptor="descriptor"
                                       AppContext="context"
                                       CloseGuards="CloseGuards" />
                }
                else
                {
                    <div class="window-content-placeholder">@window.Title</div>
                }
            </WindowContent>
        </SingleSurfaceArea>
        <button type="button"
                class="mobile-shell-desktop-toggle"
                aria-label="Switch to Desktop"
                title="Switch to Desktop"
                @onclick="SwitchToDesktopAsync">
            Desktop
        </button>
    </div>

    <MobileSystemNavigationBar Commands="_navigationCommands" />
</div>

@code {
    /// <summary>
    /// Mobile counterpart to <see cref="DesktopShell"/> (<c>MOB-008</c>/<c>MOB-009</c>/<c>MOB-010</c>):
    /// a single full-screen surface plus the Android-inspired system navigation bar. Reachable from
    /// the running app via <c>App.razor</c> once <c>UiPlatformPreferenceService.Current.ActivePlatform</c>
    /// is Mobile.
    /// </summary>
    private MobileNavigationCommandsAdapter _navigationCommands = null!;

    /// <summary>
    /// Placeholder return-to-Desktop control. Mobile has no settings surface yet (no equivalent of
    /// the Desktop clock panel's platform toggle), so without this a user who switches to Mobile
    /// would have no way back through the UI. A proper Mobile settings entry point is future work,
    /// not part of MOB-008/009/010.
    /// </summary>
    private Task SwitchToDesktopAsync() => PlatformSwitch.RequestExplicitAsync(WellKnownAppPlatforms.Desktop);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        WindowRuntime.StateChanged += Rerender;
        _navigationCommands = new MobileNavigationCommandsAdapter(WindowRuntime);
    }

    private void Rerender() => InvokeAsync(StateHasChanged);

    private void HandleFocus(WindowId id) => WindowRuntime.Apply(new FocusWindowCommand(id));

    private void HandleGesture(WindowCommand command)
    {
        try
        {
            WindowRuntime.Apply(command);
        }
        catch (InvalidOperationException)
        {
            // Same defense-in-depth as DesktopShell.HandleGesture: a policy-issued command
            // (SingleSurfaceArea's own Minimize/Maximize) racing a just-closed window should not
            // raise an unhandled exception through the render loop.
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        WindowRuntime.StateChanged -= Rerender;
    }
}
