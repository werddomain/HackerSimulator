@using HackerOs.App.Abstractions
@using HackerOs.Platform.Core.Shell
@using HackerOs.Simulation.Abstractions.Notifications
@using HackerOs.Simulation.Abstractions.Sessions
@using HackerOs.Simulation.Abstractions.Time
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject INotificationQueue NotificationQueue
@inject ISessionService SessionService
@inject ISimulationClock SimulationClock
@inject UiPlatformPreferenceService PlatformPreference
@inject PlatformShellSwitchCoordinator PlatformSwitch

<div class="clock-panel" role="dialog" aria-label="Notifications and calendar" @onkeydown="HandleKeyDownAsync">
    <section class="clock-panel-section" aria-label="Notifications">
        <h3 class="clock-panel-heading">Notifications</h3>
        @if (ActiveNotifications.Count == 0)
        {
            <p class="clock-panel-empty">No notifications.</p>
        }
        else
        {
            <ul class="notification-list">
                @foreach (Notification notification in ActiveNotifications)
                {
                    string severityClass = notification.Severity switch
                    {
                        NotificationSeverity.Error => "is-error",
                        NotificationSeverity.Warning => "is-warning",
                        NotificationSeverity.Success => "is-success",
                        _ => "is-info"
                    };

                    <li key="@notification.Id.ToString()" class="notification-row @severityClass">
                        <div class="notification-row-header">
                            <span class="source-app">@notification.SourceAppId</span>
                            <button type="button"
                                    class="notification-dismiss"
                                    aria-label="Dismiss notification"
                                    @onclick="() => DismissNotificationAsync(notification.Id)">
                                ×
                            </button>
                        </div>
                        <h4 class="notification-title">@notification.Title</h4>
                        <p class="notification-message">@notification.Message</p>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="clock-panel-section" aria-label="Calendar">
        <h3 class="clock-panel-heading">@Today.ToString("MMMM yyyy")</h3>
        <table class="calendar-grid">
            <thead>
                <tr>
                    @foreach (string dayLabel in DayLabels)
                    {
                        <th scope="col">@dayLabel</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (IReadOnlyList<int?> week in CalendarWeeks)
                {
                    <tr>
                        @foreach (int? day in week)
                        {
                            @if (day is null)
                            {
                                <td></td>
                            }
                            else
                            {
                                <td class="@(day == Today.Day ? "is-today" : "")">@day</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="clock-panel-section" aria-label="Platform mode">
        <h3 class="clock-panel-heading">Platform mode</h3>
        <div class="platform-toggle" role="radiogroup" aria-label="Platform mode">
            <button type="button"
                    role="radio"
                    class="platform-toggle-option @(PlatformPreference.Current.SelectionSource == UiPlatformSelectionSource.Auto ? "is-selected" : "")"
                    aria-checked="@((PlatformPreference.Current.SelectionSource == UiPlatformSelectionSource.Auto).ToString().ToLowerInvariant())"
                    @onclick="SetAutoAsync">
                Auto
            </button>
            <button type="button"
                    role="radio"
                    class="platform-toggle-option @(IsExplicit(WellKnownAppPlatforms.Desktop) ? "is-selected" : "")"
                    aria-checked="@(IsExplicit(WellKnownAppPlatforms.Desktop).ToString().ToLowerInvariant())"
                    @onclick="() => SetExplicitAsync(WellKnownAppPlatforms.Desktop)">
                Desktop
            </button>
            <button type="button"
                    role="radio"
                    class="platform-toggle-option @(IsExplicit(WellKnownAppPlatforms.Mobile) ? "is-selected" : "")"
                    aria-checked="@(IsExplicit(WellKnownAppPlatforms.Mobile).ToString().ToLowerInvariant())"
                    @onclick="() => SetExplicitAsync(WellKnownAppPlatforms.Mobile)">
                Mobile
            </button>
        </div>
        <p class="platform-toggle-hint">
            Active: @PlatformPreference.Current.ActivePlatform.Value
            (@(PlatformPreference.Current.SelectionSource == UiPlatformSelectionSource.Auto ? "automatic detection" : "explicit choice")).
        </p>
    </section>
</div>

@code {
    [Parameter]
    public EventCallback OnClose { get; set; }

    private static readonly string[] DayLabels = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];

    private DateTimeOffset Today => SimulationClock.UtcNow;

    private IReadOnlyList<Notification> ActiveNotifications
    {
        get
        {
            LocalUserId userId = SessionService.CurrentPrincipal?.UserId ?? default;
            return NotificationQueue.GetActive(userId, SimulationClock.UtcNow);
        }
    }

    private IReadOnlyList<IReadOnlyList<int?>> CalendarWeeks
    {
        get
        {
            DateTimeOffset today = Today;
            DateTime firstOfMonth = new(today.Year, today.Month, 1);
            int daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
            int leadingBlanks = (int)firstOfMonth.DayOfWeek;

            List<IReadOnlyList<int?>> weeks = [];
            List<int?> currentWeek = [.. Enumerable.Repeat<int?>(null, leadingBlanks)];

            for (int day = 1; day <= daysInMonth; day++)
            {
                currentWeek.Add(day);
                if (currentWeek.Count == 7)
                {
                    weeks.Add(currentWeek);
                    currentWeek = [];
                }
            }

            if (currentWeek.Count > 0)
            {
                currentWeek.AddRange(Enumerable.Repeat<int?>(null, 7 - currentWeek.Count));
                weeks.Add(currentWeek);
            }

            return weeks;
        }
    }

    private bool IsExplicit(AppPlatformId platformId) =>
        PlatformPreference.Current.SelectionSource == UiPlatformSelectionSource.Explicit
        && PlatformPreference.Current.ExplicitPlatformId == platformId;

    protected override void OnInitialized()
    {
        PlatformPreference.Changed += OnPreferenceChanged;
    }

    private void OnPreferenceChanged() => InvokeAsync(StateHasChanged);

    private async Task DismissNotificationAsync(NotificationId id)
    {
        NotificationQueue.Dismiss(id);
        StateHasChanged();
        await Task.CompletedTask;
    }

    private Task SetAutoAsync() => PlatformSwitch.RequestAutoAsync();

    private Task SetExplicitAsync(AppPlatformId platformId) => PlatformSwitch.RequestExplicitAsync(platformId);

    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    /// <inheritdoc />
    public void Dispose() => PlatformPreference.Changed -= OnPreferenceChanged;
}
