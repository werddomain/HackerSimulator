@using HackerOs.App.Abstractions
@using HackerOs.Platform.Blazor.Dialogs
@using HackerOs.Platform.Blazor.Windows
@using HackerOs.Platform.Core.Discovery
@using HackerOs.Platform.Core.FileSystem
@using HackerOs.Platform.Core.Lifecycle
@using HackerOs.Simulation.Abstractions.Notifications
@using HackerOs.Simulation.Abstractions.Sessions
@using HackerOs.Simulation.Abstractions.Time
@using HackerOs.Simulation.Abstractions.Events
@using HackerOs.Simulation.Abstractions.Processes
@implements IDisposable
@inject WindowRuntime WindowRuntime
@inject WindowLaunchCoordinator LaunchCoordinator
@inject INotificationQueue NotificationQueue
@inject AppLifecycleOrchestrator Orchestrator
@inject IProcessManager ProcessManager
@inject WindowCloseCoordinator CloseCoordinator
@inject WindowCloseGuardRegistry CloseGuards
@inject ISessionService SessionService
@inject ISimulationClock SimulationClock
@inject IEventBus EventBus
@inject FileDialogWindowAdapter FileDialogAdapter
@inject TestDemoFixtureSeeder TestDemoSeeder

<div class="desktop-shell" @onkeydown="HandleShellKeyDown">
    <div class="desktop-workspace">
        <DesktopArea Windows="WindowRuntime.Windows"
                     OnFocus="HandleFocus"
                     OnMinimize="HandleMinimize"
                     OnToggleMaximize="HandleToggleMaximize"
                     OnClose="HandleClose"
                     OnGesture="HandleGesture">
            <WindowContent Context="window">
                @if (window.Content is not null)
                {
                    @window.Content
                }
                else if (Orchestrator.TryGetRunningInstance(AppInstanceId.FromGuid(window.OwnerInstanceId.Value), out AppDescriptor? descriptor, out IAppExecutionContext? context))
                {
                    <WindowAppRenderer Window="window"
                                       Descriptor="descriptor"
                                       AppContext="context"
                                       CloseGuards="CloseGuards" />
                }
                else
                {
                    <div class="window-content-placeholder">@window.Title</div>
                }
            </WindowContent>
        </DesktopArea>
    </div>

    @if (_isLauncherOpen)
    {
        <AppLauncher OnClose="CloseLauncher" OnAppSelected="HandleAppSelected" />
    }

    <NotificationCenter OnNotificationDismissed="StateHasChanged" />

    @if (!string.IsNullOrEmpty(_launchError))
    {
        <aside class="lazy-launch-error" role="alert">@_launchError</aside>
    }

    @if (_isLogoutOpen)
    {
        <LogoutDialog OnClose="CloseLogout" OnLoggedOut="HandleLoggedOutAsync" />
    }

    <Taskbar IsLauncherOpen="_isLauncherOpen"
             IsNotificationsOpen="_isNotificationsDrawerOpen"
             UnreadNotificationCount="UnreadNotificationCount"
             OnToggleLauncher="ToggleLauncher"
             OnToggleNotifications="ToggleNotifications"
             OnRequestLogout="OpenLogout" />

    @if (TestDemoEnabled)
    {
        <div class="e2e-test-demo-panel">
            <button type="button" id="btn-test-demo" @onclick="RunTestDemoAsync" disabled="@_testDemoRunning">
                @(_testDemoRunning ? "Seeding…" : "Test Demo")
            </button>
            @if (_testDemoStatus is not null)
            {
                <output id="test-demo-status" role="status">@_testDemoStatus</output>
            }
        </div>
    }
</div>

@code {
    private bool _isLauncherOpen;
    private bool _isNotificationsDrawerOpen;
    private bool _isLogoutOpen;
    private string? _launchError;

    [Parameter]
    public EventCallback OnLoggedOut { get; set; }

    /// <summary>
    /// Shows the E2E-only "Test Demo" fixture-seeding control. Must only ever be set
    /// true by a trusted, out-of-band signal from the test harness (see
    /// docs/e2e-test-demo-mode.md) — never reachable from a normal app launch.
    /// </summary>
    [Parameter]
    public bool TestDemoEnabled { get; set; }

    private bool _testDemoRunning;
    private string? _testDemoStatus;

    private int UnreadNotificationCount => NotificationQueue.GetActive(
        SessionService.CurrentPrincipal?.UserId ?? default,
        SimulationClock.UtcNow).Count;

    private void ToggleLauncher()
    {
        _isLauncherOpen = !_isLauncherOpen;
        _isNotificationsDrawerOpen = false;
    }

    private void CloseLauncher()
    {
        _isLauncherOpen = false;
    }

    private void ToggleNotifications()
    {
        _isNotificationsDrawerOpen = !_isNotificationsDrawerOpen;
        _isLauncherOpen = false;
    }

    private void OpenLogout()
    {
        _isLogoutOpen = true;
        _isLauncherOpen = false;
        _isNotificationsDrawerOpen = false;
    }

    private void CloseLogout()
    {
        _isLogoutOpen = false;
    }

    private async Task HandleLoggedOutAsync()
    {
        _isLogoutOpen = false;
        if (OnLoggedOut.HasDelegate)
        {
            await OnLoggedOut.InvokeAsync();
        }
    }

    private async Task HandleAppSelected(AppManifest manifest)
    {
        _isLauncherOpen = false;
        if (SessionService.CurrentPrincipal is not AuthenticatedPrincipal principal)
        {
            return;
        }

        AppLaunchResult result = await Orchestrator.LaunchAsync(
            new AppLaunchRequest(manifest.Id, principal, []));
        if (result.IsSuccess)
        {
            LaunchCoordinator.Present(manifest, result);
        }
        _launchError = result.IsSuccess
            ? null
            : result.ErrorMessage ?? result.ErrorCode ?? "The optional app could not be loaded.";
        StateHasChanged();
    }

    private void HandleFocus(WindowId id) => WindowRuntime.Apply(new FocusWindowCommand(id));
    private void HandleMinimize(WindowId id) => WindowRuntime.Apply(new MinimizeWindowCommand(id));
    private void HandleToggleMaximize(WindowId id)
    {
        WindowRuntimeState? window = WindowRuntime.Windows.FirstOrDefault(w => w.Id == id);
        if (window is not null)
        {
            if (window.VisualState == WindowVisualState.Maximized)
            {
                WindowRuntime.Apply(new RestoreWindowCommand(id));
            }
            else
            {
                WindowRuntime.Apply(new MaximizeWindowCommand(id));
            }
        }
    }

    private async Task HandleClose(WindowId id)
    {
        WindowRuntimeState? window = WindowRuntime.Windows.FirstOrDefault(w => w.Id == id);
        if (window?.OnRequestClose is { } onRequestClose)
        {
            await onRequestClose();
            StateHasChanged();
            return;
        }

        await CloseCoordinator.CloseAsync(
            id,
            cancellationToken => CloseGuards.ConfirmCloseAsync(id, cancellationToken));
        StateHasChanged();
    }
    private void HandleGesture(WindowCommand command) => WindowRuntime.Apply(command);

    private async Task RunTestDemoAsync()
    {
        if (!TestDemoEnabled || _testDemoRunning)
        {
            return;
        }

        if (SessionService.CurrentPrincipal is not AuthenticatedPrincipal principal)
        {
            _testDemoStatus = "Error: no signed-in user.";
            return;
        }

        _testDemoRunning = true;
        _testDemoStatus = null;
        StateHasChanged();
        try
        {
            string root = await TestDemoSeeder.SeedAsync(principal);
            _testDemoStatus = $"Seeded:{root}";
        }
        catch (Exception exception)
        {
            _testDemoStatus = $"Error:{exception.Message}";
        }
        finally
        {
            _testDemoRunning = false;
            StateHasChanged();
        }
    }

    private IDisposable? _processSubscription;

    protected override void OnInitialized()
    {
        WindowRuntime.StateChanged += OnWindowRuntimeStateChanged;
        FileDialogAdapter.Changed += OnWindowRuntimeStateChanged;
        _processSubscription = EventBus.Subscribe<ProcessStateChangedEvent>(OnProcessStateChanged);
    }

    private void OnWindowRuntimeStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnProcessStateChanged(ProcessStateChangedEvent e)
    {
        if (e.NewState is ProcessState.Stopped or ProcessState.Faulted)
        {
            if (TryGetInstanceId(e.Pid, out AppInstanceId instanceId))
            {
                WindowOwnerId ownerInstanceId = WindowOwnerId.FromGuid(instanceId.Value);
                WindowRuntimeState? matchingWindow = WindowRuntime.Windows.FirstOrDefault(w => w.OwnerInstanceId == ownerInstanceId);
                if (matchingWindow is not null)
                {
                    WindowRuntime.Apply(new ForceWindowCloseCommand(matchingWindow.Id));
                }
            }
        }
        else if (e.NewState == ProcessState.Running)
        {
            // A window-kind app can reach Running via any caller that goes through
            // AppLifecycleOrchestrator.LaunchAsync -- not just this shell's own app launcher
            // (e.g. another app opening a file through IAppIntentGateway.OpenFileAsync). The
            // orchestrator only owns process state, not window presentation, so this shell
            // presents any such process itself; Present() is a no-op if it was already
            // presented directly (e.g. by HandleAppSelected).
            if (Orchestrator.TryGetRunningInstance(e.Pid, out AppDescriptor? descriptor, out _)
                && descriptor.Manifest.Kind == AppKind.Window
                && ProcessManager.TryGetActive(e.Pid, out ProcessRecord process))
            {
                LaunchCoordinator.Present(descriptor.Manifest, process);
            }
        }

        InvokeAsync(StateHasChanged);
    }

    private bool TryGetInstanceId(ProcessId pid, out AppInstanceId instanceId)
    {
        if (ProcessManager.TryGetActive(pid, out ProcessRecord active))
        {
            instanceId = active.AppInstanceId;
            return true;
        }

        ProcessRecord? historical = ProcessManager.GetHistory().LastOrDefault(record => record.Pid == pid);
        if (historical is not null)
        {
            instanceId = historical.AppInstanceId;
            return true;
        }

        instanceId = default;
        return false;
    }

    private void HandleShellKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            if (_isLauncherOpen)
            {
                _isLauncherOpen = false;
            }
            else if (_isNotificationsDrawerOpen)
            {
                _isNotificationsDrawerOpen = false;
            }
        }
    }

    public void Dispose()
    {
        WindowRuntime.StateChanged -= OnWindowRuntimeStateChanged;
        FileDialogAdapter.Changed -= OnWindowRuntimeStateChanged;
        _processSubscription?.Dispose();
    }
}
