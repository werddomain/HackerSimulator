@using Microsoft.AspNetCore.Components.Web
@using HackerOs.AppSdk.Blazor

<div class="credential-prompt-dialog" role="dialog" aria-modal="true">
    <div class="credential-prompt-body">
        @if (!string.IsNullOrWhiteSpace(Presentation.Request.Description))
        {
            <p class="credential-prompt-description">@Presentation.Request.Description</p>
        }
        <label class="credential-prompt-field">
            <span>Administrator login</span>
            <input type="text"
                   class="dialog-input"
                   autocomplete="off"
                   @bind="_loginName"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
        </label>
        <label class="credential-prompt-field">
            <span>Password</span>
            <input type="password"
                   class="dialog-input"
                   @bind="_password"
                   @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
        </label>
        @if (_showError)
        {
            <p class="credential-prompt-error" role="alert">Login name and password are required.</p>
        }
    </div>
    <footer class="credential-prompt-actions">
        <button type="button" class="primary" @onclick="HandleSubmit">Authorize</button>
        <button type="button" @onclick="HandleCancel">Cancel</button>
    </footer>
</div>

@code {
    private string _loginName = string.Empty;
    private string _password = string.Empty;
    private bool _showError;

    [Parameter]
    [EditorRequired]
    public CredentialPromptPresentation Presentation { get; set; } = default!;

    [Parameter]
    [EditorRequired]
    public DialogCoordinator Coordinator { get; set; } = default!;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_loginName) || string.IsNullOrEmpty(_password))
        {
            _showError = true;
            return;
        }

        Coordinator.SelectCredentialPrompt(Presentation.Id, _loginName, _password);
    }

    private void HandleCancel() => Coordinator.Cancel(Presentation.Id);

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleSubmit();
        }
        else if (e.Key == "Escape")
        {
            HandleCancel();
        }
    }
}
