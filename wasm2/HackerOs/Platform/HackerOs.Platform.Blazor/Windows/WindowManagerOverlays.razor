@using HackerOs.Platform.Core.Shell
@using HackerOs.Windowing.Abstractions
@using HackerOs.Windowing.Core
@implements IAsyncDisposable

@* ADR 0095 §3: the window manager's keyboard surfaces — switcher, keyboard move/resize banner and
   window menu. Every decision lives in WindowKeyboardCommands; this component only draws its state
   and connects the browser's key events to it. *@

@if (Commands.Mode == WindowKeyboardMode.Switching)
{
    IReadOnlyList<WindowRuntimeState> windows = Commands.SwitcherWindows;
    WindowId? selection = Commands.SwitcherSelection;
    <div class="window-switcher-backdrop">
        <section class="window-switcher" role="listbox" aria-label="Switch windows" aria-activedescendant="@(selection is { } selected ? ItemId(selected) : null)">
            @foreach (WindowRuntimeState window in windows)
            {
                bool isSelected = window.Id == selection;
                <div id="@ItemId(window.Id)"
                     class="window-switcher-item @(isSelected ? "is-selected" : null) @(window.VisualState == WindowVisualState.Minimized ? "is-minimized" : null)"
                     role="option"
                     aria-selected="@(isSelected ? "true" : "false")"
                     data-window-switcher-item="@window.Id">
                    <span class="window-switcher-glyph" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(window.IconAssetPath))
                        {
                            <img src="@window.IconAssetPath" alt="" />
                        }
                        else
                        {
                            @Initial(window.Title)
                        }
                    </span>
                    <span class="window-switcher-title">@window.Title</span>
                </div>
            }
        </section>
    </div>
}

@if (Commands.ModeWindow is not null)
{
    <aside class="window-mode-banner" role="status" aria-live="polite" data-window-mode="@(Commands.Mode == WindowKeyboardMode.Moving ? "move" : "resize")">
        <strong>@(Commands.Mode == WindowKeyboardMode.Moving ? "Move window" : "Resize window")</strong>
        <span>Arrows: @(Commands.Mode == WindowKeyboardMode.Moving ? "move" : "resize") · Ctrl: 1 px · Enter: keep · Esc: cancel</span>
    </aside>
}

@if (Commands.Menu is { } menu)
{
    IReadOnlyList<WindowMenuItem> items = Commands.GetMenuItems(menu.WindowId);
    <div class="window-menu-scrim" @onpointerdown="CloseMenu"></div>
    <nav @ref="_menuElement"
         class="window-menu"
         role="menu"
         tabindex="-1"
         aria-label="Window menu"
         data-window-menu-for="@menu.WindowId"
         @onkeydown="HandleMenuKeyDownAsync"
         @onkeydown:preventDefault="true"
         @onkeydown:stopPropagation="true">
        @for (int index = 0; index < items.Count; index++)
        {
            WindowMenuItem item = items[index];
            int itemIndex = index;
            <button type="button"
                    class="window-menu-item @(itemIndex == _menuIndex ? "is-highlighted" : null)"
                    role="menuitem"
                    tabindex="-1"
                    disabled="@(!item.IsEnabled)"
                    aria-disabled="@(item.IsEnabled ? "false" : "true")"
                    data-window-action="@WindowKeyBindingsSettingsDocuments.KeyOf(item.Action)"
                    @onpointerenter="() => _menuIndex = itemIndex"
                    @onclick="() => RunMenuItemAsync(item)">
                <span class="window-menu-label">@item.Label</span>
                @if (item.Shortcut is { } shortcut)
                {
                    <kbd class="window-menu-shortcut">@shortcut</kbd>
                }
            </button>
        }
    </nav>
}
