@namespace HackerOs.Platform.Blazor.Windows
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<main @ref="_desktopElement" class="desktop-area" aria-label="Desktop workspace">
    <div class="desktop-grid" aria-hidden="true"></div>
    <section class="window-layer" aria-label="Open windows">
        @foreach (WindowRuntimeState window in Windows)
        {
            <WindowHost @key="window.Id"
                        Window="window"
                        IsInteractionBlocked="@IsBlocked(window.Id)"
                        OnFocus="OnFocus"
                        OnMinimize="OnMinimize"
                        OnToggleMaximize="OnToggleMaximize"
                        OnClose="OnClose"
                        OnGesture="OnGesture">
                @if (WindowContent is not null)
                {
                    @WindowContent(window)
                }
            </WindowHost>
        }
    </section>
</main>

@code {
    private ElementReference _desktopElement;
    private IJSObjectReference? _module;
    private DotNetObjectReference<DesktopArea>? _dotNetHelper;

    /// <summary>Gets or sets stable window snapshots ordered back-to-front.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<WindowRuntimeState> Windows { get; set; } = [];

    /// <summary>Gets or sets content rendered for each window snapshot.</summary>
    [Parameter]
    public RenderFragment<WindowRuntimeState>? WindowContent { get; set; }

    /// <summary>Gets or sets the focus request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnFocus { get; set; }

    /// <summary>Gets or sets the minimize request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnMinimize { get; set; }

    /// <summary>Gets or sets the maximize/restore request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnToggleMaximize { get; set; }

    /// <summary>Gets or sets the close request callback.</summary>
    [Parameter]
    public EventCallback<WindowId> OnClose { get; set; }

    /// <summary>Gets or sets the pointer gesture command callback.</summary>
    [Parameter]
    public EventCallback<WindowCommand> OnGesture { get; set; }

    /// <summary>Callback invoked by JS ResizeObserver when the desktop container bounds change.</summary>
    [JSInvokable]
    public async Task OnDesktopResized(double width, double height)
    {
        if (OnGesture.HasDelegate)
        {
            await OnGesture.InvokeAsync(new ChangeViewportCommand(new WindowBounds(0, 0, width, height)));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./_content/HackerOs.Platform.Blazor/Windows/DesktopArea.razor.js");
                await _module.InvokeVoidAsync("observeDesktopSize", _desktopElement, _dotNetHelper);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[DesktopArea] Failed to initialize resize observer: {ex.Message}");
            }
        }
    }

    private bool IsBlocked(WindowId id) => Windows.Any(window =>
        window.Modality == WindowModality.OwnerModal
        && window.OwnerId == id
        && window.VisualState != WindowVisualState.Minimized);

    public async ValueTask DisposeAsync()
    {
        _dotNetHelper?.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }
    }
}
