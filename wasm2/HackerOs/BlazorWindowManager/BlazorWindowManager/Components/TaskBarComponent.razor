@using BlazorWindowManager.Services
@using BlazorWindowManager.Models
@implements IDisposable


<div class="taskbar">
    <div class="taskbar-left">
        @LeftContent
    </div>
    
    <div class="taskbar-center">
        <div class="window-buttons">
            @foreach (var groupKey in _groupOrder)
            {
                var group = _groupedWindows[groupKey];
                var representative = GetRepresentativeWindow(group);

                <div class="window-button @GetWindowButtonClass(group)"
                     @onclick="(e) => OnWindowButtonClick(e, groupKey)"
                     @oncontextmenu="(e) => OnWindowButtonRightClick(e, representative)"
                     @oncontextmenu:preventDefault="true"
                     title="@representative.Title">
                    
                    <div class="window-button-icon">
                        @if (representative.Icon != null)
                        {
                            @representative.Icon
                        }
                        else
                        {
                            <div class="default-window-icon">📄</div>
                        }
                    </div>
                    
                    <div class="window-button-text">
                        @GetDisplayTitle(representative.Title)
                    </div>
                    
                    @if (group.Count > 1)
                    {
                        <div class="window-group-indicator">
                            @group.Count
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    
    <div class="taskbar-right">
        @RightContent
        <div class="system-tray">
            <div class="clock">
                @DateTime.Now.ToString("HH:mm")
            </div>
        </div>
    </div>
</div>

@if (_showContextMenu)
{
    <div class="context-menu" style="left: @(_contextMenuX)px; top: @(_contextMenuY)px" @onclick:stopPropagation="true">
        <div class="context-menu-item" @onclick="() => PerformWindowAction(_contextMenuWindow, WindowAction.Restore)">
            <span class="context-menu-icon">🔄</span> Restore
        </div>
        <div class="context-menu-item" @onclick="() => PerformWindowAction(_contextMenuWindow, WindowAction.Minimize)">
            <span class="context-menu-icon">➖</span> Minimize
        </div>
        <div class="context-menu-item" @onclick="() => PerformWindowAction(_contextMenuWindow, WindowAction.Maximize)">
            <span class="context-menu-icon">⬜</span> Maximize
        </div>
        <div class="context-menu-separator"></div>
        <div class="context-menu-item" @onclick="() => PerformWindowAction(_contextMenuWindow, WindowAction.Close)">
            <span class="context-menu-icon">❌</span> Close
        </div>
    </div>
    
    <div class="context-menu-overlay" @onclick="CloseContextMenu"></div>
}

@if (_showGroupPopup && _groupPopupKey != null && _groupedWindows.TryGetValue(_groupPopupKey, out var popupGroup))
{
    <div class="group-popup" style="left: @(_groupPopupX)px; top: @(_groupPopupY)px" @onclick:stopPropagation="true">
        @foreach (var window in popupGroup)
        {
            <div class="group-popup-item @(WindowManager.GetActiveWindow()?.Id == window.Id ? "active" : "")"
                 @onclick="() => OnGroupPopupItemClick(window)">
                <div class="group-popup-icon">
                    @if (window.Icon != null)
                    {
                        @window.Icon
                    }
                    else
                    {
                        <div class="default-window-icon">📄</div>
                    }
                </div>
                <div class="group-popup-text">@GetDisplayTitle(window.Title)</div>
                @if (window.State == WindowState.Minimized)
                {
                    <span class="group-popup-state">minimized</span>
                }
            </div>
        }
    </div>

    <div class="context-menu-overlay" @onclick="CloseGroupPopup"></div>
}
