<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Deliberately only the three exported windowing/taskbar packages. No
      HackerOs.Ecosystem, no HackerOs.Platform.*, no HackerOs.Apps.*, no
      HackerOs.Simulation.Abstractions: this project is EXT-WIN-011's proof
      that the extracted window engine, chrome, and taskbar are consumable
      by a host with no knowledge of HackerOS's process/app model.
    -->
    <ProjectReference Include="..\..\Platform\HackerOs.Windowing.Core\HackerOs.Windowing.Core.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Windowing.Blazor\HackerOs.Windowing.Blazor.csproj" />
    <ProjectReference Include="..\..\Platform\HackerOs.Taskbar.Blazor\HackerOs.Taskbar.Blazor.csproj" />
  </ItemGroup>

</Project>
