<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    EXT-WIN-013 verification only: proves the three exported packages work when consumed
    as real .nupkg files instead of ProjectReference, catching anything (static assets,
    transitive dependencies) that only worked by project-reference coincidence. Not meant
    to be the project's permanent state; see window-taskbar-export-plan.md section 6.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-windowing-packages" value="..\..\artifacts\local-nupkg" />
  </packageSources>
</configuration>
