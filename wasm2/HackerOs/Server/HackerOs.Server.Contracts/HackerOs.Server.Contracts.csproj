<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Shared contracts used by both server and browser client; no Blazor/UI dependency. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <RootNamespace>HackerOs.Server.Contracts</RootNamespace>
    <AssemblyName>HackerOs.Server.Contracts</AssemblyName>
    <Description>Shared API versioning, sync record envelope, and proxy request/response contracts for the optional HackerOs server. Referenced by both the ASP.NET Core server and the browser client adapter.</Description>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source-generated JSON serialization for contracts; no reflection at runtime. -->
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

  <!-- No reference to HackerOs.App.Abstractions or platform projects intentionally:
       this library must remain independently deployable on the server host. -->

</Project>
