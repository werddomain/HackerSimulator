<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Optional ASP.NET Core server. Clients continue to work when this process is absent. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <RootNamespace>HackerOs.Server</RootNamespace>
    <AssemblyName>HackerOs.Server</AssemblyName>
    <Description>Optional ASP.NET Core server providing sync, identity, and network proxy services for HackerOs. The browser PWA operates fully offline when this server is absent.</Description>
    <!-- Publish as a self-contained single-file for easy operator deployment. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Inline the server ADR decision: D-017, D-018 implemented here. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Server\HackerOs.Server.Contracts\HackerOs.Server.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite for portable single-file server deployment; can be swapped for PostgreSQL. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Scalar for OpenAPI documentation UI. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.5.10" />
    <!-- OpenAPI document generation (required for AddOpenApi/MapOpenApi). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
  </ItemGroup>

</Project>
