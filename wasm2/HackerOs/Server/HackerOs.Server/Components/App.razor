@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />

    <!-- MudBlazor Styles -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- HackerOS Global CSS Design System & Scoped CSS Bundles -->
    <link rel="stylesheet" href="_content/HackerOs.Platform.Blazor/HackerOs.Platform.Blazor.bundle.scp.css" />
    <!--
      HackerOs.Ecosystem owns the actual design-system tokens (--hos-*) at wwwroot/css/app.css.
      Its static web assets compose directly at this host's root (Microsoft.NET.Sdk.BlazorWebAssembly
      project references aren't prefixed with the usual RCL "_content/{Project}/" path) — confirmed
      via its own HackerOs.Ecosystem.staticwebassets.endpoints.json, whose "css/app.css" route serves
      unprefixed here. @Assets["app.css"] resolves to THIS project's own wwwroot/app.css instead,
      which is just the unmodified `dotnet new blazor` scaffold stub (a 3-rule html/body reset) and
      left every HackerOS surface completely unstyled.
    -->
    <link rel="stylesheet" href="css/app.css" />

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <HackerOs.Ecosystem.App @rendermode="new InteractiveServerRenderMode(prerender: false)" TestDemoEnabled="false" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <!-- MudBlazor Script -->
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
