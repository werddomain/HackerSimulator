@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HackerOS</title>
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />

    <!-- MudBlazor Styles -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- HackerOS Global CSS Design System & Scoped CSS Bundles -->
    <link rel="stylesheet" href="_content/HackerOs.Platform.Blazor/HackerOs.Platform.Blazor.bundle.scp.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <HackerOs.Ecosystem.App @rendermode="new InteractiveServerRenderMode(prerender: false)" TestDemoEnabled="false" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <!-- MudBlazor Script -->
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
