@using Microsoft.AspNetCore.Components.Web

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <ImportMap />

    <!-- MudBlazor Styles -->
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- HackerOS Global CSS Design System & Scoped CSS Bundles -->
    <link rel="stylesheet" href="_content/HackerOs.Platform.Blazor/HackerOs.Platform.Blazor.bundle.scp.css" />
    <!-- Single source of truth for --hos-* design tokens: HackerOs.Ecosystem/wwwroot/css/app.css, exposed by
         the ProjectReference to HackerOs.Ecosystem.csproj as static web asset route "css/app.css" (NOT
         "_content/HackerOs.Ecosystem/css/app.css" — Ecosystem is the referenced app's own wwwroot root here,
         not a Razor Class Library, so its assets keep unprefixed routes). Do NOT give this host its own
         wwwroot/app.css copy — see docs/webassembly-debugging.md. -->
    <link rel="stylesheet" href="@Assets["css/app.css"]" />

    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <HackerOs.Ecosystem.App @rendermode="new InteractiveServerRenderMode(prerender: false)" TestDemoEnabled="false" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <!-- MudBlazor Script -->
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
