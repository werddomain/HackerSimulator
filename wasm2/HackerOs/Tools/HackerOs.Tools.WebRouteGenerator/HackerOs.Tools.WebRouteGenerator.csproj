<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASP.Hack route generator (ADR 0082): a Roslyn incremental source generator that writes, at build
    time, the controller route table of a web app (HackWebGeneratedRoutes) and the entry point of each
    partial WebAppDefinition. No reflection at run time: trimming-safe, and route conflicts are build
    errors (HOSWEBnnnn). Apps get it as an analyzer through build/HackerOs.Apps.targets. The route
    template parser is the runtime's own file, linked from HackerOs.AppSdk.Web.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\HackerOs.AppSdk.Web\Routing\HackRouteTemplate.cs" Link="Shared\HackRouteTemplate.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Release tracking of the HOSWEB rules (RS2008). -->
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HackerOs.AppSdk.Web.Tests" />
  </ItemGroup>

</Project>
